    "In Installed, right-click a wallpaper and choose Add to Playlist." : {
      "comment" : "Empty playlist: how to add wallpapers; Installed is a tab, Add to Playlist a menu item",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المثبتة، انقر على خلفية بزر الماوس الأيمن واختر «إضافة إلى قائمة تشغيل»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie in „Installiert“ mit der rechten Maustaste auf ein Hintergrundbild und wählen Sie „Zur Playlist hinzufügen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Instalados, haz clic derecho en un fondo de pantalla y elige «Añadir a playlist»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Installés, cliquez avec le bouton droit sur un fond d’écran et choisissez « Ajouter à la playlist »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टॉल किए गए में, किसी वॉलपेपर पर राइट-क्लिक करें और “प्लेलिस्ट में जोड़ें” चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Installati, fai clic destro su uno sfondo e scegli “Aggiungi alla playlist”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「インストール済み」で壁紙を右クリックし、「プレイリストに追加」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치됨에서 배경화면을 오른쪽 클릭하고 ‘플레이리스트에 추가’를 선택합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Zainstalowanych kliknij tapetę prawym przyciskiem i wybierz „Dodaj do playlisty”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Instaladas, clique com o botão direito em uma imagem de fundo e escolha “Adicionar à Playlist”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «Установленных» нажмите правой кнопкой на обои и выберите «Добавить в плейлист»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü’de bir duvar kâğıdını sağ tıklayıp Çalma Listesine Ekle’yi seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
