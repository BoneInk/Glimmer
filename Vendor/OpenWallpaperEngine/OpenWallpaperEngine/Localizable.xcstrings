    "The preview and the Live Photo show the parallax as if the pointer rested here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض المعاينة وLive Photo اختلاف المنظر كما لو كان المؤشر مستقرًا هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorschau und das Live Photo zeigen die Parallaxe so, als ruhte der Zeiger hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La previsualización y la Live Photo muestran el paralaje como si el puntero estuviera aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu et la Live Photo montrent la parallaxe comme si le pointeur reposait ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रीव्यू और Live Photo पैरालैक्स को ऐसे दिखाते हैं मानो पॉइंटर यहीं रुका हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’anteprima e la Live Photo mostrano la parallasse come se il puntatore fosse fermo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューとLive Photoには、ポインタがここにあるものとして視差が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기와 Live Photo에는 포인터가 여기에 있는 것처럼 시차가 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd i Live Photo pokazują paralaksę tak, jakby wskaźnik spoczywał tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pré-visualização e a Live Photo mostram a paralaxe como se o ponteiro estivesse aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительный просмотр и Live Photo показывают параллакс так, будто указатель находится здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizleme ve Live Photo, paralaksı imleç burada duruyormuş gibi gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередній перегляд і Live Photo показують паралакс так, ніби вказівник лежить тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览和实况照片会按指针停在此处来显示视差。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預覽和原況照片會按指標停在此處來顯示視差。"
          }
        }
      }
    },
    "The preview and the video show the parallax as if the pointer rested here." : {
