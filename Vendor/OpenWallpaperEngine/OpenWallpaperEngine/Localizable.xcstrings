    "Wallpapers larger than 4GB can currently not be transferred to mobile devices." : {
      "comment" : "Android export: Wallpaper Engine's own wording (ui_browse_mobile_upload_size_warning_message)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حاليًا نقل الخلفيات التي يزيد حجمها عن 4 جيجابايت إلى الأجهزة المحمولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergründe größer als 4 GB können derzeit nicht an mobile Geräte gesendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fondos de más de 4GB no se pueden transferir a los dispositivos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonds d'écran de plus de 4 Go ne peuvent actuellement pas être transférés sur des appareils mobiles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4GB से बड़े वॉलपेपर अभी मोबाइल डिवाइस पर नहीं भेजे जा सकते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli sfondi più pesanti di 4 GB non possono attualmente essere trasferiti ai dispositivi mobili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4GBを超えるサイズの壁紙はモバイルデバイスに転送できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 4GB보다 큰 배경화면은 모바일 기기로 전송할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapet większych niż 4 GB nie da się obecnie przenosić na urządzenia mobilne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível transferir papéis de parede acima de 4GB para dispositivos móveis no momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обои размером больше 4 ГБ нельзя перенести на мобильные устройства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 GB'tan büyük duvar kağıtları, şu anda mobil cihazlara aktarılamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шпалери розміром більше 4 Гб неможливо наразі передати на мобільний пристрій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法将大于 4GB 的壁纸传输到移动设备。"
