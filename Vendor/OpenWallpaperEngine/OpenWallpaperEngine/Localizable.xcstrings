    "Loudness of the wallpaper's own soundtrack. Set it to 0 to keep the wallpaper silent." : {
      "comment" : "Details panel tooltip",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتفاع صوت الموسيقى التصويرية الخاصة بالخلفية. اضبطه على 0 لإبقاء الخلفية صامتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke des eigenen Soundtracks des Hintergrundbilds. Setzen Sie sie auf 0, damit das Hintergrundbild stumm bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumen de la banda sonora del propio fondo de pantalla. Ponlo a 0 para que el fondo de pantalla no tenga sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume de la bande-son propre au fond d’écran. Réglez-le sur 0 pour rendre le fond d’écran silencieux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर के अपने साउंडट्रैक का वॉल्यूम. वॉलपेपर को शांत रखने के लिए इसे 0 पर सेट करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume della colonna sonora dello sfondo. Impostalo su 0 per renderlo silenzioso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙自体のサウンドトラックの音量です。0に設定すると壁紙は無音になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 자체 사운드트랙의 음량입니다. 배경화면을 무음으로 유지하려면 0으로 설정하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośność ścieżki dźwiękowej tapety. Ustaw 0, aby tapeta była wyciszona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume da trilha sonora da própria imagem de fundo. Defina como 0 para deixá-la em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Громкость собственного саундтрека обоев. Установите 0, чтобы отключить звук обоев."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kâğıdının kendi müziğinin ses yüksekliği. Duvar kâğıdını sessiz tutmak için 0’a ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гучність власного саундтреку шпалери. Установіть 0, щоб шпалера була беззвучною."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墙纸自带配乐的音量。设为 0 可让墙纸保持静音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景圖片自帶音軌的音量。設為 0 可讓背景圖片保持靜音。"
          }
        }
      }
    },
