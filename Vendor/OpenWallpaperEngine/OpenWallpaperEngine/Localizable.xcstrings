    "Sorted ascending. Click to sort descending." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفروز تصاعديًا. انقر للفرز تنازليًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufsteigend sortiert. Klicken Sie, um absteigend zu sortieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden ascendente. Haz clic para ordenar de forma descendente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri croissant. Cliquez pour trier par ordre décroissant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आरोही क्रम में सॉर्ट किया गया. अवरोही क्रम में सॉर्ट करने के लिए क्लिक करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordine crescente. Fai clic per l’ordine decrescente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昇順で並べ替えています。クリックすると降順で並べ替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오름차순으로 정렬됨. 내림차순으로 정렬하려면 클릭하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortowanie rosnące. Kliknij, aby sortować malejąco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem crescente. Clique para ordenar de forma decrescente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортировка по возрастанию. Нажмите, чтобы сортировать по убыванию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artan sırada. Azalan sıralamak için tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортування за зростанням. Клацніть, щоб сортувати за спаданням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
