          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej konfigurację do ustawień klienta MCP lub dodaj serwer w Terminalu:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
