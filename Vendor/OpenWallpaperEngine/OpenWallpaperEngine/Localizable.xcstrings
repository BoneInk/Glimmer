          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тижневий список відтворення не підтримує більш ніж 7 шпалер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星期播放列表不支持超过 7 张墙纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星期幾播放列表最多只能支援 7 張背景圖片。"
          }
        }
      }
    },
    "The Day of Week playlist does not support more than 7 wallpapers. Remove excess wallpapers now?" : {
      "comment" : "Asks before removing a day-of-week playlist's wallpapers after the seventh",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة تشغيل أيام الأسبوع لا تحتمل أكثر من 7 خلفيات. هل تريد حذف الخلفيات الزائدة الآن؟"
