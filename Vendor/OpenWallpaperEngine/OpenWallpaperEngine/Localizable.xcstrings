    "The Chromium download doesn't match the version this app expects, so it wasn't installed. Try again later." : {
      "comment" : "Chromium engine install error: the downloaded file's checksum is wrong",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يطابق تنزيل Chromium الإصدار الذي يتوقعه هذا التطبيق، لذا لم يُثبَّت. حاول مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Chromium-Download entspricht nicht der Version, die diese App erwartet, und wurde daher nicht installiert. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga de Chromium no coincide con la versión que espera esta app, así que no se instaló. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement de Chromium ne correspond pas à la version attendue par cette app ; il n’a donc pas été installé. Réessayez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium डाउनलोड इस ऐप द्वारा अपेक्षित संस्करण से मेल नहीं खाता, इसलिए इसे इंस्टॉल नहीं किया गया। बाद में फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download di Chromium non corrisponde alla versione prevista da questa app, quindi non è stato installato. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium のダウンロードがこのアプリの想定するバージョンと一致しないため、インストールしませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 Chromium이 이 앱이 요구하는 버전과 일치하지 않아 설치하지 않았습니다. 나중에 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrany Chromium nie zgadza się z wersją oczekiwaną przez tę aplikację, więc nie został zainstalowany. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
