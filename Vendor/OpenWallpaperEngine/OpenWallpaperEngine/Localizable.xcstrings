    "Steam Web API key required.\nGet a free key at steamcommunity.com/dev/apikey\nthen enter it below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح Steam Web API مطلوب.\nاحصل على مفتاح مجاني من steamcommunity.com/dev/apikey\nثم أدخله أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam-Web-API-Schlüssel erforderlich.\nFordern Sie einen kostenlosen Schlüssel unter steamcommunity.com/dev/apikey an\nund geben Sie ihn unten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita una clave de la API web de Steam.\nConsigue una clave gratuita en steamcommunity.com/dev/apikey\ny después introdúcela abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé d’API Web Steam requise.\nObtenez une clé gratuite sur steamcommunity.com/dev/apikey\npuis saisissez-la ci-dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Web API कुंजी आवश्यक है.\nsteamcommunity.com/dev/apikey पर मुफ़्त कुंजी पाएँ\nफिर उसे नीचे डालें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiave Steam Web API richiesta.\nOttieni una chiave gratuita su steamcommunity.com/dev/apikey\ne inseriscila qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Web APIキーが必要です。\nsteamcommunity.com/dev/apikeyで無料のキーを取得し、\n以下に入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Web API 키가 필요합니다.\nsteamcommunity.com/dev/apikey에서 무료 키를 받은 후\n아래에 입력하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagany klucz Steam Web API.\nUzyskaj bezpłatny klucz na stronie steamcommunity.com/dev/apikey,\na następnie wprowadź go poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária uma chave de API Web do Steam.\nObtenha uma chave gratuita em steamcommunity.com/dev/apikey\ne digite-a abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется ключ Steam Web API.\nПолучите бесплатный ключ на steamcommunity.com/dev/apikey\nи введите его ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Web API anahtarı gerekiyor.\nsteamcommunity.com/dev/apikey adresinden ücretsiz bir anahtar edinin,\nardından aşağıya girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібен ключ Steam Web API.\nОтримайте безкоштовний ключ на steamcommunity.com/dev/apikey\nі введіть його нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 Steam Web API 密钥。\n请在 steamcommunity.com/dev/apikey 免费获取密钥，\n然后在下方输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 Steam Web API 密鑰。\n請至 steamcommunity.com/dev/apikey 免費取得\n然後在下方輸入。"
          }
        }
      }
    },
