          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O comando de menu “%@” usa este atalho. Usar Mesmo Assim o atribui a esta playlist, e o comando de menu deixa de responder a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда меню «%@» использует это сочетание клавиш. «Всё равно использовать» отдаёт его этому плейлисту, и команда меню перестаёт на него реагировать."
          }
        },
        "tr" : {
          "stringUnit" : {
