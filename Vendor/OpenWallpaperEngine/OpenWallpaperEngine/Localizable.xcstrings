    "Use Anyway moves it to this hotkey." : {
      "comment" : "Hotkey conflict, second sentence, after one naming what has the shortcut",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي «الاستخدام على أي حال» إلى نقله إلى هذا الاختصار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Trotzdem verwenden“ überträgt ihn auf diese Tastenkombination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Usar de todos modos» la pasa a esta tecla de acceso rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Utiliser quand même » le déplace vers ce raccourci."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“फिर भी इस्तेमाल करें” इसे इस हॉटकी पर ले आता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Usa comunque” la sposta su questo tasto di scelta rapida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このまま使用」を選ぶと、このホットキーに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘그래도 사용’을 선택하면 이 단축키로 옮겨집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Użyj mimo to” przenosi go do tego klawisza dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
