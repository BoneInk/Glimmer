          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्टॉर्शन कितने धीरे-धीरे शुरू और खत्म होता है. कम मान झटके से बदलते हैं, ज़्यादा मान सहजता से."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto gradualmente la distorsione entra ed esce. Valori bassi scattano, valori alti scivolano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆがみが強まったり弱まったりする滑らかさです。低い値では急に、高い値では滑らかに変化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왜곡이 서서히 나타나고 사라지는 정도입니다. 값이 낮으면 급격하게, 값이 높으면 부드럽게 변합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak płynnie narasta i zanika zniekształcenie. Niskie wartości dają skok, wysokie — płynne przejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quão gradualmente a distorção entra e sai. Valores baixos são bruscos; valores altos são suaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавность нарастания и спада искажения. Малые значения — резко, большие — плавно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bozulmanın ne kadar kademeli olarak başlayıp bittiği. Düşük değerler ani, yüksek değerler yumuşak geçiş sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки поступово спотворення наростає й спадає. Малі значення — різко, великі — плавно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扭曲渐入渐出的平缓程度。数值低时突变，数值高时平滑过渡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扭曲漸入和漸出的平緩程度。數值低時切換俐落，數值高時過渡平滑。"
          }
        }
      }
    },
    "How gradually the effect blends at its boundary." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like smoothness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
