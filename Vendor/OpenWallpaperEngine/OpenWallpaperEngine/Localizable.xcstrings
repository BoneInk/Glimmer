            "state" : "translated",
            "value" : "इमेज के पिक्सेल पढ़े नहीं जा सकते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere i pixel dell’immagine."
          }
        },
        "ja" : {
