          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A playlist “%@” usa este atalho. Usar Mesmo Assim o move para esta playlist."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плейлист «%@» использует это сочетание клавиш. «Всё равно использовать» переносит его на этот плейлист."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” çalma listesi bu kısayolu kullanıyor. “Yine de Kullan” onu bu çalma listesine taşır."
