          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单命令“%@”使用了此快捷键。“仍然使用”会将它分配给此播放列表，菜单命令将不再响应它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
