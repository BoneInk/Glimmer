    "Log in on the Workshop tab to download these." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول في علامة تبويب الورشة لتنزيل هذه العناصر."
          }
        },
        "de" : {
          "stringUnit" : {
