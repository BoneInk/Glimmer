    "×8 MSAA is only recommended for powerful high-end desktop graphics cards." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُنصح بـ MSAA ×8 إلا مع بطاقات الرسومات المكتبية القوية المتطورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "×8 MSAA wird nur für leistungsstarke High-End-Desktop-Grafikkarten empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El MSAA ×8 solo se recomienda para tarjetas gráficas de sobremesa potentes y de gama alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le MSAA ×8 n’est recommandé que pour les cartes graphiques de bureau haut de gamme et puissantes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "×8 MSAA की सलाह केवल शक्तिशाली हाई-एंड डेस्कटॉप ग्राफ़िक्स कार्ड के लिए दी जाती है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MSAA ×8 è consigliato solo per schede grafiche desktop potenti e di fascia alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "×8 MSAAは、高性能なハイエンドのデスクトップ用グラフィックカードでのみ推奨されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "×8 MSAA는 고성능 하이엔드 데스크탑 그래픽 카드에서만 권장됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "×8 MSAA jest zalecane tylko dla wydajnych, najwyższej klasy kart graficznych do komputerów stacjonarnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MSAA ×8 só é recomendado para placas de vídeo de desktop potentes e de alto desempenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MSAA ×8 рекомендуется только для мощных видеокарт высокого класса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "×8 MSAA yalnızca güçlü, üst düzey masaüstü ekran kartları için önerilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MSAA ×8 рекомендується лише для потужних настільних відеокарт високого класу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议仅在性能强大的高端台式机显卡上使用 ×8 MSAA。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
