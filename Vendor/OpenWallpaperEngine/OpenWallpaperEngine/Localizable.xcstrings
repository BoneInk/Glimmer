          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Open Wallpaper Engine não é afiliado ao Wallpaper Engine, à Valve nem à Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine не связан с Wallpaper Engine, Valve или Steam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine’in Wallpaper Engine, Valve veya Steam ile bir bağlantısı yoktur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine не пов’язаний із Wallpaper Engine, Valve чи Steam."
          }
        },
        "zh-Hans" : {
