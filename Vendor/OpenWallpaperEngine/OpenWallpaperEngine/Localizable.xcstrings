    "Sways the layer as if leaves were moving in wind." : {
      "comment" : "Scene Edit / Export tooltip for the foliagesway effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجعل الطبقة تتمايل كأنها أوراق تتحرك في الريح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiegt die Ebene, als würden sich Blätter im Wind bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balancea la capa como si fueran hojas movidas por el viento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance le calque comme des feuilles agitées par le vent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर को ऐसे लहराता है मानो पत्तियाँ हवा में हिल रही हों."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa ondeggiare il livello come foglie mosse dal vento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "風に揺れる葉のようにレイヤーを揺らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바람에 나뭇잎이 움직이는 것처럼 레이어를 흔듭니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kołysze warstwą, jakby liście poruszały się na wietrze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balança a camada como se fossem folhas movidas pelo vento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раскачивает слой, как листья на ветру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katmanı rüzgârda hareket eden yapraklar gibi sallar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гойдає шар, ніби листя колишеться на вітрі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使图层摇摆，就像树叶在风中摆动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓圖層搖曳，彷彿樹葉在風中擺動。"
          }
        }
      }
    },
    "Sweeps a bright band across the layer. The mask controls which parts can catch the light." : {
      "comment" : "Scene Edit / Export tooltip for the shine effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمرّر شريطًا ساطعًا عبر الطبقة. يتحكم القناع في الأجزاء التي يمكن أن يسقط عليها الضوء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt einen hellen Streifen über die Ebene. Die Maske bestimmt, welche Teile das Licht einfangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa una franja brillante por la capa. La máscara controla qué partes pueden recibir la luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait passer une bande lumineuse sur le calque. Le masque détermine les parties qui peuvent capter la lumière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर पर एक चमकीली पट्टी घुमाता है. मास्क तय करता है कि कौन-से हिस्से रोशनी पकड़ सकते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa scorrere una banda luminosa sul livello. La maschera stabilisce quali parti possono catturare la luce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい帯をレイヤー全体に走らせます。マスクで光が当たる部分を制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어를 가로질러 밝은 띠를 쓸고 지나갑니다. 마스크로 빛을 받을 부분을 제어합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa jasny pas po warstwie. Maska określa, które części mogą złapać światło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa uma faixa brilhante pela camada. A máscara controla quais partes podem receber a luz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводит яркую полосу по слою. Маска определяет, какие части могут бликовать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katman boyunca parlak bir şerit gezdirir. Maske, hangi bölümlerin ışığı yakalayabileceğini belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводить яскраву смугу по шару. Маска визначає, які частини можуть відбивати світло."
