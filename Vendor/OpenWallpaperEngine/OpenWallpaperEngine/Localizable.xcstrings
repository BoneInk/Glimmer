    "Ultra mode adds HDR bloom to supported wallpapers and is only recommended for powerful high-end desktop graphics cards." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف الوضع الفائق توهج HDR إلى الخلفيات المدعومة، ولا يُنصح به إلا مع بطاقات الرسومات المكتبية القوية المتطورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ultra-Modus fügt unterstützten Hintergrundbildern HDR-Bloom hinzu und wird nur für leistungsstarke High-End-Desktop-Grafikkarten empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Ultra añade resplandor HDR a los fondos de pantalla compatibles y solo se recomienda para tarjetas gráficas de sobremesa potentes y de gama alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Ultra ajoute un flou lumineux HDR aux fonds d’écran compatibles et n’est recommandé que pour les cartes graphiques de bureau haut de gamme et puissantes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अल्ट्रा मोड सपोर्ट करने वाले वॉलपेपर में HDR ब्लूम जोड़ता है और इसकी सलाह केवल शक्तिशाली हाई-एंड डेस्कटॉप ग्राफ़िक्स कार्ड के लिए दी जाती है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Ultra aggiunge il bloom HDR agli sfondi supportati ed è consigliata solo per schede grafiche desktop potenti e di fascia alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウルトラモードは、対応する壁紙にHDRブルームを追加します。高性能なハイエンドのデスクトップ用グラフィックカードでのみ推奨されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "울트라 모드는 지원되는 배경화면에 HDR 블룸을 추가하며, 고성능 하이엔드 데스크탑 그래픽 카드에서만 권장됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb Ultra dodaje bloom HDR do obsługiwanych tapet i jest zalecany tylko dla wydajnych, najwyższej klasy kart graficznych do komputerów stacjonarnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Ultra adiciona bloom HDR às imagens de fundo compatíveis e só é recomendado para placas de vídeo de desktop potentes e de alto desempenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим «Ультра» добавляет HDR Bloom в поддерживаемые обои и рекомендуется только для мощных видеокарт высокого класса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultra modu, desteklenen duvar kâğıtlarına HDR bloom ekler ve yalnızca güçlü, üst düzey masaüstü ekran kartları için önerilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим «Ультра» додає HDR Bloom-ефект до підтримуваних шпалер і рекомендується лише для потужних настільних відеокарт високого класу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超高模式会为支持的墙纸添加 HDR 泛光，建议仅用于性能强大的高端台式机显卡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「超高」模式會為支援的背景圖片加入 HDR 光暈，僅建議用於效能強大的高階桌上型顯示卡。"
          }
        }
      }
    },
