    "How far the image shifts horizontally with the pointer. Needs a depth map; without one nothing moves." : {
      "comment" : "Scene Edit / Export tooltip for the depthparallax effect's depthx parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدى إزاحة الصورة أفقيًا مع المؤشر. يتطلب خريطة عمق؛ ومن دونها لا يتحرك شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
