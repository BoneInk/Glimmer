          }
        }
      }
    },
    "Adds the folders you made in Wallpaper Engine's Installed tab to the Installed tab here. Nothing is removed or replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt die Ordner, die Sie im Tab „Installiert“ von Wallpaper Engine erstellt haben, dem Tab „Installiert“ hier hinzu. Nichts wird entfernt oder ersetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute à l’onglet Installés d’ici les dossiers que vous avez créés dans l’onglet Installés de Wallpaper Engine. Rien n’est supprimé ni remplacé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a la pestaña Instalados de aquí las carpetas que creaste en la pestaña Instalados de Wallpaper Engine. No se elimina ni se sustituye nada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona à aba Instaladas daqui as pastas que você criou na aba Instaladas do Wallpaper Engine. Nada é removido ou substituído."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge alla scheda Installati di qui le cartelle che hai creato nella scheda Installati di Wallpaper Engine. Nulla viene rimosso o sostituito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine の「インストール済み」タブで作成したフォルダを、ここの「インストール済み」タブに追加します。削除や置き換えは行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine의 설치됨 탭에서 만든 폴더를 여기의 설치됨 탭에 추가합니다. 아무것도 제거하거나 대치하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你在 Wallpaper Engine“已安装”标签页中创建的文件夹添加到此处的“已安装”标签页。不会移除或替换任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將你在 Wallpaper Engine「已安裝」標籤頁中建立的檔案夾加入這裡的「已安裝」標籤頁。不會移除或取代任何內容。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет папки, созданные на вкладке «Установленные» в Wallpaper Engine, на вкладку «Установленные» здесь. Ничего не удаляется и не заменяется."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje foldery utworzone na karcie Zainstalowane w Wallpaper Engine do karty Zainstalowane tutaj. Nic nie zostanie usunięte ani zastąpione."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine’in Yüklü sekmesinde oluşturduğunuz klasörleri buradaki Yüklü sekmesine ekler. Hiçbir şey kaldırılmaz veya değiştirilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає папки, створені на вкладці «Встановлені» у Wallpaper Engine, на вкладку «Встановлені» тут. Нічого не вилучається й не замінюється."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف المجلدات التي أنشأتها في علامة تبويب المثبتة في Wallpaper Engine إلى علامة تبويب المثبتة هنا. لا تتم إزالة أي شيء أو استبداله."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine के इंस्टॉल किए गए टैब में आपके बनाए फ़ोल्डर यहाँ के इंस्टॉल किए गए टैब में जोड़ता है। कुछ भी हटाया या बदला नहीं जाता।"
          }
        }
      }
    },
    "Adds the wallpapers you favourited in Wallpaper Engine to My Favourites. Nothing is removed." : {
      "comment" : "Help for the Import Wallpaper Engine Favourites button; My Favourites is the library filter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف خلفيات الشاشة التي أضفتها إلى المفضلة في Wallpaper Engine إلى مفضلتي. لا تتم إزالة أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt die Hintergrundbilder, die Sie in Wallpaper Engine als Favoriten markiert haben, zu „Meine Favoriten“ hinzu. Es wird nichts entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a «Mis favoritos» los fondos de pantalla que marcaste como favoritos en Wallpaper Engine. No se quita nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute à « Mes favoris » les fonds d’écran que vous avez mis en favoris dans Wallpaper Engine. Rien n’est supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine में पसंदीदा बनाए गए वॉलपेपर को मेरे पसंदीदा में जोड़ता है। कुछ भी हटाया नहीं जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge a “I miei preferiti” gli sfondi che hai aggiunto ai preferiti in Wallpaper Engine. Non viene rimosso nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine でお気に入りにした壁紙を「お気に入り」に追加します。何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine에서 즐겨찾기한 배경화면을 나의 즐겨찾기에 추가합니다. 아무것도 제거되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje do „Moje ulubione” tapety oznaczone jako ulubione w Wallpaper Engine. Nic nie jest usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona a Meus Favoritos as imagens de fundo que você marcou como favoritas no Wallpaper Engine. Nada é removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет в «Избранное» обои, отмеченные как избранные в Wallpaper Engine. Ничего не удаляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine’de favorilere eklediğiniz duvar kâğıtlarını Favorilerim’e ekler. Hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає до «Мої улюблені» шпалери, позначені як улюблені у Wallpaper Engine. Нічого не вилучається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你在 Wallpaper Engine 中收藏的墙纸添加到“个人收藏”。不会移除任何项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將你在 Wallpaper Engine 中加入喜好項目的背景圖片加入「我的喜好項目」。不會移除任何項目。"
          }
        }
      }
    },
    "Adjust Menu Bar Color" : {
