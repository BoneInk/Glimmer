    "Reads the permission again and starts audio capture if it's now allowed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ الإذن مجددًا ويبدأ التقاط الصوت إذا أصبح مسموحًا الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Berechtigung erneut und startet die Audioaufnahme, wenn sie jetzt erlaubt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a leer el permiso e inicia la captura de audio si ahora está permitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relit l’autorisation et lance la capture audio si elle est désormais accordée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति फिर से पढ़ता है और अगर अब अनुमति है तो ऑडियो कैप्चर शुरू करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilegge l’autorizzazione e avvia l’acquisizione audio se ora è consentita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限をもう一度読み取り、許可されていればオーディオの取り込みを開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한을 다시 읽고 이제 허용되었으면 오디오 캡처를 시작합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
