    },
    "Pauses every wallpaper while the GPU runs out of video memory, and resumes them when memory frees up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف كل الخلفيات مؤقتًا عندما تنفد ذاكرة الفيديو في وحدة GPU، ويستأنفها عند تحرّر الذاكرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert alle Hintergrundbilder, solange der GPU der Grafikspeicher ausgeht, und setzt sie fort, sobald wieder Speicher frei ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa todos los fondos de pantalla mientras la GPU se queda sin memoria de vídeo y los reanuda cuando se libera memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause tous les fonds d’écran lorsque le GPU manque de mémoire vidéo, et les reprend dès que de la mémoire se libère."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU की वीडियो मेमोरी खत्म होने पर सभी वॉलपेपर को पॉज़ करता है, और मेमोरी खाली होने पर उन्हें फिर से चलाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa tutti gli sfondi mentre la GPU esaurisce la memoria video e li riprende quando la memoria si libera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU のビデオメモリが不足している間はすべての壁紙を一時停止し、メモリが空くと再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU의 비디오 메모리가 부족한 동안 모든 배경화면을 일시 정지하고, 메모리가 확보되면 다시 재생합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje wszystkie tapety, gdy GPU brakuje pamięci wideo, i wznawia je, gdy pamięć się zwolni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa todas as imagens de fundo enquanto a GPU fica sem memória de vídeo e as retoma quando a memória é liberada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит все обои на паузу, пока у GPU заканчивается видеопамять, и возобновляет их, когда память освобождается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU’nun video belleği tükendiğinde tüm duvar kâğıtlarını duraklatır ve bellek boşaldığında devam ettirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиняє всі шпалери, поки GPU бракує відеопамʼяті, і відновлює їх, коли памʼять звільняється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 显存耗尽时暂停所有墙纸，显存释放后恢复播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 顯示記憶體耗盡時暫停所有背景圖片，記憶體釋放後恢復播放。"
          }
        }
      }
    },
