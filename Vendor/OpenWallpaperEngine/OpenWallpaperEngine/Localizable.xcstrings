    "The Day of Week playlist does not support more than 7 wallpapers." : {
      "comment" : "A day-of-week playlist plays its first 7 wallpapers only",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة تشغيل أيام الأسبوع لا تحتمل أكثر من 7 خلفيات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wochentag-Playlist kann nicht mehr als 7 Hintergrundbilder enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist semanal no puede tener más de 7 fondos de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist Jour de la semaine ne prend pas en charge plus de 7 fonds d’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सप्ताह के दिन वाली प्लेलिस्ट में 7 से ज़्यादा वॉलपेपर नहीं हो सकते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist Giorno della settimana non può contenere più di 7 sfondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曜日別プレイリストに登録できる壁紙の数は7つまでです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요일 플레이리스트는 최대 7개의 배경화면만 포함할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlista „Dzień tygodnia” może zawierać maksymalnie siedem tapet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A playlist Dia da Semana só oferece suporte para 7 imagens de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В плейлисте «День недели» может быть не более 7 обоев."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
