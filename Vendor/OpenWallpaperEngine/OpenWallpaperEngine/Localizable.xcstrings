    "Live Photos can be made only from MP4, M4V or MOV video files in your library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إنشاء صور Live Photo إلا من ملفات الفيديو بتنسيق MP4 أو M4V أو MOV الموجودة في مكتبتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photos können nur aus MP4-, M4V- oder MOV-Videodateien aus Ihrer Mediathek erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Live Photos solo se pueden crear a partir de archivos de vídeo MP4, M4V o MOV de tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Live Photos ne peuvent être créées qu’à partir de fichiers vidéo MP4, M4V ou MOV de votre bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo केवल आपकी लाइब्रेरी की MP4, M4V या MOV वीडियो फ़ाइलों से बनाई जा सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Live Photo si possono creare solo da file video MP4, M4V o MOV della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photoは、ライブラリ内のMP4、M4V、MOVビデオファイルからのみ作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo는 보관함의 MP4, M4V 또는 MOV 비디오 파일로만 만들 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo można utworzyć tylko z plików wideo MP4, M4V lub MOV z Twojej biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Live Photos só podem ser criadas a partir de arquivos de vídeo MP4, M4V ou MOV da sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo можно создать только из видеофайлов MP4, M4V или MOV из вашей библиотеки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo’lar yalnızca arşivinizdeki MP4, M4V veya MOV video dosyalarından oluşturulabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo можна створити лише з відеофайлів MP4, M4V або MOV з вашої бібліотеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能用资源库中的 MP4、M4V 或 MOV 视频文件制作实况照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
