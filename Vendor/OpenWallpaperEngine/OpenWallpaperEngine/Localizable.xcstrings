          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्रेम एक टेक्सचर में नहीं समाते (%1$lld × %2$lld पिक्सेल)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fotogrammi non entrano in una texture (%1$lld × %2$lld pixel)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレームが 1 つのテクスチャに収まりません（%1$lld × %2$lld ピクセル）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프레임이 하나의 텍스처에 들어가지 않습니다(%1$lld × %2$lld픽셀)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klatki nie mieszczą się w jednej teksturze (%1$lld × %2$lld pikseli)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os quadros não cabem em uma textura (%1$lld × %2$lld pixels)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кадры не помещаются в одну текстуру (%1$lld × %2$lld пикс.)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kareler tek bir dokuya sığmıyor (%1$lld × %2$lld piksel)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кадри не вміщаються в одну текстуру (%1$lld × %2$lld пікселів)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些帧无法放入一张纹理（%1$lld × %2$lld 像素）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些影格無法放入一張材質（%1$lld × %2$lld 像素）。"
          }
        }
      }
    },
    "The hotkey “%@” uses this shortcut. Use Anyway moves it to this hotkey." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الاختصار ”%@“ هذه المفاتيح. يؤدي «الاستخدام على أي حال» إلى نقلها إلى هذا الاختصار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tastenkombination „%@“ verwendet diesen Kurzbefehl. „Trotzdem verwenden“ überträgt ihn auf diese Tastenkombination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tecla de acceso rápido «%@» usa esta función rápida. «Usar de todos modos» la pasa a esta tecla de acceso rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci « %@ » utilise cette combinaison. « Utiliser quand même » la déplace vers ce raccourci."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हॉटकी “%@” यह शॉर्टकट इस्तेमाल करती है। “फिर भी इस्तेमाल करें” इसे इस हॉटकी पर ले आता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tasto di scelta rapida “%@” usa questa abbreviazione. “Usa comunque” la sposta su questo tasto di scelta rapida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキー「%@」がこのショートカットを使用しています。「このまま使用」を選ぶと、このホットキーに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 단축키가 이 키 조합을 사용합니다. ‘그래도 사용’을 선택하면 이 단축키로 옮겨집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisz dostępu „%@” używa tego skrótu. „Użyj mimo to” przenosi go do tego klawisza dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho “%@” usa esta combinação. Usar Mesmo Assim a move para este atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Горячая клавиша «%@» использует это сочетание клавиш. «Всё равно использовать» переносит его на эту горячую клавишу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kısayol tuşu bu kısayolu kullanıyor. “Yine de Kullan” onu bu kısayol tuşuna taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гаряча клавіша «%@» використовує це скорочення. «Усе одно використати» переносить його на цю гарячу клавішу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热键“%@”使用了此快捷键。“仍然使用”会将它移到此热键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速鍵「%@」使用了此按鍵組合。「仍要使用」會將它移到此快速鍵。"
          }
        }
      }
    },
