    "Point the effect radiates from, as a fraction of the layer (0.5, 0.5 is the middle)." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like center",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقطة التي ينبعث منها التأثير، كنسبة من الطبقة (0.5، 0.5 هي المنتصف)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkt, von dem der Effekt ausstrahlt, als Anteil der Ebene (0,5, 0,5 ist die Mitte)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto desde el que irradia el efecto, como fracción de la capa (0,5, 0,5 es el centro)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point à partir duquel l’effet rayonne, en fraction du calque (0,5, 0,5 correspond au milieu)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह बिंदु जहाँ से इफ़ेक्ट फैलता है, लेयर के अंश के रूप में (0.5, 0.5 बीच का बिंदु है)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punto da cui si irradia l’effetto, come frazione del livello (0,5, 0,5 è il centro)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エフェクトが放射される点です。レイヤーに対する比率で指定します（0.5, 0.5が中央）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "효과가 퍼져 나가는 지점으로, 레이어에 대한 비율로 나타냅니다(0.5, 0.5가 중앙)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkt, z którego rozchodzi się efekt, jako ułamek wymiarów warstwy (0,5; 0,5 to środek)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponto a partir do qual o efeito se irradia, como fração da camada (0,5, 0,5 é o meio)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точка, от которой расходится эффект, в долях слоя (0,5, 0,5 — середина)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efektin yayıldığı nokta, katmanın oranı olarak (0.5, 0.5 ortadır)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точка, від якої розходиться ефект, як частка шару (0,5, 0,5 — середина)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效果辐射的起点，以图层的比例表示（0.5, 0.5 为中心）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效果發散的起點，以圖層的比例表示（0.5, 0.5 為中心）。"
          }
        }
      }
