        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia działają bez zachowywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes ajustes entram em vigor sem precisar salvar."
          }
        },
        "ru" : {
