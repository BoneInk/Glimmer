        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबवत स्पीड. ऋणात्मक मान उल्टी दिशा में ले जाते हैं, 0 रोक देता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità verticale. I valori negativi muovono nella direzione opposta, 0 si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縦方向の速度です。負の値で逆方向に動き、0で停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세로 속도입니다. 음수이면 반대 방향으로 움직이고, 0이면 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość w pionie. Wartości ujemne odwracają kierunek, 0 zatrzymuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade vertical. Valores negativos movem no sentido oposto; 0 para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость по вертикали. Отрицательные значения — в обратную сторону, 0 — остановка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikey hız. Negatif değerler ters yönde hareket ettirir, 0 durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вертикальна швидкість. Відʼємні значення рухають у протилежний бік, 0 зупиняє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直速度。负值向相反方向移动，0 为停止。"
