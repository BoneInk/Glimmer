    "Adjust volume, playback speed, placement and any property the wallpaper's author exposed, right from the details sidebar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط مستوى الصوت وسرعة التشغيل وطريقة العرض وأي خاصية أتاحها مؤلف الخلفية، مباشرةً من الشريط الجانبي للتفاصيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie Lautstärke, Wiedergabegeschwindigkeit, Platzierung und alle vom Autor des Hintergrundbilds freigegebenen Eigenschaften direkt in der Detail-Seitenleiste an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el volumen, la velocidad de reproducción, la colocación y cualquier propiedad que haya expuesto el autor del fondo de pantalla, directamente desde la barra lateral de detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez le volume, la vitesse de lecture, la disposition et toutes les propriétés proposées par l’auteur du fond d’écran, directement depuis la barre latérale des détails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉल्यूम, प्लेबैक स्पीड, प्लेसमेंट और वॉलपेपर के लेखक द्वारा उपलब्ध कराई गई कोई भी प्रॉपर्टी सीधे विवरण साइडबार से एडजस्ट करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola il volume, la velocità di riproduzione, la posizione e ogni proprietà resa disponibile dall’autore dello sfondo, direttamente dalla barra laterale dei dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、再生速度、配置、壁紙の作成者が公開したあらゆるプロパティを、詳細サイドバーから直接調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음량, 재생 속도, 배치 및 배경화면 제작자가 공개한 모든 속성을 세부사항 사이드바에서 바로 조정할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj głośność, szybkość odtwarzania, rozmieszczenie i każdą właściwość udostępnioną przez autora tapety — prosto z paska bocznego ze szczegółami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o volume, a velocidade de reprodução, o posicionamento e qualquer propriedade exposta pelo autor da imagem de fundo, direto na barra lateral de detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраивайте громкость, скорость воспроизведения, расположение и любые параметры, открытые автором обоев, прямо в боковой панели сведений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses düzeyini, oynatma hızını, yerleşimi ve duvar kâğıdının yazarının sunduğu her özelliği doğrudan ayrıntılar kenar çubuğundan ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштовуйте гучність, швидкість відтворення, розміщення та будь-які властивості, які надав автор шпалери, просто на бічній панелі деталей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接在详细信息边栏中调整音量、播放速度、摆放方式以及墙纸作者开放的任何属性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接在詳細資訊側邊欄中調整音量、播放速度、擺放方式，以及背景圖片作者開放的任何屬性。"
          }
        }
      }
    },
