    "No Android exports yet. Export a wallpaper for Android, or add .mpkg files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد عمليات تصدير لـ Android بعد. صدّر خلفية لـ Android أو أضف ملفات ‎.mpkg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Android-Exporte. Exportiere ein Hintergrundbild für Android oder füge .mpkg-Dateien hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay exportaciones para Android. Exporta un fondo para Android o añade archivos .mpkg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune exportation Android pour l’instant. Exportez un fond d’écran pour Android ou ajoutez des fichiers .mpkg."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक कोई Android एक्सपोर्ट नहीं। किसी वॉलपेपर को Android के लिए एक्सपोर्ट करें, या .mpkg फ़ाइलें जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna esportazione per Android. Esporta uno sfondo per Android o aggiungi file .mpkg."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 用の書き出しはまだありません。壁紙を Android 用に書き出すか、.mpkg ファイルを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 Android 내보내기가 없습니다. 배경화면을 Android용으로 내보내거나 .mpkg 파일을 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak eksportów na Androida. Wyeksportuj tapetę na Androida lub dodaj pliki .mpkg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma exportação para Android ainda. Exporte um papel de parede para Android ou adicione arquivos .mpkg."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортов для Android пока нет. Экспортируйте обои для Android или добавьте файлы .mpkg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz Android dışa aktarımı yok. Bir duvar kâğıdını Android için dışa aktarın ya da .mpkg dosyası ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортів для Android ще немає. Експортуйте шпалери для Android або додайте файли .mpkg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有 Android 导出项。请将壁纸导出用于 Android，或添加 .mpkg 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無 Android 輸出項目。請將桌布輸出供 Android 使用，或加入 .mpkg 檔案。"
          }
        }
      }
    },
