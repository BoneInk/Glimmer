    "Horizontal speed. Negative values move the other way, 0 stops." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like speedx",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السرعة الأفقية. القيم السالبة تحرّك في الاتجاه المعاكس، و0 يوقف الحركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horizontale Geschwindigkeit. Negative Werte bewegen in die Gegenrichtung, 0 stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad horizontal. Los valores negativos mueven en sentido contrario; 0 lo detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse horizontale. Les valeurs négatives vont dans l’autre sens, 0 arrête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्षैतिज स्पीड. ऋणात्मक मान उल्टी दिशा में ले जाते हैं, 0 रोक देता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità orizzontale. I valori negativi muovono nella direzione opposta, 0 si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横方向の速度です。負の値で逆方向に動き、0で停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로 속도입니다. 음수이면 반대 방향으로 움직이고, 0이면 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość w poziomie. Wartości ujemne odwracają kierunek, 0 zatrzymuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade horizontal. Valores negativos movem no sentido oposto; 0 para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость по горизонтали. Отрицательные значения — в обратную сторону, 0 — остановка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatay hız. Negatif değerler ters yönde hareket ettirir, 0 durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Горизонтальна швидкість. Відʼємні значення рухають у протилежний бік, 0 зупиняє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平速度。负值向相反方向移动，0 为停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平速度。負值會反向移動，0 為停止。"
          }
        }
      }
    },
