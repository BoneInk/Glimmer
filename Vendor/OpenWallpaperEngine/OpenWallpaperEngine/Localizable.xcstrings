    "Each wallpaper shows from its start time until the next one's." : {
      "comment" : "Playlist Settings: what Time of day does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر كل خلفية من وقت بدئها حتى وقت بدء الخلفية التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Hintergrundbild wird ab seiner Startzeit bis zur Startzeit des nächsten gezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fondo de pantalla se muestra desde su hora de inicio hasta la del siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fond d’écran s’affiche de son heure de début jusqu’à celle du suivant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर वॉलपेपर अपने शुरू होने के समय से अगले वॉलपेपर के समय तक दिखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni sfondo appare dalla sua ora di inizio fino a quella del successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各壁紙は開始時刻から次の壁紙の開始時刻まで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 배경화면은 시작 시각부터 다음 배경화면의 시작 시각까지 표시됩니다."
