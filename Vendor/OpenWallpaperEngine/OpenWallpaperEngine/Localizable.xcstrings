    "Found a security problem? Please report it privately, not in a public issue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل وجدت مشكلة أمنية؟ يُرجى الإبلاغ عنها بشكل خاص، وليس في بلاغ عام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheitsproblem gefunden? Bitte melden Sie es vertraulich, nicht in einem öffentlichen Issue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has encontrado un problema de seguridad? Infórmalo en privado, no en una incidencia pública."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez trouvé un problème de sécurité ? Signalez-le en privé, pas dans un ticket public."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सुरक्षा समस्या मिली? कृपया इसकी रिपोर्ट निजी तौर पर करें, सार्वजनिक इश्यू में नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai trovato un problema di sicurezza? Segnalalo in privato, non in una issue pubblica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティの問題を見つけましたか？公開のIssueではなく、非公開で報告してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 문제를 발견했습니까? 공개 이슈가 아니라 비공개로 신고해 주십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znalazłeś problem z bezpieczeństwem? Zgłoś go prywatnie, nie w publicznym zgłoszeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrou um problema de segurança? Relate-o em particular, não em uma issue pública."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нашли проблему безопасности? Сообщите о ней конфиденциально, а не в открытом обсуждении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir güvenlik sorunu mu buldunuz? Lütfen herkese açık bir sorun kaydıyla değil, gizli olarak bildirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайшли проблему безпеки? Повідомте про неї приватно, а не у відкритому зверненні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现了安全问题？请私下报告，不要提交公开议题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發現安全性問題？請私下回報，不要發佈公開議題。"
          }
        }
