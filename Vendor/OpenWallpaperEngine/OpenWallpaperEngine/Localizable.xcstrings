    "Opacity left behind where the colour is keyed out. 0 makes matched pixels fully transparent." : {
      "comment" : "Scene Edit / Export tooltip for the colorkey effect's alpha parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العتامة المتبقية حيث تتم إزالة اللون. 0 يجعل وحدات البكسل المطابقة شفافة تمامًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbleibende Deckkraft dort, wo die Farbe freigestellt wird. 0 macht passende Pixel vollständig transparent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacidad que queda donde se elimina el color. 0 hace que los píxeles coincidentes sean totalmente transparentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacité conservée là où la couleur est détourée. 0 rend les pixels correspondants totalement transparents."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ रंग हटाया जाता है, वहाँ बची रहने वाली अपारदर्शिता. 0 मेल खाने वाले पिक्सेल को पूरी तरह पारदर्शी बनाता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacità lasciata dove il colore viene rimosso. 0 rende completamente trasparenti i pixel corrispondenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カラーキーで抜かれた部分に残る不透明度です。0では一致したピクセルが完全に透明になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상이 키 아웃된 곳에 남는 불투명도입니다. 0이면 일치하는 픽셀이 완전히 투명해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krycie pozostawiane tam, gdzie kolor jest wycinany. 0 sprawia, że pasujące piksele są całkowicie przezroczyste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opacidade que resta onde a cor é removida. 0 torna os pixels correspondentes totalmente transparentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрозрачность в местах, где цвет удалён. 0 делает совпавшие пиксели полностью прозрачными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rengin ayıklandığı yerlerde kalan opaklık. 0, eşleşen pikselleri tamamen saydam yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрозорість, що залишається там, де колір вирізано. 0 робить відповідні пікселі повністю прозорими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色被抠除处保留的不透明度。0 使匹配的像素完全透明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色被去除處保留的不透明度。0 會讓符合的像素完全透明。"
          }
        }
      }
    },
