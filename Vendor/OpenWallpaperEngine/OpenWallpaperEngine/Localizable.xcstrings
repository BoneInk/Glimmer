        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva i livelli nell’elenco a sinistra. Il salvaschermo mantiene queste scelte per questo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左のリストでレイヤーをオンまたはオフにします。スクリーンセーバはこの壁紙の選択を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 목록에서 레이어를 켜거나 끕니다. 화면 보호기는 이 배경화면에 대한 선택을 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączaj lub wyłączaj warstwy na liście po lewej. Wygaszacz ekranu zachowuje te wybory dla tej tapety."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative ou desative camadas na lista à esquerda. O protetor de tela mantém essas escolhas para este papel de parede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включайте и выключайте слои в списке слева. Заставка запоминает этот выбор для этих обоев."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldaki listeden katmanları açın veya kapatın. Ekran koruyucu bu seçimleri bu duvar kâğıdı için saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вмикайте й вимикайте шари в списку ліворуч. Заставка запам’ятовує цей вибір для цих шпалер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在左侧列表中打开或关闭图层。屏幕保护程序会为此墙纸保留这些选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在左側列表中開啟或關閉圖層。螢幕保護程式會為此背景圖片保留這些選擇。"
          }
        }
      }
    },
