          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンにはお持ちの Steam 版の Wallpaper Engine アセットが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면에는 Steam 사본의 Wallpaper Engine 에셋이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceny wymagają zasobów Wallpaper Engine z Twojej kopii Steam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cenas precisam dos recursos do Wallpaper Engine da sua cópia Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сценам нужны ресурсы Wallpaper Engine из вашей копии в Steam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahneler Steam kopyanızdaki Wallpaper Engine varlıklarına ihtiyaç duyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сценам потрібні ресурси Wallpaper Engine з вашої копії в Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "场景需要你 Steam 副本中的 Wallpaper Engine 资源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場景需要你 Steam 副本中的 Wallpaper Engine 資源。"
          }
        }
      }
    },
    "Scenes need Wallpaper Engine assets from your Steam copy: built-in effects, shaders, materials and fonts. Video and web wallpapers play without them." : {
      "comment" : "Settings › Assets explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج المشاهد إلى موارد Wallpaper Engine من نسختك على Steam: التأثيرات المضمّنة والمظللات والمواد والخطوط. تعمل خلفيات الفيديو والويب بدونها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szenen brauchen Wallpaper Engine-Assets aus deiner Steam-Kopie: integrierte Effekte, Shader, Materialien und Schriften. Video- und Web-Hintergrundbilder laufen ohne sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las escenas necesitan los recursos de Wallpaper Engine de tu copia de Steam: efectos integrados, sombreadores, materiales y tipos de letra. Los fondos de pantalla de vídeo y web funcionan sin ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scènes ont besoin des ressources de Wallpaper Engine de votre copie Steam : effets intégrés, nuanceurs, matériaux et polices. Les fonds d’écran vidéo et web fonctionnent sans elles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीन को आपकी Steam कॉपी के Wallpaper Engine ऐसेट चाहिए: बिल्ट-इन इफ़ेक्ट, शेडर, मटीरियल और फ़ॉन्ट। वीडियो और वेब वॉलपेपर इनके बिना चलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scene richiedono le risorse di Wallpaper Engine dalla tua copia Steam: effetti integrati, shader, materiali e font. Gli sfondi video e web funzionano senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンにはお持ちの Steam 版の Wallpaper Engine アセット（内蔵エフェクト、シェーダー、マテリアル、フォント）が必要です。ビデオと Web の壁紙はなくても再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면에는 Steam 사본의 Wallpaper Engine 에셋(내장 효과, 셰이더, 머티리얼, 서체)이 필요합니다. 비디오 및 웹 배경화면은 에셋 없이 재생됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceny wymagają zasobów Wallpaper Engine z Twojej kopii Steam: wbudowanych efektów, shaderów, materiałów i czcionek. Tapety wideo i sieciowe działają bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cenas precisam dos recursos do Wallpaper Engine da sua cópia Steam: efeitos integrados, shaders, materiais e fontes. Imagens de fundo de vídeo e web funcionam sem eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сценам нужны ресурсы Wallpaper Engine из вашей копии в Steam: встроенные эффекты, шейдеры, материалы и шрифты. Видео- и веб-обои работают без них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahneler Steam kopyanızdaki Wallpaper Engine varlıklarına ihtiyaç duyar: yerleşik efektler, gölgelendiriciler, malzemeler ve fontlar. Video ve web duvar kâğıtları onlarsız oynatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сценам потрібні ресурси Wallpaper Engine з вашої копії в Steam: вбудовані ефекти, шейдери, матеріали й шрифти. Відео- та веб-шпалери працюють без них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "场景需要你 Steam 副本中的 Wallpaper Engine 资源：内置效果、着色器、材质和字体。视频和网页墙纸无需这些资源即可播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場景需要你 Steam 副本中的 Wallpaper Engine 資源：內建效果、著色器、材質和字體。影片和網頁背景圖片不需要這些資源即可播放。"
          }
        }
      }
    },
