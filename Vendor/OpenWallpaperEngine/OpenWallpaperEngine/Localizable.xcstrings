    "%@ isn't connected. Workshop downloads fail until you connect it or choose another folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ غير متصل. ستفشل تنزيلات الورشة إلى أن تقوم بتوصيله أو تختار مجلدًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht verbunden. Workshop-Downloads schlagen fehl, bis Sie das Volume verbinden oder einen anderen Ordner wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectado. Las descargas del Workshop fallarán hasta que lo conectes o elijas otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas connecté. Les téléchargements du Workshop échoueront tant que vous ne l’aurez pas connecté ou choisi un autre dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कनेक्ट नहीं है. जब तक आप इसे कनेक्ट नहीं करते या कोई दूसरा फ़ोल्डर नहीं चुनते, Workshop डाउनलोड विफल रहेंगे."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è collegato. I download dal Workshop non riusciranno finché non lo colleghi o non scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が接続されていません。接続するか別のフォルダを選択するまで、ワークショップのダウンロードは失敗します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 연결되어 있지 않습니다. 연결하거나 다른 폴더를 선택할 때까지 창작마당 다운로드가 실패합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dysk „%@” nie jest podłączony. Pobieranie z Warsztatu nie będzie działać, dopóki go nie podłączysz lub nie wybierzesz innego folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está conectado. Os downloads da Oficina falharão até que você o conecte ou escolha outra pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не подключён. Загрузки из Мастерской не будут работать, пока вы не подключите диск или не выберете другую папку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlı değil. Bu birimi bağlayana veya başka bir klasör seçene kadar Atölye indirmeleri başarısız olur."
