    "Stops reading assets from the chosen folder; downloaded assets are used if there are any. The folder itself isn't changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف عن قراءة الموارد من المجلد المختار، وتُستخدم الموارد المُنزَّلة إن وُجدت. ولا يتغير المجلد نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest keine Assets mehr aus dem ausgewählten Ordner; geladene Assets werden verwendet, falls vorhanden. Der Ordner selbst bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de leer recursos de la carpeta elegida; se usan los recursos descargados si los hay. La carpeta en sí no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesse de lire les ressources dans le dossier choisi ; les ressources téléchargées sont utilisées s’il y en a. Le dossier lui-même n’est pas modifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने गए फ़ोल्डर से ऐसेट पढ़ना बंद करता है; डाउनलोड किए गए ऐसेट हों तो वे इस्तेमाल होते हैं। फ़ोल्डर खुद नहीं बदलता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smette di leggere le risorse dalla cartella scelta; vengono usate quelle scaricate, se presenti. La cartella non viene modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダからのアセットの読み込みをやめ、ダウンロード済みのアセットがあればそれを使います。フォルダ自体は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더에서 에셋 읽기를 중단하고, 다운로드한 에셋이 있으면 그것을 사용합니다. 폴더 자체는 변경되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestaje odczytywać zasoby z wybranego folderu; używane są pobrane zasoby, jeśli istnieją. Sam folder nie jest zmieniany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para de ler recursos da pasta escolhida; os recursos baixados são usados, se houver. A pasta em si não é alterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прекращает читать ресурсы из выбранной папки; используются загруженные ресурсы, если они есть. Сама папка не меняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen klasörden varlık okumayı durdurur; varsa indirilen varlıklar kullanılır. Klasörün kendisi değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Припиняє читати ресурси з вибраної папки; використовуються викачані ресурси, якщо вони є. Саму папку не змінено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止从所选文件夹读取资源；如有已下载的资源则使用它们。文件夹本身不会更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止從所選檔案夾讀取資源；如有已下載的資源則使用它們。檔案夾本身不會變更。"
          }
        }
      }
    },
    "Strength of the blend. 0 leaves the layer untouched, 1 applies it fully." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like multiply",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
