    "Without Steam, video and web wallpapers still work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون Steam، تظل خلفيات الفيديو والويب تعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Steam funktionieren Video- und Web-Hintergrundbilder weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin Steam, los fondos de pantalla de vídeo y web siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans Steam, les fonds d’écran vidéo et web fonctionnent quand même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam के बिना भी वीडियो और वेब वॉलपेपर काम करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza Steam, gli sfondi video e web funzionano comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam がなくても、ビデオと Web の壁紙は使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 없이도 비디오와 웹 배경화면은 작동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Steam tapety wideo i sieciowe nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o Steam, as imagens de fundo de vídeo e web continuam funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без Steam видео- и веб-обои всё равно работают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam olmadan da video ve web duvar kâğıtları çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без Steam відео- та веб-шпалери все одно працюють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
