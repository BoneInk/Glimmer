    "Find wallpapers by name, tag, or browse trending content." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن الخلفيات بالاسم أو الوسم، أو تصفح المحتوى الرائج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen Sie Hintergrundbilder nach Name oder Tag oder stöbern Sie in angesagten Inhalten."
          }
        },
        "es" : {
          "stringUnit" : {
