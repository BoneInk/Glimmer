    "Nearest Apple Accent" : {
      "comment" : "Settings › Theming: the system accent becomes the closest of macOS's eight accent colors",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقرب لون تمييز من Apple"
          }
        },
        "de" : {
          "stringUnit" : {
