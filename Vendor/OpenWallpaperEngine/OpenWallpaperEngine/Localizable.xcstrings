          }
        }
      }
    },
    "Only enter files and websites you fully trust, and don’t paste commands you don’t understand." : {
      "comment" : "Security notice in the user shortcut sheet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُدخل إلا الملفات ومواقع الويب التي تثق بها تمامًا، ولا تلصق أوامر لا تفهمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie nur Dateien und Websites ein, denen Sie voll vertrauen, und fügen Sie keine Befehle ein, die Sie nicht verstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce solo archivos y sitios web en los que confíes plenamente, y no pegues comandos que no entiendas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez uniquement des fichiers et des sites web auxquels vous faites entièrement confiance, et ne collez pas de commandes que vous ne comprenez pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल वे फ़ाइलें और वेबसाइटें दर्ज करें जिन पर आपको पूरा भरोसा है, और ऐसी कमांड पेस्ट न करें जिन्हें आप नहीं समझते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci solo file e siti web di cui ti fidi completamente e non incollare comandi che non capisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全に信頼できるファイルとWebサイトだけを入力してください。理解できないコマンドは貼り付けないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전히 신뢰하는 파일과 웹 사이트만 입력하고, 이해하지 못하는 명령은 붙여넣지 마십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podawaj tylko pliki i strony internetowe, którym w pełni ufasz, i nie wklejaj poleceń, których nie rozumiesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira apenas arquivos e sites em que você confia totalmente e não cole comandos que você não entende."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указывайте только файлы и веб-сайты, которым вы полностью доверяете, и не вставляйте команды, которых вы не понимаете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca tamamen güvendiğiniz dosyaları ve web sitelerini girin; anlamadığınız komutları yapıştırmayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вказуйте лише файли та вебсайти, яким ви повністю довіряєте, і не вставляйте команди, яких ви не розумієте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只输入你完全信任的文件和网站，不要粘贴你不理解的命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只輸入你完全信任的檔案和網站，不要貼上你不理解的指令。"
          }
        }
      }
    },
    "Only scene wallpapers can be edited" : {
