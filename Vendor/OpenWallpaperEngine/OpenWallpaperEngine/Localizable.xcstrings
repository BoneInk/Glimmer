        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarlar kaydetmeden geçerli olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці налаштування набувають чинності без збереження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些设置无需保存即可生效。"
