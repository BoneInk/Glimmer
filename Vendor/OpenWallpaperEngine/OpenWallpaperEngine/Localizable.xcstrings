            "state" : "translated",
            "value" : "화면 보호기가 실시간으로 그려집니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygaszacz ekranu działa na żywo"
          }
        },
        "pt-BR" : {
