          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى Steam للتنزيل. يمكنك فعل ذلك في علامة تبويب الورشة أو في مساعد الإعداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich bei Steam an, um zu laden. Das geht im Tab „Workshop“ oder im Einrichtungsassistenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en Steam para descargar. Puedes hacerlo en la pestaña Workshop o en el asistente de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à Steam pour télécharger. Vous pouvez le faire dans l’onglet Workshop ou dans l’assistant de configuration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड करने के लिए Steam में लॉग इन करें। यह Workshop टैब या सेटअप असिस्टेंट में कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi a Steam per scaricare. Puoi farlo nella scheda Workshop o nell’assistente configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードするには Steam にログインしてください。「ワークショップ」タブまたは設定アシスタントでログインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드하려면 Steam에 로그인하십시오. 창작마당 탭이나 설정 지원에서 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się do Steam, aby pobierać. Możesz to zrobić na karcie Warsztat lub w asystencie konfiguracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie a sessão no Steam para baixar. Você pode fazer isso na aba Oficina ou no assistente de configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в Steam, чтобы загружать. Это можно сделать на вкладке «Мастерская» или в ассистенте настройки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmek için Steam’e giriş yapın. Bunu Atölye sekmesinde ya da Kurulum Yardımcısı’nda yapabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійдіть у Steam, щоб викачувати. Це можна зробити на вкладці «Майстерня» або в асистенті налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录 Steam 后才能下载。可以在“创意工坊”标签页或设置助理中登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入 Steam 後才能下載。可以在「工作坊」標籤頁或設定輔助程式中登入。"
          }
        }
      }
    },
