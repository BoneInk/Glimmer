    "Highest audio frequency band that drives this. Lower it to ignore hiss and cymbals." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like frequencymax",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى نطاق ترددات صوتية يتحكم في هذه القيمة. اخفضه لتجاهل الهسهسة والصنوج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstes Audiofrequenzband, das diesen Wert steuert. Verringern Sie es, um Rauschen und Becken zu ignorieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda de frecuencia de audio más alta que lo controla. Bájala para ignorar el siseo y los platillos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bande de fréquences audio la plus haute qui pilote ce paramètre. Baissez-la pour ignorer le souffle et les cymbales."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे चलाने वाला सबसे ऊँचा ऑडियो फ़्रीक्वेंसी बैंड. सिसकारी और झांझ की आवाज़ को अनदेखा करने के लिए इसे कम करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda di frequenza audio più alta che controlla il parametro. Abbassala per ignorare fruscii e piatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを駆動する最も高いオーディオ周波数帯です。ヒスノイズやシンバルを無視するには下げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 값을 구동하는 가장 높은 오디오 주파수 대역입니다. 치찰음과 심벌즈 소리를 무시하려면 낮추십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyższe pasmo częstotliwości dźwięku, które tym steruje. Obniż je, aby pominąć szum i talerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixa de frequência de áudio mais alta que controla isto. Diminua para ignorar chiados e pratos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верхняя граница диапазона частот, на которые реагирует параметр. Уменьшите её, чтобы игнорировать шипение и тарелки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu yönlendiren en yüksek ses frekans bandı. Cızırtıyı ve zilleri yok saymak için düşürün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найвища смуга звукових частот, що керує цим параметром. Зменште, щоб ігнорувати шипіння й тарілки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驱动此项的最高音频频段。降低它可忽略嘶嘶声和镲片声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驅動此參數的最高音訊頻段。調低可忽略嘶聲和鈸聲。"
          }
        }
      }
    },
