    "Up to seven wallpapers share the week, from its first day." : {
      "comment" : "Playlist Settings: what Day of week does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتقاسم حتى سبع خلفيات أيام الأسبوع، بدءًا من يومه الأول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu sieben Hintergrundbilder teilen sich die Woche, ab ihrem ersten Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta siete fondos de pantalla se reparten la semana, desde su primer día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à sept fonds d’écran se partagent la semaine, à partir de son premier jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सात तक वॉलपेपर हफ़्ते को उसके पहले दिन से बाँटते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a sette sfondi si dividono la settimana, a partire dal suo primo giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大7つの壁紙が、週の最初の日から1週間を分け合います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 7개의 배경화면이 한 주의 첫날부터 요일을 나눠 가집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do siedmiu tapet dzieli tydzień, od jego pierwszego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até sete imagens de fundo dividem a semana, a partir do primeiro dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До семи обоев делят неделю начиная с её первого дня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla yedi duvar kâğıdı, haftayı ilk gününden itibaren paylaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До семи шпалер ділять тиждень, починаючи з його першого дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多七张墙纸从一周的第一天起分享这一周。"
