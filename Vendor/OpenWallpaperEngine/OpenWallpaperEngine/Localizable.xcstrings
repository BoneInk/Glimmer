    "Downloads SteamCMD from Valve again, replacing the app's copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنزّل SteamCMD من Valve مجددًا ويستبدل نسخة التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt SteamCMD erneut von Valve und ersetzt die Kopie der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a descargar SteamCMD de Valve y sustituye la copia de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge à nouveau SteamCMD depuis Valve et remplace la copie de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve से SteamCMD फिर से डाउनलोड करता है और ऐप की कॉपी को बदल देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica di nuovo SteamCMD da Valve, sostituendo la copia dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve から SteamCMD を再ダウンロードし、App のコピーを置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valve에서 SteamCMD를 다시 다운로드해 앱의 사본을 대체합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponownie pobiera SteamCMD od Valve, zastępując kopię aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa o SteamCMD da Valve novamente, substituindo a cópia do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно загружает SteamCMD с сайта Valve, заменяя копию приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD’yi Valve’dan yeniden indirir ve uygulamanın kopyasını değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знову викачує SteamCMD з Valve, замінюючи копію програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Valve 重新下载 SteamCMD，替换 App 的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Valve 重新下載 SteamCMD，取代 App 的副本。"
          }
        }
      }
    },
    "Downloads SteamCMD from Valve when no copy is found. Workshop downloads and the assets install need it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنزّل SteamCMD من Valve عند عدم العثور على نسخة. وتحتاج إليه تنزيلات الورشة وتثبيت الموارد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt SteamCMD von Valve, wenn keine Kopie gefunden wird. Workshop-Downloads und die Installation der Assets brauchen es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga SteamCMD de Valve si no se encuentra ninguna copia. Las descargas de Workshop y la instalación de los recursos lo necesitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge SteamCMD depuis Valve si aucune copie n’est trouvée. Les téléchargements du Workshop et l’installation des ressources en ont besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई कॉपी न मिलने पर Valve से SteamCMD डाउनलोड करता है। Workshop डाउनलोड और ऐसेट इंस्टॉल के लिए यह ज़रूरी है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica SteamCMD da Valve se non ne trova una copia. Ne hanno bisogno i download dal Workshop e l’installazione delle risorse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーが見つからない場合に Valve から SteamCMD をダウンロードします。ワークショップのダウンロードとアセットのインストールに必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본이 없으면 Valve에서 SteamCMD를 다운로드합니다. 창작마당 다운로드와 에셋 설치에 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiera SteamCMD od Valve, gdy nie znaleziono kopii. Potrzebują go pobieranie z Warsztatu i instalacja zasobów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa o SteamCMD da Valve quando nenhuma cópia é encontrada. Os downloads da Oficina e a instalação dos recursos precisam dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает SteamCMD с сайта Valve, если копия не найдена. Он нужен для загрузок из Мастерской и установки ресурсов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopya bulunamazsa SteamCMD’yi Valve’dan indirir. Atölye indirmeleri ve varlıkların yüklenmesi için gereklidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Викачує SteamCMD з Valve, якщо копію не знайдено. Він потрібен для викачування з Майстерні та встановлення ресурсів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到副本时从 Valve 下载 SteamCMD。创意工坊下载和资源安装都需要它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到副本時從 Valve 下載 SteamCMD。工作坊下載和資源安裝都需要它。"
          }
        }
      }
    },
    "Downloads and installs updates by itself: when you quit, while you're away from your Mac, or within a day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنزّل التحديثات ويثبّتها تلقائيًا: عند الإنهاء، أو أثناء ابتعادك عن Mac، أو في غضون يوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Updates selbst und installiert sie: beim Beenden, während Sie nicht am Mac sind, oder innerhalb eines Tages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga e instala las actualizaciones por sí sola: al salir, mientras no estás en el Mac o en el plazo de un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge et installe les mises à jour de lui-même : quand vous quittez l’app, quand vous êtes loin de votre Mac ou dans la journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट अपने-आप डाउनलोड और इंस्टॉल करता है: ऐप बंद करने पर, Mac से दूर रहने पर या एक दिन के भीतर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica e installa gli aggiornamenti da solo: quando esci, mentre sei lontano dal Mac o entro un giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートを自動でダウンロードしてインストールします。終了時、Mac から離れているとき、または 1 日以内に行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트를 자동으로 다운로드하고 설치합니다. 종료할 때, Mac을 사용하지 않을 때 또는 하루 안에 설치됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sam pobiera i instaluje uaktualnienia: przy zamykaniu, gdy nie korzystasz z Maca, lub w ciągu doby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa e instala atualizações sozinho: quando você encerra o app, enquanto está longe do Mac ou em até um dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам загружает и устанавливает обновления: при выходе, пока вы не за Mac, или в течение дня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeleri kendisi indirir ve yükler: çıkarken, Mac’inizden uzaktayken ya da bir gün içinde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам викачує та встановлює оновлення: під час виходу, коли ви не за Mac, або протягом доби."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动下载并安装更新：在你退出时、离开 Mac 时或一天之内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動下載並安裝更新：在你結束時、離開 Mac 時或一天之內。"
          }
        }
      }
    },
