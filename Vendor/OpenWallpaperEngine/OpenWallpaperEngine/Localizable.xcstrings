        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine kopyanızı SteamCMD ile indirir ve yalnızca varlıklarını ve varsayılan duvar kâğıtlarını tutar. Wallpaper Engine’e sahip bir Steam oturumu gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
