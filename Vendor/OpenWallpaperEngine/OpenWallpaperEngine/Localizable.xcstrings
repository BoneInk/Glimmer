    "Leaves out wallpapers tagged Anime, MMD, Girls, Guys or Music, unless you check that genre" : {
      "comment" : "Help for the Workshop's Hide Anime setting; the tag names are Workshop genres",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبعد الخلفيات الموسومة بـ Anime أو MMD أو Girls أو Guys أو Music، ما لم تحدد ذلك النوع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt Hintergrundbilder mit den Tags Anime, MMD, Girls, Guys oder Music weg, außer du wählst dieses Genre aus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluye los fondos de pantalla con las etiquetas Anime, MMD, Girls, Guys o Music, salvo que marques ese género"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclut les fonds d’écran étiquetés Anime, MMD, Girls, Guys ou Music, sauf si vous cochez ce genre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anime, MMD, Girls, Guys या Music टैग वाले वॉलपेपर हटा देता है, जब तक आप वह शैली न चुनें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esclude gli sfondi con i tag Anime, MMD, Girls, Guys o Music, a meno che tu non selezioni quel genere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anime、MMD、Girls、Guys、Music のタグが付いた壁紙を除外します（そのジャンルをチェックした場合を除く）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anime, MMD, Girls, Guys 또는 Music 태그가 있는 배경화면을 제외합니다(해당 장르를 선택한 경우 제외)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomija tapety z tagami Anime, MMD, Girls, Guys lub Music, chyba że zaznaczysz ten gatunek"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa de fora as imagens de fundo com as etiquetas Anime, MMD, Girls, Guys ou Music, a menos que você marque esse gênero"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключает обои с тегами Anime, MMD, Girls, Guys или Music, если вы не отметили этот жанр"
          }
        },
        "tr" : {
          "stringUnit" : {
