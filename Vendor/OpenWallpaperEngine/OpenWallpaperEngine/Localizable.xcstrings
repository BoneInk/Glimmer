    "Horizontal scroll speed. Negative scrolls left, 0 stops. Only looks seamless on tiling textures." : {
      "comment" : "Scene Edit / Export tooltip for the scroll effect's speedx parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرعة التمرير الأفقي. القيم السالبة تمرّر إلى اليسار، و0 يوقفه. لا يبدو متصلًا إلا مع الأنسجة القابلة للتكرار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horizontale Scrollgeschwindigkeit. Negative Werte scrollen nach links, 0 stoppt. Wirkt nur bei kachelbaren Texturen nahtlos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de desplazamiento horizontal. Los valores negativos desplazan a la izquierda; 0 lo detiene. Solo queda continuo con texturas en mosaico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de défilement horizontal. Une valeur négative défile vers la gauche, 0 arrête. Le raccord n’est invisible qu’avec des textures en mosaïque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्षैतिज स्क्रॉल स्पीड. ऋणात्मक मान बाईं ओर स्क्रॉल करता है, 0 रोक देता है. केवल टाइल होने वाले टेक्सचर पर ही सहज दिखता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità di scorrimento orizzontale. I valori negativi scorrono a sinistra, 0 si ferma. Risulta continuo solo con texture ripetibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横方向のスクロール速度です。負の値で左へスクロールし、0で停止します。タイル状のテクスチャでのみ継ぎ目なく見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로 스크롤 속도입니다. 음수이면 왼쪽으로 스크롤되고, 0이면 멈춥니다. 타일링 텍스처에서만 이음새 없이 보입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość przewijania w poziomie. Wartości ujemne przewijają w lewo, 0 zatrzymuje. Wygląda płynnie tylko na teksturach kafelkowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de rolagem horizontal. Valores negativos rolam para a esquerda; 0 para. Só fica contínuo em texturas que se repetem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость прокрутки по горизонтали. Отрицательные значения — влево, 0 — остановка. Бесшовно выглядит только на повторяющихся текстурах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatay kaydırma hızı. Negatif değer sola kaydırır, 0 durdurur. Yalnızca döşenebilir dokularda kesintisiz görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкість горизонтальної прокрутки. Відʼємні значення прокручують ліворуч, 0 зупиняє. Безшовно виглядає лише на текстурах, що повторюються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平滚动速度。负值向左滚动，0 为停止。仅在可平铺的纹理上看起来无缝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平捲動速度。負值向左捲動，0 為停止。僅在可拼貼的紋理上看起來無縫。"
          }
        }
      }
    },
