          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli özellikleri ve sahne düzenlemelerini kaydeder. Aynı adlı hazır ayar değiştirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
