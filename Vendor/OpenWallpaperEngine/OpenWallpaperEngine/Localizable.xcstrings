          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cena precisa dos recursos do Wallpaper Engine da sua cópia Steam. Configure-os em Ajustes › Recursos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой сцене нужны ресурсы Wallpaper Engine из вашей копии в Steam. Настройте их в разделе «Настройки» › «Ресурсы»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sahne Steam kopyanızdaki Wallpaper Engine varlıklarına ihtiyaç duyar. Bunları Ayarlar › Varlıklar’da ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цій сцені потрібні ресурси Wallpaper Engine з вашої копії в Steam. Налаштуйте їх у розділі «Параметри» › «Ресурси»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
