    "The screen saver can play only MP4, M4V or MOV video files in your library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لشاشة التوقف تشغيل ملفات الفيديو بتنسيق MP4 أو M4V أو MOV الموجودة في مكتبتك فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirmschoner kann nur MP4-, M4V- oder MOV-Videodateien aus Ihrer Mediathek abspielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El salvapantallas solo puede reproducir archivos de vídeo MP4, M4V o MOV de tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’économiseur d’écran ne peut lire que les fichiers vidéo MP4, M4V ou MOV de votre bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन सेवर आपकी लाइब्रेरी की केवल MP4, M4V या MOV वीडियो फ़ाइलें चला सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salvaschermo può riprodurre solo file video MP4, M4V o MOV della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンセーバで再生できるのは、ライブラリ内のMP4、M4V、MOVビデオファイルだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 보호기는 보관함의 MP4, M4V 또는 MOV 비디오 파일만 재생할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygaszacz ekranu może odtwarzać tylko pliki wideo MP4, M4V lub MOV z Twojej biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O protetor de tela só pode reproduzir arquivos de vídeo MP4, M4V ou MOV da sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заставка может воспроизводить только видеофайлы MP4, M4V или MOV из вашей библиотеки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran koruyucu yalnızca arşivinizdeki MP4, M4V veya MOV video dosyalarını oynatabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заставка може відтворювати лише відеофайли MP4, M4V або MOV з вашої бібліотеки."
          }
        },
        "zh-Hans" : {
