            "value" : "URL должен заканчиваться поддерживаемым расширением изображения или видео."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, desteklenen bir görüntü veya video uzantısıyla bitmelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-адреса має закінчуватися підтримуваним розширенням зображення чи відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 必须以受支持的图像或视频扩展名结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 必須以支援的影像或影片副檔名結尾。"
          }
        }
      }
    },
    "The Wallpaper Editor can’t open “%@”." : {
