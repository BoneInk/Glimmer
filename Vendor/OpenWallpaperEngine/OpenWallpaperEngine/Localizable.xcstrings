    },
    "Finds the most common color in the wallpaper's picture. Otherwise a wallpaper without a scheme color leaves everything as it is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجد اللون الأكثر شيوعًا في صورة الخلفية. وإلا فإن الخلفية التي ليس لها لون مخطط تترك كل شيء كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermittelt die häufigste Farbe im Bild des Hintergrundbilds. Sonst lässt ein Hintergrundbild ohne Schemafarbe alles, wie es ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca el color más frecuente en la imagen del fondo de pantalla. Si no, un fondo sin color de esquema deja todo como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve la couleur la plus fréquente dans l’image du fond d’écran. Sinon, un fond d’écran sans couleur de schéma laisse tout tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर के चित्र में सबसे आम रंग ढूँढ़ता है। वरना बिना स्कीम रंग वाला वॉलपेपर सब कुछ जैसा है वैसा छोड़ देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova il colore più frequente nell’immagine dello sfondo. Altrimenti uno sfondo senza colore dello schema lascia tutto com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙の画像で最も多い色を見つけます。オフの場合、スキームカラーのない壁紙では何も変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 이미지에서 가장 흔한 색을 찾습니다. 그렇지 않으면 스킴 색상이 없는 배경화면은 아무것도 바꾸지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduje najczęstszy kolor na obrazie tapety. W przeciwnym razie tapeta bez koloru schematu niczego nie zmienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra a cor mais comum na imagem do papel de parede. Caso contrário, um papel de parede sem cor de esquema deixa tudo como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находит самый частый цвет на изображении обоев. Иначе обои без цвета схемы ничего не меняют."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kâğıdının resmindeki en yaygın rengi bulur. Aksi hâlde şema rengi olmayan bir duvar kâğıdı hiçbir şeyi değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаходить найпоширеніший колір на зображенні шпалер. Інакше шпалери без кольору схеми нічого не змінюють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出墙纸图片中最常见的颜色。否则，没有配色的墙纸不会更改任何设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出背景圖片中最常見的顏色。否則，沒有配色的背景圖片不會更改任何設定。"
          }
        }
      }
    },
