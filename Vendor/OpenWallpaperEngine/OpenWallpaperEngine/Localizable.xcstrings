    "Assign a different wallpaper to each screen, or mirror one across all of them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن خلفية مختلفة لكل شاشة، أو اعرض خلفية واحدة على جميع الشاشات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weisen Sie jedem Bildschirm ein eigenes Hintergrundbild zu oder spiegeln Sie eines auf alle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna un fondo de pantalla distinto a cada pantalla o duplica uno en todas ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attribuez un fond d’écran différent à chaque écran, ou affichez le même sur tous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर स्क्रीन को अलग वॉलपेपर असाइन करें, या एक ही वॉलपेपर सभी स्क्रीन पर मिरर करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna uno sfondo diverso a ogni schermo o duplicane uno su tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面ごとに異なる壁紙を割り当てることも、1つの壁紙をすべての画面にミラーリングすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면마다 다른 배경화면을 지정하거나 하나의 배경화면을 모든 화면에 미러링할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypisz inną tapetę do każdego ekranu lub powiel jedną na wszystkich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atribua uma imagem de fundo diferente a cada tela ou espelhe uma só em todas elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначьте каждому экрану свои обои или повторите одни и те же на всех."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ekrana farklı bir duvar kâğıdı atayın veya birini tüm ekranlarda yansıtın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призначайте окрему шпалеру кожному екрану або дзеркально відображайте одну на всіх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个屏幕分配不同的墙纸，或在所有屏幕上镜像同一张墙纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每個螢幕指定不同的背景圖片，或在所有螢幕上鏡像同一張。"
          }
        }
      }
    },
    "At least one display must be the source display and cannot be flipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون شاشة عرض واحدة على الأقل هي المصدر، ولا يمكن قلبها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Display muss als Quelle dienen und kann nicht gespiegelt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos una pantalla tiene que ser la de origen y no se puede girar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins un moniteur doit être l’affichage source et ne peut pas être retourné."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम एक डिस्प्ले स्रोत डिस्प्ले होना चाहिए और उसे फ़्लिप नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno uno schermo deve essere quello di origine e non può essere capovolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つ以上のディスプレイがソースディスプレイである必要があり、そのディスプレイは反転できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적어도 하나의 디스플레이는 원본 디스플레이여야 하며 반전할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przynajmniej jeden wyświetlacz musi być źródłowy i nie można go obrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos uma tela deve ser a tela de origem, que não pode ser virada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотя бы один дисплей должен быть исходным, и его нельзя отразить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az bir ekran kaynak ekran olmalıdır ve ters çevrilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоча б один дисплей має бути джерелом, і його не можна віддзеркалити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少要有一个显示器充当源显示器，且它不能被翻转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少有一個顯示器必須是來源顯示器，且不可翻轉。"
          }
        }
      }
    },
