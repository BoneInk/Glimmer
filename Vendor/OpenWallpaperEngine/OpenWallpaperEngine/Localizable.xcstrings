          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi dal pannello Workshop per scaricarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードするには「ワークショップ」タブでログインしてください。"
