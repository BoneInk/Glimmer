    "Undo every change made to this wallpaper in Scene Edit / Export" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التراجع عن كل تغيير أُجري على هذه الخلفية في نافذة «تحرير/تصدير المشهد»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Änderungen an diesem Hintergrundbild im Fenster „Szene bearbeiten/exportieren“ widerrufen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshace todos los cambios hechos en este fondo en la ventana «Editar/exportar escena»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler toutes les modifications apportées à ce fond d’écran dans la fenêtre « Modifier/exporter la scène »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“सीन एडिट/एक्सपोर्ट” में इस वॉलपेपर में किए गए हर बदलाव को पहले जैसा करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla ogni modifica fatta a questo sfondo nella finestra “Modifica/esporta scena”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「シーン編集/書き出し」でこの壁紙に加えた変更をすべて取り消します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘장면 편집/내보내기’에서 이 배경화면에 한 모든 변경 사항을 취소합니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cofnij wszystkie zmiany tej tapety wprowadzone w oknie „Edycja/eksport sceny”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfaz todas as alterações feitas neste papel de parede na janela “Editar/Exportar Cena”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить все изменения этих обоев, сделанные в окне «Правка/экспорт сцены»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu duvar kâğıdında “Sahne Düzenle/Dışa Aktar” penceresinde yapılan tüm değişiklikleri geri alır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скасувати всі зміни цих шпалер, зроблені у вікні «Редагування/експорт сцени»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销在“场景编辑/导出”中对此墙纸所做的所有更改"
          }
