    "Shifts parts of the image by a depth map so it looks three-dimensional as the pointer moves." : {
      "comment" : "Scene Edit / Export tooltip for the depthparallax effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيح أجزاء الصورة وفق خريطة عمق فتبدو ثلاثية الأبعاد مع تحرك المؤشر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt Bildteile anhand einer Tiefenkarte, sodass das Bild bei Zeigerbewegungen dreidimensional wirkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza partes de la imagen según un mapa de profundidad para que parezca tridimensional al mover el puntero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décale des parties de l’image selon une carte de profondeur pour lui donner du relief lorsque le pointeur se déplace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेप्थ मैप के अनुसार इमेज के हिस्सों को खिसकाता है, ताकि पॉइंटर के हिलने पर वह त्रि-आयामी दिखे."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta parti dell’immagine in base a una mappa di profondità, così sembra tridimensionale quando il puntatore si muove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デプスマップに基づいて画像の各部分をずらし、ポインタの移動に合わせて立体的に見せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깊이 맵에 따라 이미지의 일부를 이동시켜 포인터가 움직일 때 입체적으로 보이게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa części obrazu według mapy głębi, aby przy ruchu wskaźnika wyglądał trójwymiarowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca partes da imagem com base em um mapa de profundidade para que ela pareça tridimensional quando o ponteiro se move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвигает части изображения по карте глубины, чтобы оно выглядело объёмным при движении указателя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntünün bölümlerini bir derinlik haritasına göre kaydırarak imleç hareket ettikçe üç boyutlu görünmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсуває частини зображення за картою глибини, щоб воно здавалося тривимірним, коли рухається вказівник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据深度图移动图像的各个部分，使其在指针移动时呈现立体感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依深度圖移動影像的各部分，讓影像在指標移動時呈現立體感。"
          }
        }
      }
    },
