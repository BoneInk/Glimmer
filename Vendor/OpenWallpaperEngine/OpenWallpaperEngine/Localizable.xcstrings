          }
        }
      }
    },
    "Moves the layer against the pointer so it appears to sit at a different depth." : {
      "comment" : "Scene Edit / Export tooltip for the parallax effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحرّك الطبقة عكس اتجاه المؤشر فتبدو كأنها على عمق مختلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Ebene gegen den Zeiger, sodass sie in einer anderen Tiefe zu liegen scheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la capa en sentido contrario al puntero para que parezca estar a otra profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace le calque à l’opposé du pointeur pour qu’il semble situé à une autre profondeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर को पॉइंटर के विपरीत खिसकाता है, ताकि वह अलग डेप्थ पर दिखे."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il livello in direzione opposta al puntatore, così sembra trovarsi a una profondità diversa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタと逆方向にレイヤーを動かし、異なる奥行きにあるように見せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어를 포인터 반대 방향으로 움직여 다른 깊이에 있는 것처럼 보이게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa warstwę przeciwnie do wskaźnika, aby wydawała się leżeć na innej głębokości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move a camada em sentido oposto ao ponteiro para que pareça estar em outra profundidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвигает слой в сторону, противоположную указателю, чтобы он казался на другой глубине."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katmanı imlece karşı hareket ettirerek farklı bir derinlikte duruyormuş gibi görünmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсуває шар назустріч вказівнику, щоб здавалося, ніби він розташований на іншій глибині."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使图层逆着指针移动，看起来像位于不同的深度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓圖層相對指標移動，使其看起來位於不同的深度。"
          }
        }
      }
    },
    "Moves, zooms or mirrors the wallpaper on the selected displays, after its placement. Each display keeps its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل الخلفية أو يكبّرها أو يقلبها على شاشات العرض المحددة، بعد ترتيبها. تحتفظ كل شاشة عرض بقيمها الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt, zoomt oder spiegelt das Hintergrundbild auf den ausgewählten Bildschirmen, nach seiner Anordnung. Jeder Bildschirm behält seine eigenen Werte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve, amplía o refleja el fondo de pantalla en las pantallas seleccionadas, después de su colocación. Cada pantalla conserva los suyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace, agrandit ou inverse le fond d’écran sur les moniteurs sélectionnés, après sa disposition. Chaque moniteur garde les siens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने गए डिस्प्ले पर वॉलपेपर को उसकी प्लेसमेंट के बाद खिसकाता, ज़ूम करता या उलटता है। हर डिस्प्ले अपनी सेटिंग रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta, ingrandisce o riflette lo sfondo sui monitor selezionati, dopo la sua disposizione. Ogni monitor mantiene i propri valori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したディスプレイで、配置のあとに壁紙を移動、拡大縮小、または反転します。ディスプレイごとに個別に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 디스플레이에서 배치 후 배경화면을 이동, 확대/축소 또는 반전합니다. 디스플레이마다 따로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa, powiększa lub odbija tapetę na wybranych monitorach, po jej rozmieszczeniu. Każdy monitor zachowuje własne wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move, amplia ou espelha a imagem de fundo nas telas selecionadas, após o posicionamento. Cada tela mantém os próprios valores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвигает, масштабирует или отражает обои на выбранных мониторах после их размещения. У каждого монитора свои значения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili ekranlarda duvar kâğıdını yerleşiminden sonra taşır, yakınlaştırır veya çevirir. Her ekran kendi değerlerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсуває, масштабує або віддзеркалює шпалери на вибраних моніторах після їх розміщення. Кожен монітор зберігає свої значення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所选显示器上按排列方式放置后，移动、缩放或翻转墙纸。每个显示器各自保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所選顯示器上依排列方式放置後，移動、縮放或翻轉背景圖片。每個顯示器各自保留。"
          }
        }
      }
    },
