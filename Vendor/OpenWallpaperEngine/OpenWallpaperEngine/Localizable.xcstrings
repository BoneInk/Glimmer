        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आस्पेक्ट रेशियो अलग होने पर वॉलपेपर स्क्रीन पर कैसे फ़िट किया जाता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come lo sfondo viene adattato allo schermo quando le proporzioni sono diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙の縦横比が画面と異なる場合に、壁紙を画面に合わせる方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면비가 다를 때 배경화면을 화면에 맞추는 방식입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposób dopasowania tapety do ekranu, gdy proporcje się różnią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a imagem de fundo é ajustada à tela quando a proporção é diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как обои вписываются в экран, если соотношение сторон отличается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En boy oranı farklı olduğunda duvar kâğıdının ekrana nasıl yerleştirileceği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як шпалера припасовується до екрана, коли співвідношення сторін відрізняється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墙纸宽高比与屏幕不同时，墙纸适配屏幕的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景圖片的長寬比與螢幕不同時，如何調整以符合螢幕。"
          }
        }
      }
    },
    "How thick the fog is. Small changes read strongly — start low." : {
      "comment" : "Scene Edit / Export tooltip for the volumetricfog effect's density parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثافة الضباب. للتغييرات الصغيرة أثر واضح — ابدأ بقيمة منخفضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie dicht der Nebel ist. Kleine Änderungen wirken stark – beginnen Sie niedrig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidad de la niebla. Los cambios pequeños se notan mucho: empieza con valores bajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épaisseur du brouillard. De petits changements se voient beaucoup — commencez bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोहरा कितना घना है. छोटे बदलाव भी साफ़ दिखते हैं — कम मान से शुरू करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spessore della nebbia. Anche piccole modifiche si notano molto: inizia con valori bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォグの濃さです。わずかな変更でも強く表れるため、低い値から始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안개의 짙은 정도입니다. 작은 변화도 크게 보이므로 낮은 값부터 시작하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gęstość mgły. Nawet małe zmiany są wyraźne — zacznij od niskiej wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A espessura da névoa. Pequenas mudanças são bem perceptíveis — comece com valores baixos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плотность тумана. Даже небольшие изменения заметны — начинайте с малых значений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisin ne kadar yoğun olduğu. Küçük değişiklikler belirgin görünür — düşük bir değerle başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки густий туман. Навіть малі зміни помітні — починайте з малого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雾的浓度。微小的改变也很明显——请从低值开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "霧的濃度。些微變化就很明顯——請從低值開始。"
          }
        }
      }
    },
