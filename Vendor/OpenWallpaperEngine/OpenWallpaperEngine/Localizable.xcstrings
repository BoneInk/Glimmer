    "Puts every setting back to a new playlist's." : {
      "comment" : "Help of Playlist Settings' Reset button",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد كل إعداد إلى ما تكون عليه قائمة تشغيل جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt alle Einstellungen auf die einer neuen Playlist zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve todos los ajustes a los de una playlist nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit tous les réglages d’une nouvelle playlist."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सेटिंग को नई प्लेलिस्ट जैसी कर देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
