    "Lower quality makes a smaller movie." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجودة الأقل تنتج فيلمًا أصغر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine geringere Qualität ergibt einen kleineren Film."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una calidad menor genera un vídeo más pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une qualité plus faible produit une vidéo plus petite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम क्वालिटी से मूवी छोटी बनती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una qualità inferiore produce un filmato più piccolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "品質を下げるとムービーが小さくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화질을 낮추면 동영상이 작아집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niższa jakość daje mniejszy film."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma qualidade menor gera um vídeo menor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем ниже качество, тем меньше видео."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha düşük kalite daha küçük bir film oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижча якість дає менше відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质量越低，影片越小。"
          }
