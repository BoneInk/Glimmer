            "value" : "Die Playlist „%@“ verwendet diesen Kurzbefehl. „Trotzdem verwenden“ überträgt ihn auf diese Playlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist «%@» usa esta función rápida. «Usar de todos modos» la pasa a esta playlist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist « %@ » utilise ce raccourci. « Utiliser quand même » le déplace vers cette playlist."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेलिस्ट “%@” यह शॉर्टकट इस्तेमाल करती है। “फिर भी इस्तेमाल करें” इसे इस प्लेलिस्ट पर ले आता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist “%@” usa questa abbreviazione. “Usa comunque” la sposta su questa playlist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリスト「%@」がこのショートカットを使用しています。「このまま使用」を選ぶと、このプレイリストに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 플레이리스트가 이 단축키를 사용합니다. ‘그래도 사용’을 선택하면 이 플레이리스트로 옮겨집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
