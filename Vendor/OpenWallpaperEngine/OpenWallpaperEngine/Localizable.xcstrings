    "Removes the downloaded assets, and optionally the default wallpapers, to free disk space. Scenes won't render until you install them again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل الموارد المُنزَّلة، والخلفيات الافتراضية إن أردت، لتحرير مساحة القرص. ولن تُعرض المشاهد حتى تثبّتها مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die geladenen Assets und auf Wunsch die Standard-Hintergrundbilder, um Speicherplatz freizugeben. Szenen werden erst wieder dargestellt, wenn Sie die Assets erneut installieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los recursos descargados y, si quieres, los fondos de pantalla predeterminados, para liberar espacio en disco. Las escenas no se mostrarán hasta que vuelvas a instalarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les ressources téléchargées, et éventuellement les fonds d’écran par défaut, pour libérer de l’espace disque. Les scènes ne s’afficheront plus tant que vous ne les aurez pas réinstallées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क स्पेस खाली करने के लिए डाउनलोड किए गए ऐसेट, और चाहें तो डिफ़ॉल्ट वॉलपेपर, हटाता है। दोबारा इंस्टॉल करने तक सीन रेंडर नहीं होंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le risorse scaricate e, se vuoi, gli sfondi predefiniti, per liberare spazio su disco. Le scene non verranno visualizzate finché non le reinstalli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアセットと、必要に応じてデフォルトの壁紙を削除し、ディスク容量を空けます。再インストールするまでシーンは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 에셋과 원하는 경우 기본 배경화면을 제거해 디스크 공간을 확보합니다. 다시 설치할 때까지 장면이 표시되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa pobrane zasoby oraz opcjonalnie domyślne tapety, aby zwolnić miejsce na dysku. Sceny nie będą wyświetlane, dopóki ponownie ich nie zainstalujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove os recursos baixados e, se quiser, as imagens de fundo padrão, para liberar espaço em disco. As cenas não serão exibidas até você instalá-los novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет загруженные ресурсы и, по желанию, стандартные обои, чтобы освободить место на диске. Сцены не будут отображаться, пока вы снова не установите ресурсы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk alanı açmak için indirilen varlıkları ve isteğe bağlı olarak varsayılan duvar kâğıtlarını siler. Yeniden yükleyene kadar sahneler görüntülenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучає викачані ресурси та, за бажанням, стандартні шпалери, щоб звільнити місце на диску. Сцени не відображатимуться, доки ви знову їх не встановите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除已下载的资源，并可选择移除默认墙纸，以释放磁盘空间。在你重新安装之前，场景将无法显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除已下載的資源，並可選擇移除預設背景圖片，以釋放磁碟空間。在你重新安裝之前，場景將無法顯示。"
          }
        }
      }
    },
    "Removes the finished downloads from this list. They stay in your library." : {
      "comment" : "Tooltip of Clear Completed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل التنزيلات المكتملة من هذه القائمة. تبقى في مكتبتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die abgeschlossenen Downloads aus dieser Liste. Sie bleiben in Ihrer Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita las descargas terminadas de esta lista. Siguen en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire les téléchargements terminés de cette liste. Ils restent dans votre bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे हुए डाउनलोड इस सूची से हटाता है। वे आपकी लाइब्रेरी में रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove i download completati da questo elenco. Restano nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了したダウンロードをこのリストから取り除きます。ライブラリには残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료된 다운로드를 이 목록에서 제거합니다. 보관함에는 그대로 남습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa ukończone pobierania z tej listy. Pozostają w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove os downloads concluídos desta lista. Eles continuam na sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает завершенные загрузки из этого списка. В медиатеке они остаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamlanan indirmeleri bu listeden kaldırır. Arşivinizde kalırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибирає завершені викачування з цього списку. У бібліотеці вони лишаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此列表中移除已完成的下载。它们仍保留在资源库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從此列表移除已完成的下載項目。它們仍會保留在資料庫中。"
          }
        }
      }
    },
    "Removes the folder from the library. Its wallpapers stay on disk." : {
