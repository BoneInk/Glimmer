            "state" : "translated",
            "value" : "画像のピクセルを読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지의 픽셀을 읽을 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać pikseli obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
