    "Pick more wallpapers from your library and export them as .mpkg packages with this device, output, quality and frame rate" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مزيدًا من الخلفيات من مكتبتك وصدّرها كحزم ‎.mpkg بهذا الجهاز والإخراج والجودة ومعدل الإطارات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Hintergrundbilder aus Ihrer Mediathek auswählen und mit diesem Gerät, dieser Ausgabe, Qualität und Bildrate als MPKG-Pakete exportieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige más fondos de tu biblioteca y expórtalos como paquetes .mpkg con este dispositivo, esta salida, esta calidad y esta frecuencia de fotogramas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir d’autres fonds d’écran dans votre bibliothèque et les exporter en paquets .mpkg avec cet appareil, cette sortie, cette qualité et cette fréquence d’images"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी लाइब्रेरी से और वॉलपेपर चुनें और उन्हें इस डिवाइस, आउटपुट, क्वालिटी और फ़्रेम रेट के साथ .mpkg पैकेज के रूप में एक्सपोर्ट करें"
          }
        },
