    "Midtone brightness curve. 1 leaves the layer unchanged." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like gamma",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منحنى سطوع الدرجات المتوسطة. 1 يترك الطبقة دون تغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeitskurve der Mitteltöne. 1 lässt die Ebene unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva de brillo de los tonos medios. 1 deja la capa sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courbe de luminosité des tons moyens. 1 laisse le calque inchangé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिडटोन ब्राइटनेस कर्व. 1 लेयर को अपरिवर्तित छोड़ता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva di luminosità dei mezzitoni. 1 lascia invariato il livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中間調の明るさカーブです。1ではレイヤーは変化しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중간 톤 밝기 곡선입니다. 1이면 레이어가 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krzywa jasności półtonów. 1 pozostawia warstwę bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva de brilho dos tons médios. 1 deixa a camada inalterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кривая яркости средних тонов. 1 оставляет слой без изменений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orta ton parlaklık eğrisi. 1 katmanı değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крива яскравості середніх тонів. 1 залишає шар незмінним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中间调亮度曲线。1 表示图层保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中間調亮度曲線。1 維持圖層不變。"
          }
        }
      }
    },
