    "Properties are synced across displays, so every display showing it is reset." : {
      "comment" : "Reset confirmation, when one set of properties serves every display",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخصائص متزامنة عبر شاشات العرض، لذا تتم إعادة تعيين كل شاشة عرض تعرضها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Eigenschaften werden über Displays synchronisiert, daher wird jedes Display zurückgesetzt, das es zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las propiedades se sincronizan entre pantallas, así que se restablece en todas las pantallas que lo muestran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les propriétés sont synchronisées entre les moniteurs : tous les moniteurs qui l’affichent sont réinitialisés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रॉपर्टी सभी डिस्प्ले पर सिंक हैं, इसलिए इसे दिखाने वाला हर डिस्प्ले रीसेट होगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le proprietà sono sincronizzate tra gli schermi, quindi vengono ripristinate su ogni schermo che lo mostra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティはディスプレイ間で同期されているため、この壁紙を表示しているすべてのディスプレイがリセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성이 디스플레이 간에 동기화되어 있으므로 이 배경화면을 표시하는 모든 디스플레이가 재설정됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Właściwości są synchronizowane między wyświetlaczami, więc zostaną zresetowane na każdym wyświetlaczu, który ją pokazuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As propriedades estão sincronizadas entre as telas, então todas as telas que a mostram serão redefinidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свойства синхронизируются между дисплеями, поэтому они будут сброшены на всех дисплеях, где показаны эти обои."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özellikler ekranlar arasında eşitlendiğinden bunu gösteren her ekran sıfırlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Властивості синхронізуються між дисплеями, тому їх буде скинуто на всіх дисплеях, де показано цю шпалеру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "属性已在显示器之间同步，因此显示它的每个显示器都会被重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屬性已在所有顯示器間同步，因此顯示它的每個顯示器都會重置。"
          }
        }
      }
    },
