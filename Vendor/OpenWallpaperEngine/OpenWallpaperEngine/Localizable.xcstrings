    "Wallpapers don't see what a blocked app plays: no title, artist or album cover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ترى الخلفيات ما يشغّله التطبيق المحظور: لا عنوان ولا فنان ولا غلاف ألبوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundbilder sehen nicht, was eine blockierte App abspielt: keinen Titel, Interpreten oder Albumcover."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fondos de pantalla no ven lo que reproduce una app bloqueada: ni título, ni artista, ni portada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonds d’écran ne voient pas ce que lit une app bloquée : ni titre, ni artiste, ni pochette."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर यह नहीं देखते कि ब्लॉक की गई ऐप क्या चला रही है: न शीर्षक, न कलाकार, न एल्बम कवर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli sfondi non vedono cosa riproduce un’app bloccata: niente titolo, artista o copertina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックしたアプリが再生している内容は壁紙に伝わりません（タイトル、アーティスト、アルバムアートワークのいずれも）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면은 차단된 앱이 재생하는 항목을 볼 수 없습니다. 제목, 아티스트, 앨범 커버 모두 표시되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapety nie widzą, co odtwarza zablokowana aplikacja: ani tytułu, ani wykonawcy, ani okładki albumu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens de fundo não veem o que um app bloqueado reproduz: nem título, nem artista, nem capa do álbum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обои не видят, что воспроизводит заблокированное приложение: ни названия, ни исполнителя, ни обложки альбома."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kâğıtları engellenen bir uygulamanın çaldığını görmez: başlık, sanatçı veya albüm kapağı yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шпалери не бачать, що відтворює заблокована програма: ні назви, ні виконавця, ні обкладинки альбому."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墙纸看不到被阻止的 App 正在播放的内容：没有标题、艺人或专辑封面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景圖片看不到被封鎖的 App 正在播放的內容：沒有標題、演出者或專輯封面。"
          }
        }
      }
    },
