    "Spacing between bars, as a fraction of their width." : {
      "comment" : "Scene Edit / Export tooltip for the audiobars effect's gap parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسافة بين الأشرطة، كنسبة من عرضها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand zwischen den Balken als Anteil ihrer Breite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio entre barras, como fracción de su anchura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacement entre les barres, en fraction de leur largeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार के बीच की दूरी, उनकी चौड़ाई के अंश के रूप में."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio tra le barre, come frazione della loro larghezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーの間隔です。バーの幅に対する比率で指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "막대 사이의 간격으로, 막대 너비에 대한 비율로 나타냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstęp między słupkami jako ułamek ich szerokości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaçamento entre as barras, como fração da largura delas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промежуток между полосами в долях их ширины."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuklar arasındaki boşluk, çubuk genişliğinin oranı olarak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстань між смугами як частка їхньої ширини."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
