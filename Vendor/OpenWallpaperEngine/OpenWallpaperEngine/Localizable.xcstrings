    "Plays the wallpapers' own sound. Off silences every wallpaper." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل صوت الخلفيات نفسها. وعند الإيقاف، تُكتم كل الخلفيات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt den eigenen Ton der Hintergrundbilder wieder. Aus schaltet alle Hintergrundbilder stumm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el sonido propio de los fondos de pantalla. Desactivado silencia todos los fondos de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le son propre des fonds d’écran. Désactivé coupe le son de tous les fonds d’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर की अपनी आवाज़ चलाता है। बंद होने पर सभी वॉलपेपर म्यूट हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce l’audio degli sfondi. Disattivato silenzia tutti gli sfondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙自体のサウンドを再生します。オフにするとすべての壁紙が消音されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 자체의 소리를 재생합니다. 끄면 모든 배경화면이 음소거됩니다."
          }
        },
        "pl" : {
