    "Hides this wallpaper from the Workshop and Discover tabs on this Mac. Settings › Assets lists what you blocked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي هذه الخلفية من علامتي التبويب «الورشة» و«استكشف» على هذا الـ Mac. تعرض الإعدادات › الموارد ما حظرته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet dieses Hintergrundbild auf diesem Mac in den Tabs „Workshop“ und „Entdecken“ aus. Unter „Einstellungen“ › „Assets“ finden Sie, was Sie blockiert haben."
          }
        },
        "es" : {
          "stringUnit" : {
