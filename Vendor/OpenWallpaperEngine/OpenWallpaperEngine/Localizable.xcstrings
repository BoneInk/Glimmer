            "value" : "Найближчий акцент Apple"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最接近的 Apple 强调色"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
