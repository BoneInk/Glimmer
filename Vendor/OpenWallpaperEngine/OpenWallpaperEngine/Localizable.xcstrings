    "Pressing the hotkey in any app loads this profile on your displays." : {
      "comment" : "Assign Hotkey dialog for a display profile",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الضغط على الاختصار في أي تطبيق إلى تحميل هذا الملف الشخصي على شاشات العرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Tastenkombination in einer beliebigen App drücken, wird dieses Profil auf Ihren Displays geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pulsar la tecla de acceso rápido en cualquier app, este perfil se carga en tus pantallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyer sur le raccourci dans n’importe quelle app charge ce profil sur vos moniteurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ऐप में हॉटकी दबाने पर यह प्रोफ़ाइल आपके डिस्प्ले पर लोड हो जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premendo il tasto di scelta rapida in qualsiasi app, questo profilo viene caricato sui tuoi schermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリでもホットキーを押すと、このプロファイルがディスプレイに読み込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱에서든 단축키를 누르면 이 프로필이 디스플레이에 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnięcie klawisza dostępu w dowolnej aplikacji wczytuje ten profil na wyświetlacze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressionar o atalho em qualquer app carrega este perfil nas suas telas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие горячей клавиши в любом приложении загружает этот профиль на дисплеи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşuna herhangi bir uygulamada basmak bu profili ekranlarınıza yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натискання гарячої клавіші в будь-якій програмі завантажує цей профіль на дисплеї."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按下此热键，都会将此配置文件载入到你的显示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按下此快速鍵，都會將此設定檔載入到你的顯示器。"
          }
        }
      }
    },
    "Pressing the hotkey in any app sets this wallpaper on “%@”, the display it was assigned on." : {
      "comment" : "Assign Hotkey dialog for a wallpaper; the display's name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الضغط على الاختصار في أي تطبيق إلى تعيين هذه الخلفية على ”%@“، شاشة العرض التي عُيّن عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Tastenkombination in einer beliebigen App drücken, wird dieses Hintergrundbild auf „%@“ festgelegt, dem Display, auf dem sie zugewiesen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pulsar la tecla de acceso rápido en cualquier app, este fondo de pantalla se pone en «%@», la pantalla en la que se asignó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyer sur le raccourci dans n’importe quelle app place ce fond d’écran sur « %@ », le moniteur sur lequel il a été attribué."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ऐप में हॉटकी दबाने पर यह वॉलपेपर “%@” पर लग जाता है, जिस डिस्प्ले पर इसे दिया गया था।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premendo il tasto di scelta rapida in qualsiasi app, questo sfondo viene impostato su “%@”, lo schermo su cui è stato assegnato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリでもホットキーを押すと、割り当てたディスプレイ「%@」にこの壁紙が設定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱에서든 단축키를 누르면 지정한 디스플레이인 ‘%@’에 이 배경화면이 설정됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnięcie klawisza dostępu w dowolnej aplikacji ustawia tę tapetę na „%@”, wyświetlaczu, na którym go przypisano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressionar o atalho em qualquer app define este papel de parede em “%@”, a tela em que ele foi atribuído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие горячей клавиши в любом приложении ставит эти обои на «%@» — дисплей, на котором она назначена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşuna herhangi bir uygulamada basmak, bu duvar kâğıdını atandığı ekran olan “%@” üzerine ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натискання гарячої клавіші в будь-якій програмі ставить ці шпалери на «%@» — дисплей, на якому її призначено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按下此热键，都会将此墙纸设置到指定它时所在的显示器“%@”上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按下此快速鍵，都會將此背景圖片設定到指定時所在的顯示器「%@」上。"
          }
        }
      }
    },
