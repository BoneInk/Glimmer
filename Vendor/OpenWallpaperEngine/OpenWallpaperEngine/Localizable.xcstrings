            "state" : "translated",
            "value" : "Arrastra el punto hasta donde se detiene el puntero sobre el fondo de pantalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le point là où le pointeur repose sur le fond d’écran"
