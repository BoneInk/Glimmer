    "The image’s pixels can’t be read." : {
      "comment" : "Wallpaper Editor importer: an image couldn't be turned into a texture",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعذّر قراءة وحدات بكسل الصورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pixel des Bildes können nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer los píxeles de la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les pixels de l’image."
          }
        },
        "hi" : {
