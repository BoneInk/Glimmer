        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список відтворення «%@» використовує це скорочення. «Усе одно використати» переносить його на цей список відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
