        }
      }
    },
    "Adds moving film grain. Keep the amount low or it swamps darker scenes." : {
      "comment" : "Scene Edit / Export tooltip for the filmgrain effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف حبيبات فيلم متحركة. أبقِ المقدار منخفضًا وإلا طغت على المشاهد الداكنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt bewegtes Filmkorn hinzu. Halten Sie die Stärke niedrig, sonst überdeckt es dunklere Szenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade grano de película en movimiento. Usa una cantidad baja o saturará las escenas más oscuras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un grain de film animé. Gardez une quantité faible, sinon il envahit les scènes sombres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलता हुआ फ़िल्म ग्रेन जोड़ता है. मात्रा कम रखें, वरना गहरे सीन इससे भर जाते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una grana da pellicola in movimento. Tieni bassa la quantità o sommergerà le scene più scure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動くフィルムグレインを加えます。量を少なめにしないと、暗いシーンが埋もれてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직이는 필름 그레인을 추가합니다. 양을 낮게 유지하지 않으면 어두운 장면이 묻힙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje ruchome ziarno filmowe. Utrzymuj niską ilość, bo inaczej przytłoczy ciemniejsze sceny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona granulação de filme em movimento. Mantenha a quantidade baixa, ou ela encobre as cenas mais escuras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет движущееся зерно плёнки. Держите значение низким, иначе оно забьёт тёмные сцены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareketli film greni ekler. Miktarı düşük tutun, aksi hâlde koyu sahneleri boğar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає рухоме зерно плівки. Тримайте кількість низькою, інакше воно заполонить темніші сцени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加动态胶片颗粒。数量宜低，否则会淹没较暗的场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入動態底片顆粒。數量請保持在低值，否則會淹沒較暗的場景。"
          }
        }
      }
    },
    "Adds scaling with depth so near parts grow as they shift, rather than just sliding." : {
      "comment" : "Scene Edit / Export tooltip for the depthparallax effect's perspective parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف تغييرًا في الحجم حسب العمق بحيث تكبر الأجزاء القريبة أثناء تحركها بدلًا من أن تنزلق فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaliert abhängig von der Tiefe, sodass nahe Teile beim Verschieben größer werden, statt nur zu gleiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade escalado según la profundidad para que las partes cercanas crezcan al desplazarse, en lugar de solo deslizarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une mise à l’échelle selon la profondeur : les parties proches grossissent en se déplaçant au lieu de simplement glisser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेप्थ के साथ स्केलिंग जोड़ता है, ताकि पास के हिस्से केवल खिसकने के बजाय खिसकते हुए बड़े भी हों."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un ridimensionamento in base alla profondità, così le parti vicine si ingrandiscono mentre si spostano invece di scorrere soltanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度に応じた拡大縮小を加え、手前の部分がスライドするだけでなく、移動に合わせて大きくなるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깊이에 따른 크기 변화를 추가하여 가까운 부분이 단순히 미끄러지는 대신 이동하면서 커집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje skalowanie zależne od głębi, dzięki czemu bliższe części podczas ruchu rosną, a nie tylko się przesuwają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona escala conforme a profundidade, para que as partes próximas cresçam ao se deslocar em vez de apenas deslizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет масштабирование с глубиной: ближние части увеличиваются при сдвиге, а не просто скользят."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derinliğe göre ölçekleme ekler; böylece yakındaki bölümler yalnızca kaymak yerine kaydıkça büyür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає масштабування з глибиною, щоб ближчі частини збільшувалися під час зсуву, а не просто ковзали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按深度添加缩放，使近处部分在移动时变大，而不只是平移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依深度加入縮放，讓近處部分在移動時放大，而不只是平移。"
          }
        }
      }
    },
    "Adds tape distortion, colour bleed and scanlines." : {
      "comment" : "Scene Edit / Export tooltip for the vhs effect",
      "localizations" : {
        "ar" : {
