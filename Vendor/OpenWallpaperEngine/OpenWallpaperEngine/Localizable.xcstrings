    "Turn layers on or off in the list on the left. The screen saver keeps these choices for this wallpaper." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الطبقات أو أوقفها من القائمة على اليمين. تحتفظ شاشة التوقف بهذه الاختيارات لهذه الخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebenen in der Liste links ein- oder ausschalten. Der Bildschirmschoner behält diese Auswahl für dieses Hintergrundbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva capas en la lista de la izquierda. El salvapantallas conserva estas opciones para este fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
