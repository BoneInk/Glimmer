          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての設定を新しいプレイリストの設定に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 설정을 새 플레이리스트의 설정으로 되돌립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca wszystkie ustawienia nowej playlisty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna todos os ajustes aos de uma nova playlist."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает все настройки к настройкам нового плейлиста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm ayarları yeni bir çalma listesininkilere döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертає всі налаштування до налаштувань нового списку відтворення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有设置恢复为新播放列表的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有設定還原為新播放列表的設定。"
          }
        }
      }
    },
    "Puts the settings of every tab back to their defaults, Updates included. Your wallpapers and library aren't touched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد إعدادات كل علامات التبويب إلى قيمها الافتراضية، بما فيها «التحديثات». ولا تتأثر خلفياتك ومكتبتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die Einstellungen aller Tabs auf die Standardwerte zurück, auch die von Updates. Ihre Hintergrundbilder und Ihre Mediathek bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece los valores predeterminados de los ajustes de todas las pestañas, incluida Actualizaciones. Tus fondos de pantalla y tu biblioteca no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit les valeurs par défaut des réglages de tous les onglets, y compris Mises à jour. Vos fonds d’écran et votre bibliothèque ne sont pas modifiés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी टैब की सेटिंग्ज़ को डिफ़ॉल्ट पर वापस लाता है, अपडेट समेत। आपके वॉलपेपर और लाइब्रेरी पर असर नहीं पड़ता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina i valori predefiniti delle impostazioni di tutti i pannelli, Aggiornamenti compreso. I tuoi sfondi e la libreria restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アップデート」を含むすべてのタブの設定をデフォルトに戻します。壁紙とライブラリには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트를 포함한 모든 탭의 설정을 기본값으로 되돌립니다. 배경화면과 보관함은 변경되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca domyślne ustawienia wszystkich kart, łącznie z kartą Uaktualnienia. Twoje tapety i biblioteka pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura os padrões dos ajustes de todas as abas, inclusive Atualizações. Suas imagens de fundo e sua biblioteca não são alteradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает настройки всех вкладок, включая «Обновления», к значениям по умолчанию. Обои и медиатека не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeler dahil tüm sekmelerin ayarlarını varsayılanlara döndürür. Duvar kâğıtlarınız ve arşiviniz değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертає типові значення параметрів усіх вкладок, зокрема «Оновлення». Шпалери та бібліотеку не змінено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有标签页的设置（包括“更新”）恢复为默认值。你的墙纸和资料库不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有標籤頁的設定（包括「更新項目」）回復為預設值。你的背景圖片和資料庫不受影響。"
          }
        }
      }
    },
    "Puts your own colors back when Open Wallpaper Engine quits. After a crash they are put back at the next launch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد ألوانك عند إنهاء Open Wallpaper Engine. بعد التعطل تُعاد عند التشغيل التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt deine eigenen Farben wieder her, wenn Open Wallpaper Engine beendet wird. Nach einem Absturz geschieht das beim nächsten Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve tus propios colores al salir de Open Wallpaper Engine. Tras un fallo, se devuelven en el siguiente arranque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit vos propres couleurs quand Open Wallpaper Engine se ferme. Après un plantage, elles sont rétablies au lancement suivant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine बंद होने पर आपके अपने रंग लौटा देता है। क्रैश के बाद वे अगली बार खोलने पर लौटते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina i tuoi colori quando Open Wallpaper Engine si chiude. Dopo un arresto anomalo vengono ripristinati all’avvio successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engineの終了時に元のカラーに戻します。クラッシュした場合は次回の起動時に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine을 종료하면 원래 색상으로 되돌립니다. 충돌 후에는 다음 실행 시 되돌립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywraca Twoje kolory po zakończeniu Open Wallpaper Engine. Po awarii są przywracane przy następnym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolve suas próprias cores quando o Open Wallpaper Engine é encerrado. Após uma falha, elas voltam na próxima abertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает ваши цвета при выходе из Open Wallpaper Engine. После сбоя они возвращаются при следующем запуске."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Wallpaper Engine’den çıkıldığında kendi renklerinizi geri getirir. Çökmeden sonra bir sonraki açılışta geri getirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертає ваші кольори під час виходу з Open Wallpaper Engine. Після збою їх буде повернуто під час наступного запуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出 Open Wallpaper Engine 时恢复你自己的颜色。发生崩溃后，会在下次启动时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束 Open Wallpaper Engine 時還原你自己的顏色。發生當機後，會在下次啟動時還原。"
          }
        }
      }
    },
