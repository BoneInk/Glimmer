        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューコマンド「%@」がこのショートカットを使用しています。「このまま使用」を選ぶとこのプレイリストに割り当てられ、メニューコマンドは反応しなくなります。"
          }
        },
        "ko" : {
