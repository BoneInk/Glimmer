    "If a profile with the same name exists already, it will be overwritten." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هناك ملف شخصي بالاسم نفسه، فسيتم استبداله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Profil mit demselben Namen bereits existiert, wird es überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya existe un perfil con el mismo nombre, se sobrescribirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un profil du même nom existe déjà, il sera remplacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि इसी नाम की प्रोफ़ाइल पहले से मौजूद है, तो वह बदल दी जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esiste già un profilo con lo stesso nome, sarà sovrascritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前のプロファイルが存在する場合、上書きされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 이름의 프로필이 존재하면 덮어쓰기됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeżeli istnieje profil o tej samej nazwie, zostanie on nadpisany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se já existir um perfil com o mesmo nome, ele será substituído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если профиль с таким именем уже существует, он будет перезаписан."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı ada sahip bir profil zaten varsa, üzerine yazılacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо профіль з такою назвою вже існує, його буде перезаписано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已存在相同名称的配置文件，则它将会被覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若有相同名稱的設定檔存在，該設定檔將會被覆寫。"
          }
        }
      }
    },
    "If downloads stop, keep this window open and tap Download again: it resumes." : {
      "comment" : "Send over Wi-Fi sheet: resume tip",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا توقفت التنزيلات، فأبقِ هذه النافذة مفتوحة واضغط على «تنزيل» مرة أخرى: سيُستأنف التنزيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls Downloads stoppen, lassen Sie dieses Fenster geöffnet und tippen Sie erneut auf „Laden“: Der Download wird fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si las descargas se detienen, mantén esta ventana abierta y vuelve a tocar «Descargar»: la descarga se reanuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les téléchargements s’arrêtent, gardez cette fenêtre ouverte et touchez à nouveau « Télécharger » : le téléchargement reprend."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर डाउनलोड रुक जाएँ, तो यह विंडो खुली रखें और फिर से “डाउनलोड करें” पर टैप करें: डाउनलोड वहीं से फिर शुरू हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se i download si interrompono, tieni aperta questa finestra e tocca di nuovo “Scarica”: il download riprende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードが止まった場合は、このウインドウを開いたまま「ダウンロード」をもう一度タップしてください。続きから再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드가 멈추면 이 윈도우를 열어 둔 채로 ‘다운로드’를 다시 탭하십시오. 이어서 다운로드됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli pobieranie się zatrzyma, nie zamykaj tego okna i ponownie stuknij w „Pobierz”: pobieranie zostanie wznowione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se os downloads pararem, mantenha esta janela aberta e toque em Baixar novamente: o download será retomado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если загрузка остановилась, не закрывайте это окно и снова нажмите «Загрузить»: загрузка продолжится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmeler durursa bu pencereyi açık tutun ve İndir’e yeniden dokunun: İndirme kaldığı yerden devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо викачування зупинилося, не закривайте це вікно й знову торкніться «Викачати»: викачування продовжиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果下载停止，请保持此窗口打开并再次轻点“下载”，下载将继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果下載停止，請保持此視窗開啟並再點一下「下載」，下載將會繼續。"
          }
        }
      }
    },
