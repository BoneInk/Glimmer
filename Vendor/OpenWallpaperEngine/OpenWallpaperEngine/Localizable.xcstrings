    "Only Next and Previous change the wallpaper." : {
      "comment" : "Playlist Settings: what Never does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يغيّر الخلفية سوى التالي والسابق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur „Weiter“ und „Zurück“ wechseln das Hintergrundbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo Siguiente y Anterior cambian el fondo de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls Suivant et Précédent changent le fond d’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ अगला और पिछला वॉलपेपर बदलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
