    "Keeps only the outlines in the image." : {
      "comment" : "Scene Edit / Export tooltip for the edgedetection effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي على الخطوط الخارجية فقط في الصورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält nur die Umrisse im Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva solo los contornos de la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne conserve que les contours de l’image."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इमेज में केवल आउटलाइन रखता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene solo i contorni dell’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の輪郭だけを残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지의 윤곽선만 남깁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostawia na obrazie tylko kontury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém apenas os contornos da imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет на изображении только контуры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntüde yalnızca dış hatları korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишає на зображенні лише контури."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保留图像中的轮廓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保留影像中的輪廓。"
          }
        }
      }
    },
    "Keeps the icon in the Dock while no window is open. Off, it shows only while a window is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقي الأيقونة في Dock حتى عند عدم فتح أي نافذة. عند إيقافه، تظهر فقط أثناء فتح نافذة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält das Symbol im Dock, auch wenn kein Fenster geöffnet ist. Aus: Es erscheint nur, solange ein Fenster geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene el icono en el Dock aunque no haya ninguna ventana abierta. Desactivado, solo aparece mientras hay una ventana abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde l’icône dans le Dock même quand aucune fenêtre n’est ouverte. Désactivé, elle n’apparaît que tant qu’une fenêtre est ouverte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई विंडो खुली न होने पर भी आइकन को Dock में रखता है। बंद होने पर, यह केवल विंडो खुली होने तक दिखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene l’icona nel Dock anche quando nessuna finestra è aperta. Disattivato, appare solo mentre una finestra è aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウが開いていないときもアイコンをDockに残します。オフにすると、ウインドウが開いている間だけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열린 윈도우가 없을 때도 아이콘을 Dock에 유지합니다. 끄면 윈도우가 열려 있는 동안에만 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje ikonę w Docku, gdy żadne okno nie jest otwarte. Po wyłączeniu ikona jest widoczna tylko, gdy otwarte jest okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o ícone no Dock mesmo sem nenhuma janela aberta. Desativado, ele aparece apenas enquanto houver uma janela aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет значок в Dock, даже когда ни одно окно не открыто. Если выключено, значок виден только при открытом окне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir pencere açık değilken de simgeyi Dock’ta tutar. Kapalıyken yalnızca bir pencere açıkken görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишає значок у Dock, навіть коли жодне вікно не відкрите. Якщо вимкнено, значок видно лише тоді, коли відкрите вікно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有打开窗口时也在程序坞中保留图标。关闭后，仅在有窗口打开时显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有開啟視窗時也在 Dock 中保留圖示。關閉後，只在有視窗開啟時顯示。"
          }
        }
      }
    },
