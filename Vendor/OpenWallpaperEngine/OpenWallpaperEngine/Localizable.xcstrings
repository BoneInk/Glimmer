    "Another app holds this shortcut, so it may not work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تطبيق آخر هذا الاختصار، لذا قد لا يعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App belegt diesen Kurzbefehl, daher funktioniert er eventuell nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app usa esta función rápida, así que puede que no funcione."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app utilise ce raccourci, il risque donc de ne pas fonctionner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह शॉर्टकट किसी दूसरे ऐप के पास है, इसलिए यह शायद काम न करे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra app usa questa abbreviazione, quindi potrebbe non funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリがこのショートカットを使用しているため、機能しない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 이 단축키를 사용하고 있어 작동하지 않을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten skrót jest zajęty przez inną aplikację, więc może nie działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app usa este atalho, então ele pode não funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сочетание клавиш занято другим приложением, поэтому оно может не работать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kısayolu başka bir uygulama kullanıyor, bu yüzden çalışmayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це скорочення зайняте іншою програмою, тому воно може не працювати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 App 占用了此快捷键，因此它可能无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個 App 佔用了此快速鍵，因此它可能無法使用。"
          }
        }
      }
    },
    "Another app uses this shortcut. Use Anyway saves it, but it may not work while that app holds it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تطبيق آخر هذا الاختصار. يؤدي «الاستخدام على أي حال» إلى حفظه، لكنه قد لا يعمل ما دام ذلك التطبيق يحتفظ به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App verwendet diesen Kurzbefehl. „Trotzdem verwenden“ sichert ihn, aber er funktioniert eventuell nicht, solange diese App ihn belegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app usa esta función rápida. «Usar de todos modos» la guarda, pero puede que no funcione mientras esa app la tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app utilise ce raccourci. « Utiliser quand même » l’enregistre, mais il risque de ne pas fonctionner tant que cette app l’occupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अन्य ऐप यह शॉर्टकट इस्तेमाल करता है। “फिर भी इस्तेमाल करें” इसे सहेजता है, लेकिन जब तक वह ऐप इसे रखता है, यह शायद काम न करे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra app usa questa abbreviazione. “Usa comunque” la salva, ma potrebbe non funzionare finché quell’app la occupa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリがこのショートカットを使用しています。「このまま使用」を選ぶと保存されますが、そのアプリが使用している間は機能しない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 이 단축키를 사용합니다. ‘그래도 사용’을 선택하면 저장되지만, 해당 앱이 사용하는 동안에는 작동하지 않을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inna aplikacja używa tego skrótu. „Użyj mimo to” zachowuje go, ale może on nie działać, dopóki ta aplikacja go zajmuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app usa este atalho. Usar Mesmo Assim o salva, mas ele pode não funcionar enquanto esse app o estiver usando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сочетание клавиш использует другое приложение. «Всё равно использовать» сохраняет его, но оно может не работать, пока его занимает то приложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama bu kısayolu kullanıyor. “Yine de Kullan” onu kaydeder, ancak o uygulama onu tuttuğu sürece çalışmayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інша програма використовує це скорочення. «Усе одно використати» зберігає його, але воно може не працювати, поки та програма його займає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 App 使用了此快捷键。“仍然使用”会存储它，但在该 App 占用期间它可能不起作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個 App 使用了此快速鍵。「仍要使用」會儲存它，但在該 App 佔用期間它可能無法運作。"
          }
        }
      }
    },
