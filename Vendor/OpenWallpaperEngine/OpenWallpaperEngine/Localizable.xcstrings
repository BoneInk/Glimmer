    "Click a display to select it. Hold Shift while clicking to select multiple desktops." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على شاشة عرض لتحديدها. اضغط باستمرار على Shift أثناء النقر لتحديد عدة أسطح مكتب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf ein Display, um es auszuwählen. Halten Sie beim Klicken die Shift-Taste gedrückt, um mehrere Schreibtische auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una pantalla para seleccionarla. Mantén pulsada la tecla Mayúsculas al hacer clic para seleccionar varios escritorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un moniteur pour le sélectionner. Maintenez la touche Maj enfoncée en cliquant pour sélectionner plusieurs bureaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी डिस्प्ले को चुनने के लिए उस पर क्लिक करें. एक से अधिक डेस्कटॉप चुनने के लिए Shift दबाकर क्लिक करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su uno schermo per selezionarlo. Tieni premuto Shift mentre fai clic per selezionare più scrivanie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイをクリックして選択します。shiftキーを押しながらクリックすると複数のデスクトップを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이를 클릭하여 선택하십시오. 여러 데스크탑을 선택하려면 Shift 키를 누른 채로 클릭하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij wyświetlacz, aby go zaznaczyć. Przytrzymaj Shift podczas klikania, aby zaznaczyć wiele biurek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
