    "Invalid API key.\nGet a valid key at steamcommunity.com/dev/apikey" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح API غير صالح.\nاحصل على مفتاح صالح من steamcommunity.com/dev/apikey"
          }
        },
        "de" : {
          "stringUnit" : {
