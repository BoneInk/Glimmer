          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium エンジンとそのデータをゴミ箱に入れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium 엔진과 데이터를 휴지통으로 이동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi silnik Chromium i jego dane do kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o motor Chromium e seus dados para o Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещает движок Chromium и его данные в Корзину."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium motorunu ve verilerini Çöp Sepeti’ne taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує рушій Chromium і його дані до Смітника."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Chromium 引擎及其数据移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 Chromium 引擎及其資料移到垃圾桶。"
          }
        }
      }
    },
    "Moves the app's SteamCMD to the Trash. Workshop downloads won't work until SteamCMD is installed again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل SteamCMD الخاص بالتطبيق إلى سلة المهملات. ولن تعمل تنزيلات الورشة حتى يُثبَّت SteamCMD مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt das SteamCMD der App in den Papierkorb. Workshop-Downloads funktionieren erst wieder, wenn SteamCMD erneut installiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada el SteamCMD de la app a la papelera. Las descargas de Workshop no funcionarán hasta que vuelvas a instalar SteamCMD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place le SteamCMD de l’app dans la corbeille. Les téléchargements du Workshop ne fonctionneront plus tant que SteamCMD ne sera pas réinstallé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप का SteamCMD रद्दी में मूव करता है। SteamCMD फिर से इंस्टॉल होने तक Workshop डाउनलोड काम नहीं करेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta lo SteamCMD dell’app nel Cestino. I download dal Workshop non funzioneranno finché SteamCMD non sarà reinstallato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App の SteamCMD をゴミ箱に入れます。SteamCMD を再インストールするまで、ワークショップのダウンロードは機能しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 SteamCMD를 휴지통으로 이동합니다. SteamCMD를 다시 설치할 때까지 창작마당 다운로드가 작동하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi SteamCMD aplikacji do Kosza. Pobieranie z Warsztatu nie będzie działać, dopóki SteamCMD nie zostanie ponownie zainstalowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o SteamCMD do app para o Lixo. Os downloads da Oficina não funcionarão até o SteamCMD ser instalado de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещает SteamCMD приложения в Корзину. Загрузки из Мастерской не будут работать, пока SteamCMD не установлен снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın SteamCMD’sini Çöp Sepeti’ne taşır. SteamCMD yeniden yüklenene kadar Atölye indirmeleri çalışmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщує SteamCMD програми в Смітник. Викачування з Майстерні не працюватиме, доки SteamCMD не буде встановлено знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 App 的 SteamCMD 移到废纸篓。在重新安装 SteamCMD 之前，创意工坊下载将无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
