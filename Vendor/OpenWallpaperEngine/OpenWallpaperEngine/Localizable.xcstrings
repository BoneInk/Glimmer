    "The wallpaper couldn't be set as the screen saver. The logs say why." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تعيين الخلفية كشاشة توقف. توضح السجلات السبب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund konnte nicht als Bildschirmschoner festgelegt werden. Die Protokolle nennen den Grund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo usar el fondo como salvapantallas. Los registros indican el motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fond d’écran n’a pas pu être défini comme économiseur d’écran. Les journaux indiquent pourquoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर को स्क्रीन सेवर के रूप में सेट नहीं किया जा सका। लॉग में कारण है।"
          }
        },
        "it" : {
          "stringUnit" : {
