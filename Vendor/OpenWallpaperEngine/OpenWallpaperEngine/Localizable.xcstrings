    "The playlist “%@” uses this shortcut. Use Anyway moves it to this hotkey." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم قائمة التشغيل ”%@“ هذا الاختصار. يؤدي «الاستخدام على أي حال» إلى نقله إلى هذا الاختصار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Playlist „%@“ verwendet diesen Kurzbefehl. „Trotzdem verwenden“ überträgt ihn auf diese Tastenkombination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist «%@» usa esta función rápida. «Usar de todos modos» la pasa a esta tecla de acceso rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist « %@ » utilise ce raccourci. « Utiliser quand même » le déplace vers ce raccourci."
