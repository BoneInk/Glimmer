        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏移動畫的起點，可用來讓同一效果的兩個副本不同步。"
          }
        }
      }
    },
    "Offsets, scales or rotates the layer." : {
      "comment" : "Scene Edit / Export tooltip for the transform effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
