    "Mirrors the layer below itself, as if on water or glass." : {
      "comment" : "Scene Edit / Export tooltip for the reflection effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعكس الطبقة أسفلها، كما لو كانت على ماء أو زجاج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiegelt die Ebene unter sich, wie auf Wasser oder Glas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleja la capa debajo de sí misma, como sobre agua o cristal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflète le calque sous lui-même, comme sur de l’eau ou du verre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेयर को अपने नीचे मिरर करता है, मानो पानी या काँच पर हो."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riflette il livello sotto sé stesso, come sull’acqua o sul vetro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水面やガラスに映ったように、レイヤーを下側に反転して映します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물이나 유리 위에 있는 것처럼 레이어를 아래쪽에 반사합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbija warstwę pod nią samą, jak na wodzie lub szkle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espelha a camada abaixo de si mesma, como se estivesse sobre água ou vidro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отражает слой под ним, как в воде или стекле."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katmanı, su ya da cam üzerindeymiş gibi kendi altına yansıtır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Віддзеркалює шар під ним самим, ніби на воді чи склі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图层下方生成其镜像，就像映在水面或玻璃上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在圖層下方產生其鏡像，彷彿映在水面或玻璃上。"
          }
        }
      }
    },
