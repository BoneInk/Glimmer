    "Zoom" : {
      "comment" : "Wallpaper placement: enlarge to fill the screen",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكبير"
          }
        },
        "de" : {
