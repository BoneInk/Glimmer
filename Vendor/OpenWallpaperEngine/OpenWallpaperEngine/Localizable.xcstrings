    "Recording a device needs the Microphone permission; until it's granted, the system audio is recorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب التسجيل من جهاز إذن الميكروفون؛ وإلى أن يُمنح، يُسجَّل صوت النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Aufnahme von einem Gerät ist die Mikrofonberechtigung nötig; bis sie erteilt ist, wird das Systemaudio aufgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabar un dispositivo necesita el permiso de Micrófono; hasta que lo concedas, se graba el audio del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement d’un appareil nécessite l’autorisation Micro ; tant qu’elle n’est pas accordée, ce sont les sons du système qui sont enregistrés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी डिवाइस से रिकॉर्ड करने के लिए माइक्रोफ़ोन अनुमति चाहिए; अनुमति मिलने तक सिस्टम ऑडियो रिकॉर्ड होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per registrare da un dispositivo serve il permesso Microfono; finché non viene concesso, viene registrato l’audio di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスから録音するにはマイクへのアクセス許可が必要です。許可されるまではシステムオーディオが録音されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치에서 녹음하려면 마이크 권한이 필요합니다. 권한이 허용될 때까지는 시스템 오디오가 녹음됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie z urządzenia wymaga uprawnienia Mikrofon; dopóki nie zostanie przyznane, nagrywany jest dźwięk systemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravar um dispositivo exige a permissão de Microfone; até que ela seja concedida, o áudio do sistema é gravado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для записи с устройства нужно разрешение «Микрофон»; пока оно не выдано, записывается системный звук."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir aygıttan kayıt için Mikrofon izni gerekir; izin verilene kadar sistem sesi kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для запису з пристрою потрібен дозвіл «Мікрофон»; доки його не надано, записується системний звук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从设备录音需要“麦克风”权限；在授予之前，录制的是系统音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從裝置錄音需要「麥克風」權限；在授予之前，錄製的是系統音訊。"
          }
        }
      }
    },
