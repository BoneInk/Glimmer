    "%@ · %@ · %@ s. Only “%@” keeps its crop and edits; the others are centred and export as authored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ ث. تحتفظ ”%4$@“ وحدها بالاقتصاص والتعديلات؛ ويُوسَّط الباقي ويُصدَّر كما أُنشئ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ s. Nur „%4$@“ behält Ausschnitt und Bearbeitungen; die anderen werden zentriert und wie veröffentlicht exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ s. Solo «%4$@» conserva su recorte y sus cambios; los demás se centran y se exportan tal como se crearon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ s. Seul « %4$@ » garde son recadrage et ses modifications ; les autres sont centrés et exportés tels qu’ils ont été créés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ से. केवल “%4$@” अपना क्रॉप और बदलाव रखता है; बाकी बीच में रखकर जैसे बनाए गए थे वैसे ही एक्सपोर्ट होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ s. Solo “%4$@” mantiene ritaglio e modifiche; gli altri vengono centrati ed esportati così come sono stati creati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@秒。切り取りと編集が反映されるのは“%4$@”だけです。ほかの壁紙は中央に合わせ、作成されたとおりに書き出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@초. 자르기와 편집 내용은 ‘%4$@’에만 적용되며, 나머지는 가운데에 맞춰 원래 만들어진 대로 내보내집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ s. Tylko „%4$@” zachowuje swój kadr i zmiany; pozostałe są wyśrodkowane i eksportowane w oryginalnej postaci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ s. Somente “%4$@” mantém o recorte e as edições; os outros são centralizados e exportados como foram criados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ с. Кадрирование и изменения сохраняет только «%4$@»; остальные центрируются и экспортируются в исходном виде."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ sn. Yalnızca “%4$@” kırpmasını ve düzenlemelerini korur; diğerleri ortalanır ve oluşturuldukları gibi dışa aktarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ с. Кадрування та зміни зберігає лише «%4$@»; решта центруються й експортуються у первісному вигляді."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ 秒。只有“%4$@”保留其裁剪和编辑；其他墙纸居中并按原样导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@ 秒。只有「%4$@」保留其裁切和編輯；其他背景圖片置中並按原樣輸出。"
          }
        }
      }
    },
