    "Also offers pre-release versions, which get new features first and may be less stable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض أيضًا الإصدارات التجريبية التي تحصل على الميزات الجديدة أولًا وقد تكون أقل استقرارًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietet auch Vorabversionen an, die neue Funktionen früher erhalten und weniger stabil sein können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También ofrece versiones preliminares, que reciben antes las novedades y pueden ser menos estables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose aussi les préversions, qui reçoivent les nouveautés en premier et peuvent être moins stables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्री-रिलीज़ वर्शन भी देता है, जिनमें नई सुविधाएँ पहले आती हैं और जो कम स्थिर हो सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offre anche le versioni preliminari, che ricevono prima le novità e possono essere meno stabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新機能が先に入る、安定性の低い場合があるプレリリース版も提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 기능을 먼저 받지만 덜 안정적일 수 있는 시험판 버전도 제공합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferuje też wersje przedpremierowe, które wcześniej dostają nowe funkcje, ale mogą być mniej stabilne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também oferece versões de pré-lançamento, que recebem os novos recursos primeiro e podem ser menos estáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также предлагает предварительные версии: новые функции появляются в них раньше, но они могут быть менее стабильны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni özellikleri önce alan ve daha az kararlı olabilen ön sürümleri de sunar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також пропонує попередні версії: нові функції зʼявляються в них раніше, але вони можуть бути менш стабільними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时提供预发布版本，它们会先获得新功能，但可能不太稳定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時提供預先發行版本，這些版本會先獲得新功能，但可能較不穩定。"
