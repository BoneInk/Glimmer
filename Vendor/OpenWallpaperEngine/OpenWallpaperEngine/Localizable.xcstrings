    "Only the screen saver changes. The wallpaper on your desktop keeps its properties and edits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتغير شاشة التوقف فقط. تحتفظ الخلفية على سطح المكتب بخصائصها وتعديلاتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Bildschirmschoner ändert sich. Das Hintergrundbild auf dem Schreibtisch behält seine Eigenschaften und Änderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el salvapantallas. El fondo de tu escritorio conserva sus propiedades y cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l’économiseur d’écran change. Le fond d’écran de votre bureau garde ses propriétés et ses modifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल स्क्रीन सेवर बदलता है। आपके डेस्कटॉप का वॉलपेपर अपनी प्रॉपर्टी और बदलाव बनाए रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo il salvaschermo. Lo sfondo sulla scrivania mantiene le sue proprietà e modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変わるのはスクリーンセーバだけです。デスクトップの壁紙のプロパティと編集はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 보호기만 변경됩니다. 데스크탑의 배경화면은 속성과 편집 내용을 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia się tylko wygaszacz ekranu. Tapeta na biurku zachowuje swoje właściwości i zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas o protetor de tela muda. O papel de parede da mesa mantém suas propriedades e edições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняется только заставка. Обои на рабочем столе сохраняют свои свойства и изменения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca ekran koruyucu değişir. Masaüstünüzdeki duvar kâğıdı özelliklerini ve düzenlemelerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінюється лише заставка. Шпалери на робочому столі зберігають свої властивості й зміни."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有屏幕保护程序会更改。桌面上的墙纸会保留其属性和编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有螢幕保護程式會更改。桌面上的背景圖片會保留其屬性和編輯。"
          }
        }
      }
    },
    "Only the selected display is reset." : {
