    "Vertical speed. Negative values move the other way, 0 stops." : {
      "comment" : "Scene Edit / Export tooltip for an effect parameter named like speedy",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السرعة العمودية. القيم السالبة تحرّك في الاتجاه المعاكس، و0 يوقف الحركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Geschwindigkeit. Negative Werte bewegen in die Gegenrichtung, 0 stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad vertical. Los valores negativos mueven en sentido contrario; 0 lo detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse verticale. Les valeurs négatives vont dans l’autre sens, 0 arrête."
