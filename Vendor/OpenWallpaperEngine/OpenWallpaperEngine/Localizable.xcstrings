    "Vertical scroll speed. Negative scrolls up, 0 stops." : {
      "comment" : "Scene Edit / Export tooltip for the scroll effect's speedy parameter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرعة التمرير العمودي. القيم السالبة تمرّر إلى أعلى، و0 يوقفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Scrollgeschwindigkeit. Negative Werte scrollen nach oben, 0 stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de desplazamiento vertical. Los valores negativos desplazan hacia arriba; 0 lo detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse de défilement vertical. Une valeur négative défile vers le haut, 0 arrête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबवत स्क्रॉल स्पीड. ऋणात्मक मान ऊपर स्क्रॉल करता है, 0 रोक देता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità di scorrimento verticale. I valori negativi scorrono verso l’alto, 0 si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縦方向のスクロール速度です。負の値で上へスクロールし、0で停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세로 스크롤 속도입니다. 음수이면 위로 스크롤되고, 0이면 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość przewijania w pionie. Wartości ujemne przewijają w górę, 0 zatrzymuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de rolagem vertical. Valores negativos rolam para cima; 0 para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость прокрутки по вертикали. Отрицательные значения — вверх, 0 — остановка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikey kaydırma hızı. Negatif değer yukarı kaydırır, 0 durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкість вертикальної прокрутки. Відʼємні значення прокручують угору, 0 зупиняє."
          }
        },
        "zh-Hans" : {
