        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेलिस्ट “%@” यह शॉर्टकट इस्तेमाल करती है। “फिर भी इस्तेमाल करें” इसे इस हॉटकी पर ले आता है।"
          }
        },
        "it" : {
          "stringUnit" : {
