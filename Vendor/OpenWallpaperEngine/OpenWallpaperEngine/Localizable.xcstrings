    "Move existing wallpapers to the selected folder, or leave them in the current location and use the new folder from now on?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد نقل الخلفيات الموجودة إلى المجلد المحدد، أم تركها في موقعها الحالي واستخدام المجلد الجديد من الآن فصاعدًا؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Hintergrundbilder in den ausgewählten Ordner bewegen oder am aktuellen Ort belassen und ab jetzt den neuen Ordner verwenden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres mover los fondos de pantalla existentes a la carpeta seleccionada, o dejarlos en su ubicación actual y usar la nueva carpeta a partir de ahora?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer les fonds d’écran existants vers le dossier sélectionné, ou les laisser à leur emplacement actuel et utiliser le nouveau dossier à partir de maintenant ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा वॉलपेपर को चुने गए फ़ोल्डर में मूव करें, या उन्हें मौजूदा जगह पर ही छोड़कर अब से नए फ़ोल्डर का उपयोग करें?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi spostare gli sfondi esistenti nella cartella selezionata, oppure lasciarli dove sono e usare la nuova cartella da ora in poi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の壁紙を選択したフォルダに移動しますか？それとも現在の場所に残し、今後は新しいフォルダを使用しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 배경화면을 선택한 폴더로 이동하시겠습니까, 아니면 현재 위치에 두고 지금부터 새 폴더를 사용하시겠습니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieść istniejące tapety do wybranego folderu czy pozostawić je w obecnym miejscu i od teraz używać nowego folderu?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover as imagens de fundo existentes para a pasta selecionada ou deixá-las no local atual e usar a nova pasta daqui em diante?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить имеющиеся обои в выбранную папку или оставить их на месте и использовать новую папку с этого момента?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut duvar kâğıtları seçilen klasöre taşınsın mı, yoksa geçerli konumlarında bırakılıp bundan sonra yeni klasör mü kullanılsın?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістити наявні шпалери до вибраної папки чи залишити їх у поточному місці й надалі використовувати нову папку?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
