    "Delete wallpaper" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف الخلفية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundbild löschen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar fondo de pantalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer le fond d’écran"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर डिलीट करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina sfondo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙を削除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 삭제"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń tapetę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar imagem de fundo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить обои"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kâğıdını sil"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити шпалеру"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除墙纸"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除背景圖片"
          }
        }
      }
    },
    "Deletes a wallpaper's original package once it has converted and rendered cleanly, to save disk space. If a later converter update changes a Workshop wallpaper, it's downloaded again; a local import isn't updated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف الحزمة الأصلية للخلفية بعد تحويلها وعرضها دون أخطاء، لتوفير مساحة القرص. وإذا غيّر تحديث لاحق للمحوّل خلفية من الورشة، فستُنزَّل مجددًا؛ أما الاستيراد المحلي فلا يُحدَّث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht das Originalpaket eines Hintergrundbilds, sobald es fehlerfrei konvertiert und dargestellt wurde, um Speicherplatz zu sparen. Ändert ein späteres Konverter-Update ein Workshop-Hintergrundbild, wird es erneut geladen; ein lokaler Import wird nicht aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el paquete original de un fondo de pantalla cuando se ha convertido y mostrado sin errores, para ahorrar espacio en disco. Si una actualización posterior del conversor cambia un fondo de pantalla de Workshop, se vuelve a descargar; una importación local no se actualiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime le paquet d’origine d’un fond d’écran une fois converti et affiché sans erreur, pour gagner de l’espace disque. Si une mise à jour ultérieure du convertisseur modifie un fond d’écran du Workshop, il est retéléchargé ; une importation locale n’est pas mise à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलपेपर के सही से कन्वर्ट और रेंडर होने के बाद, डिस्क स्पेस बचाने के लिए उसका मूल पैकेज डिलीट करता है। अगर बाद का कन्वर्टर अपडेट किसी Workshop वॉलपेपर को बदलता है, तो वह फिर से डाउनलोड होता है; लोकल इंपोर्ट अपडेट नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina il pacchetto originale di uno sfondo dopo che è stato convertito e visualizzato senza errori, per risparmiare spazio su disco. Se un aggiornamento successivo del convertitore modifica uno sfondo del Workshop, viene scaricato di nuovo; un’importazione locale non viene aggiornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙が問題なく変換・描画されたら元のパッケージを削除し、ディスク容量を節約します。後のコンバータのアップデートでワークショップの壁紙が変わる場合は再ダウンロードされますが、ローカルから読み込んだものは更新されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면이 오류 없이 변환되고 렌더링되면 원본 패키지를 삭제해 디스크 공간을 절약합니다. 이후 변환기 업데이트로 창작마당 배경화면이 바뀌면 다시 다운로드되며, 로컬에서 가져온 항목은 업데이트되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa oryginalny pakiet tapety, gdy zostanie bezbłędnie przekonwertowana i wyrenderowana, aby oszczędzić miejsce na dysku. Jeśli późniejsza aktualizacja konwertera zmieni tapetę z Warsztatu, zostanie pobrana ponownie; lokalny import nie jest aktualizowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga o pacote original de uma imagem de fundo depois que ela é convertida e renderizada sem erros, para economizar espaço em disco. Se uma atualização posterior do conversor alterar uma imagem de fundo da Oficina, ela é baixada de novo; uma importação local não é atualizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет исходный пакет обоев, когда они без ошибок преобразованы и отрисованы, чтобы сэкономить место на диске. Если более позднее обновление конвертера изменит обои из Мастерской, они загрузятся снова; локально импортированные не обновляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir duvar kâğıdı sorunsuz dönüştürülüp işlendiğinde, disk alanından tasarruf için özgün paketini siler. Sonraki bir dönüştürücü güncellemesi bir Atölye duvar kâğıdını değiştirirse yeniden indirilir; yerel içe aktarma güncellenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє оригінальний пакет шпалери, щойно її без помилок перетворено й відтворено, щоб заощадити місце на диску. Якщо пізніше оновлення конвертера змінить шпалеру з Майстерні, її буде викачано знову; локальний імпорт не оновлюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墙纸成功转换并正常渲染后，删除其原始包以节省磁盘空间。如果之后的转换器更新改变了创意工坊墙纸，它会被重新下载；本地导入的墙纸不会更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景圖片成功轉換並正常渲染後，刪除其原始套件以節省磁碟空間。若之後的轉換器更新改變了工作坊背景圖片，會重新下載；本機輸入的項目不會更新。"
          }
        }
      }
    },
    "Deletes the caches now, except what the wallpapers on screen use. Wallpapers load slower once while their caches are made again." : {
      "comment" : "Settings › Performance › Caches: help of the Clear Caches button",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف ذاكرات التخزين المؤقت الآن، باستثناء ما تستخدمه الخلفيات المعروضة على الشاشة. سيكون تحميل الخلفيات أبطأ مرة واحدة ريثما تُنشأ ذاكراتها المؤقتة من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht die Caches sofort, außer dem, was die Hintergrundbilder auf dem Bildschirm verwenden. Hintergrundbilder laden einmalig langsamer, während ihre Caches neu erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las cachés ahora, excepto lo que usan los fondos de pantalla visibles. Los fondos de pantalla cargarán más despacio una vez mientras se vuelven a crear sus cachés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les caches maintenant, sauf ce qu’utilisent les fonds d’écran affichés. Les fonds d’écran se chargent plus lentement une fois, le temps de recréer leurs caches."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन पर दिख रहे वॉलपेपर जो उपयोग कर रहे हैं उसे छोड़कर, कैश को अभी हटाता है। कैश दोबारा बनने तक वॉलपेपर एक बार धीमे लोड होंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina subito la cache, tranne ciò che usano gli sfondi sullo schermo. Gli sfondi si caricheranno più lentamente una volta, mentre la loro cache viene ricreata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上の壁紙が使用しているものを除き、キャッシュを今すぐ削除します。キャッシュが再作成されるまで、壁紙の読み込みが一度だけ遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면의 배경화면이 사용하는 항목을 제외하고 캐시를 지금 삭제합니다. 캐시를 다시 만드는 동안 배경화면이 한 번은 느리게 로드됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa teraz pamięć podręczną, z wyjątkiem tego, czego używają tapety na ekranie. Tapety raz załadują się wolniej, gdy ich pamięć podręczna będzie tworzona od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga os caches agora, exceto o que as imagens de fundo na tela usam. As imagens de fundo carregam mais devagar uma vez enquanto seus caches são refeitos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет кэши сейчас, кроме того, что используют обои на экране. Обои один раз загрузятся медленнее, пока их кэши создаются заново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrandaki duvar kâğıtlarının kullandıkları dışında önbellekleri şimdi siler. Önbellekleri yeniden oluşturulurken duvar kâğıtları bir kereliğine daha yavaş yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє кеші зараз, окрім того, що використовують шпалери на екрані. Шпалери один раз завантажаться повільніше, поки їхні кеші створюються знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即删除缓存，屏幕上的墙纸正在使用的除外。重新生成缓存期间，墙纸的载入会慢一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即刪除快取，螢幕上的背景圖片正在使用的除外。重新建立快取期間，背景圖片的載入會慢一次。"
          }
        }
      }
    },
    "Deletes the originals that are ready now, without waiting for the next launch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف النسخ الأصلية الجاهزة الآن دون انتظار التشغيل التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht die Originale, die jetzt bereit sind, ohne auf den nächsten Start zu warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ahora los originales que están listos, sin esperar al próximo inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime dès maintenant les originaux prêts, sans attendre le prochain lancement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले लॉन्च का इंतज़ार किए बिना, अभी तैयार मूल फ़ाइलें डिलीट करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ora gli originali pronti, senza attendere il prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回の起動を待たずに、準備ができているオリジナルを今すぐ削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 실행을 기다리지 않고 지금 준비된 원본을 삭제합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa gotowe oryginały teraz, bez czekania na następne uruchomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga agora os originais que estão prontos, sem esperar a próxima abertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет готовые к удалению оригиналы сейчас, не дожидаясь следующего запуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır olan orijinalleri bir sonraki açılışı beklemeden şimdi siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє готові оригінали зараз, не чекаючи наступного запуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即删除已准备好的原始文件，无需等到下次启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即刪除已準備好的原始檔案，無須等到下次啟動。"
          }
        }
      }
    },
    "Deletes the owe-mcp command, stops accepting MCP clients and closes their connections." : {
      "comment" : "Settings › Plugins › MCP Server: Remove button help",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف الأمر owe-mcp، ويتوقف عن قبول عملاء MCP، ويغلق اتصالاتهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den Befehl owe-mcp, nimmt keine MCP-Clients mehr an und schließt ihre Verbindungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el comando owe-mcp, deja de aceptar clientes MCP y cierra sus conexiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime la commande owe-mcp, cesse d’accepter les clients MCP et ferme leurs connexions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "owe-mcp कमांड डिलीट करता है, MCP क्लाइंट स्वीकार करना बंद करता है और उनके कनेक्शन बंद करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina il comando owe-mcp, smette di accettare client MCP e chiude le loro connessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "owe-mcp コマンドを削除し、MCP クライアントの受け付けを停止して、その接続を閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "owe-mcp 명령을 삭제하고 MCP 클라이언트 연결을 더 이상 받지 않으며 기존 연결을 닫습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa polecenie owe-mcp, przestaje przyjmować klientów MCP i zamyka ich połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga o comando owe-mcp, deixa de aceitar clientes MCP e fecha as conexões deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет команду owe-mcp, перестает принимать MCP-клиентов и закрывает их соединения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "owe-mcp komutunu siler, MCP istemcilerini kabul etmeyi durdurur ve bağlantılarını kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє команду owe-mcp, припиняє приймати MCP-клієнтів і закриває їхні зʼєднання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 owe-mcp 命令，停止接受 MCP 客户端并关闭它们的连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 owe-mcp 指令，停止接受 MCP 用戶端並關閉它們的連線。"
          }
        }
      }
    },
    "Density of dropouts and noise specks." : {
      "comment" : "Scene Edit / Export tooltip for the vhs effect's artifacts parameter",
      "localizations" : {
        "ar" : {
