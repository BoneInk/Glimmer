            "value" : "Смещает начало анимации — полезно, чтобы рассинхронизировать две копии эффекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasyonun başlangıcını kaydırır; bir efektin iki kopyasını birbirinden ayrı zamanlamak için kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
