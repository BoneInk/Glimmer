    "Dynamic runs live on the phone, with its clock, audio and properties; Pre-Rendered is a fixed video" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتحركة تعمل مباشرة على الهاتف بساعتها وصوتها وخصائصها؛ والمرندرة مسبقًا فيديو ثابت"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamisch läuft live auf dem Smartphone, mit Uhr, Audio und Eigenschaften; Vorgerendert ist ein festes Video"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinámico se ejecuta en directo en el teléfono, con su reloj, audio y propiedades; Preprocesado es un vídeo fijo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamique s’exécute en direct sur le téléphone, avec son horloge, son audio et ses propriétés ; Prerendu est une vidéo fixe"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डायनैमिक फ़ोन पर लाइव चलता है, अपनी घड़ी, ऑडियो और प्रॉपर्टी के साथ; प्री-रेंडर्ड एक तय वीडियो है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamico funziona dal vivo sul telefono, con orologio, audio e proprietà; Pre-renderizzato è un video fisso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミックは時計、オーディオ、プロパティとともにスマートフォン上でライブ実行されます。プリレンダリング済は固定のビデオです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적은 시계, 오디오 및 속성과 함께 휴대폰에서 실시간으로 실행되고, 사전 렌더링은 고정된 비디오입니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamiczna działa na żywo na telefonie, z zegarem, dźwiękiem i właściwościami; Prerenderowana to stałe wideo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinâmico roda ao vivo no celular, com relógio, áudio e propriedades; Pré-renderizado é um vídeo fixo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамические работают на телефоне вживую, с часами, звуком и свойствами; пререндеринг — это готовое видео"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişken, saati, sesi ve özellikleriyle telefonda canlı çalışır; Önceden İşlenmiş sabit bir videodur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамічні працюють на телефоні наживо, з годинником, звуком і властивостями; перед-відмальовані — це готове відео"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态在手机上实时运行，带有时钟、音频和属性；预渲染是固定的视频"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態在手機上即時執行，具備時鐘、音訊和屬性；預先轉譯是固定的影片"
          }
        }
      }
    },
    "Dynamic: runs live on the phone. Clocks tick, audio-reactive layers follow the phone's sound, and the wallpaper's properties can be changed there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متحركة: تعمل مباشرة على الهاتف. تتحرك الساعات، وتتبع الطبقات المتجاوبة مع الصوت صوت الهاتف، ويمكن تغيير خصائص الخلفية هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamisch: läuft live auf dem Smartphone. Uhren laufen, audioreaktive Ebenen folgen dem Ton des Smartphones und die Eigenschaften des Hintergrundbilds lassen sich dort ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinámico: se ejecuta en directo en el teléfono. Los relojes avanzan, las capas que reaccionan al audio siguen el sonido del teléfono y las propiedades del fondo se pueden cambiar allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamique : s’exécute en direct sur le téléphone. Les horloges tournent, les calques réactifs à l’audio suivent le son du téléphone et les propriétés du fond d’écran y sont modifiables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डायनैमिक: फ़ोन पर लाइव चलता है। घड़ियाँ चलती हैं, ऑडियो पर प्रतिक्रिया देने वाली लेयर फ़ोन की आवाज़ के साथ चलती हैं, और वॉलपेपर की प्रॉपर्टी वहीं बदली जा सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamico: funziona dal vivo sul telefono. Gli orologi scorrono, i livelli audio-reattivi seguono il suono del telefono e le proprietà dello sfondo si possono cambiare lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミック：スマートフォン上でライブ実行されます。時計は進み、オーディオに反応するレイヤーはスマートフォンのサウンドに合わせて動き、壁紙のプロパティもそこで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적: 휴대폰에서 실시간으로 실행됩니다. 시계가 움직이고, 오디오 반응 레이어가 휴대폰의 소리를 따르며, 배경화면의 속성을 그곳에서 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamiczna: działa na żywo na telefonie. Zegary chodzą, warstwy reagujące na dźwięk podążają za dźwiękiem telefonu, a właściwości tapety można tam zmieniać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinâmico: roda ao vivo no celular. Os relógios andam, as camadas que reagem ao áudio seguem o som do celular e as propriedades do papel de parede podem ser alteradas nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамические: работают на телефоне вживую. Часы идут, слои, реагирующие на звук, следуют за звуком телефона, а свойства обоев можно менять прямо там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişken: telefonda canlı çalışır. Saatler işler, sese duyarlı katmanlar telefonun sesini izler ve duvar kağıdının özellikleri orada değiştirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамічні: працюють на телефоні наживо. Годинники йдуть, шари, що реагують на звук, відстежують звук телефона, а властивості шпалер можна змінювати там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态：在手机上实时运行。时钟会走动，音频响应图层会跟随手机的声音，墙纸的属性也可在手机上更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態：在手機上即時執行。時鐘會走動，音訊回應圖層會跟隨手機的聲音，桌布的屬性也可在手機上變更。"
          }
        }
      }
    },
    "Each side can have at most %@ pixels." : {
      "comment" : "Android Export: %@ is the largest side in pixels",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يكون لكل جانب %@ بكسل على الأكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite darf höchstens %@ Pixel haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lado puede tener como máximo %@ píxeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque côté peut avoir au plus %@ pixels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर भुजा में ज़्यादा से ज़्यादा %@ पिक्सेल हो सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni lato può avere al massimo %@ pixel."
          }
