    "Reloads the wallpapers and their audio when you switch the sound output, such as to headphones or another speaker." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد تحميل الخلفيات وصوتها عند تبديل مخرج الصوت، مثل التبديل إلى سماعات الرأس أو مكبر صوت آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt die Hintergrundbilder und ihren Ton neu, wenn Sie die Tonausgabe wechseln, etwa zu Kopfhörern oder einem anderen Lautsprecher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a cargar los fondos de pantalla y su audio cuando cambias la salida de sonido, por ejemplo a auriculares u otro altavoz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recharge les fonds d’écran et leur son lorsque vous changez de sortie audio, par exemple vers un casque ou un autre haut-parleur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साउंड आउटपुट बदलने पर, जैसे हेडफ़ोन या किसी दूसरे स्पीकर पर, वॉलपेपर और उनका ऑडियो फिर से लोड करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricarica gli sfondi e il loro audio quando cambi l’uscita audio, ad esempio verso le cuffie o un altro altoparlante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウンドの出力先をヘッドフォンや別のスピーカーなどに切り替えたときに、壁紙とそのオーディオを再読み込みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드폰이나 다른 스피커 등으로 사운드 출력을 바꾸면 배경화면과 오디오를 다시 불러옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczytuje ponownie tapety i ich dźwięk po zmianie wyjścia dźwięku, na przykład na słuchawki lub inny głośnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recarrega as imagens de fundo e o áudio delas quando você muda a saída de som, como para fones de ouvido ou outro alto-falante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезагружает обои и их звук при смене аудиовыхода, например на наушники или другой динамик."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses çıkışını değiştirdiğinizde, örneğin kulaklığa veya başka bir hoparlöre, duvar kâğıtlarını ve seslerini yeniden yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезавантажує шпалери та їхній звук, коли ви змінюєте аудіовихід, наприклад на навушники чи інший динамік."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换声音输出（如切换到耳机或其他扬声器）时，重新载入墙纸及其音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換聲音輸出（例如切換到耳機或其他揚聲器）時，重新載入背景圖片及其音訊。"
          }
        }
      }
    },
