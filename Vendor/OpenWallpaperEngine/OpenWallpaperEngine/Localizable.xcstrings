    "Appears on your iPhone and iPad when iCloud Photos is on in Photos settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر على iPhone وiPad عند تشغيل صور iCloud في إعدادات الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint auf Ihrem iPhone und iPad, wenn „iCloud-Fotos“ in den Einstellungen von „Fotos“ aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en tu iPhone y iPad cuando Fotos de iCloud está activado en los ajustes de Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaît sur votre iPhone et votre iPad lorsque Photos iCloud est activé dans les réglages de Photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos सेटिंग्स में iCloud फ़ोटो चालू होने पर यह आपके iPhone और iPad पर दिखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare su iPhone e iPad quando Foto di iCloud è attivo nelle impostazioni di Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“写真”の設定で“iCloud写真”がオンのとき、iPhoneとiPadに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 설정에서 iCloud 사진이 켜져 있으면 iPhone과 iPad에 나타납니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojawia się na iPhonie i iPadzie, gdy w ustawieniach Zdjęć włączone są Zdjęcia iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece no iPhone e iPad quando Fotos do iCloud está ativado nos ajustes do Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Появляется на iPhone и iPad, когда в настройках «Фото» включено «Фото iCloud»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar ayarlarında iCloud Fotoğrafları açıkken iPhone’unuzda ve iPad’inizde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’являється на iPhone та iPad, коли в параметрах «Фото» ввімкнено «Фото iCloud»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“照片”设置中打开“iCloud 照片”时，会出现在你的 iPhone 和 iPad 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「照片」設定中開啟「iCloud 照片」時，會出現在你的 iPhone 和 iPad 上。"
          }
        }
      }
    },
