            "value" : "Alles bleibt auf Ihrem Mac. Es gibt keine Server, Konten, Analysen oder Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se queda en tu Mac. No hay servidores, cuentas, analíticas ni seguimiento."
