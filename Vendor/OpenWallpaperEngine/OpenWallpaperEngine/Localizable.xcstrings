    "Can't reach Valve's server to download SteamCMD. Check your internet connection and try again." : {
      "comment" : "Error installing SteamCMD: network unreachable",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الوصول إلى خادم Valve لتنزيل SteamCMD. تحقق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server von Valve ist zum Laden von SteamCMD nicht erreichbar. Überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con el servidor de Valve para descargar SteamCMD. Comprueba tu conexión a Internet y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur de Valve pour télécharger SteamCMD. Vérifiez votre connexion à Internet et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD डाउनलोड करने के लिए Valve के सर्वर तक नहीं पहुँचा जा सकता. अपना इंटरनेट कनेक्शन जाँचें और फिर से कोशिश करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server di Valve per scaricare SteamCMD. Controlla la connessione a Internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD をダウンロードするための Valve のサーバに接続できません。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD를 다운로드하기 위해 Valve 서버에 연결할 수 없습니다. 인터넷 연결을 확인한 후 다시 시도하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z serwerem Valve, aby pobrać SteamCMD. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o servidor da Valve para baixar o SteamCMD. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся связаться с сервером Valve для загрузки SteamCMD. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD’yi indirmek için Valve’ın sunucusuna ulaşılamıyor. İnternet bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається зʼєднатися із сервером Valve, щоб завантажити SteamCMD. Перевірте підключення до інтернету й спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 Valve 的服务器以下载 SteamCMD。请检查互联网连接，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至 Valve 的伺服器以下載 SteamCMD。請檢查網際網路連線，然後再試一次。"
          }
        }
      }
    },
    "Can't reach the server to download the Chromium engine. Check your internet connection and try again." : {
      "comment" : "Chromium engine install error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الخادم لتنزيل محرك Chromium. تحقق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server zum Laden der Chromium-Engine ist nicht erreichbar. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al servidor para descargar el motor Chromium. Comprueba tu conexión a Internet e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur pour télécharger le moteur Chromium. Vérifiez votre connexion à Internet et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium इंजन डाउनलोड करने के लिए सर्वर तक नहीं पहुँच सका। अपना इंटरनेट कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server per scaricare il motore Chromium. Controlla la connessione a Internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium エンジンをダウンロードするサーバに接続できません。インターネット接続を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium 엔진을 다운로드할 서버에 연결할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z serwerem, aby pobrać silnik Chromium. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o servidor para baixar o motor Chromium. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся связаться с сервером для загрузки движка Chromium. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromium motorunu indirmek için sunucuya ulaşılamıyor. İnternet bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається звʼязатися із сервером для завантаження рушія Chromium. Перевірте підключення до інтернету й спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接服务器以下载 Chromium 引擎。请检查互联网连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至伺服器以下載 Chromium 引擎。請檢查網際網路連線後再試一次。"
          }
        }
      }
    },
