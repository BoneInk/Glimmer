    },
    "Downloads the depth model this release of the app uses and removes older ones." : {
      "comment" : "Settings › Plugins: Update button help",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل نموذج العمق الذي يستخدمه هذا الإصدار من التطبيق ويزيل النماذج الأقدم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt das Tiefenmodell, das diese App-Version verwendet, und entfernt ältere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el modelo de profundidad que usa esta versión de la app y elimina los anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge le modèle de profondeur utilisé par cette version de l’app et supprime les plus anciens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के इस रिलीज़ में उपयोग होने वाला डेप्थ मॉडल डाउनलोड करता है और पुराने हटा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
