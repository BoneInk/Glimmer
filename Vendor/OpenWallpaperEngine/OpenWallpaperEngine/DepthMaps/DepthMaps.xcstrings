          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa o modelo de profundidade usado por esta versão do app e remove os mais antigos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает модель глубины, которую использует эта версия приложения, и удаляет более старые."
          }
        },
        "tr" : {
          "stringUnit" : {
