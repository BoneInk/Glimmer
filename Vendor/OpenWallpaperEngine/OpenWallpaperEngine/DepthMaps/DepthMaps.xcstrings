          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 앱에서 사용하는 깊이 모델을 다운로드하고 이전 모델을 제거합니다."
          }
        },
        "pl" : {
