    "Move this layer to a new position between the top (1) or the bottom (%lld) of the list." : {
      "comment" : "Wallpaper Editor, Move to Custom Position's sheet (ui_editor_generic_modal_enter_layer_position_body); the argument is the number of rows in the layer list",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل هذه الطبقة إلى موضع جديد بين أعلى القائمة (1) وأسفلها (%lld)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ebene an eine neue Position zwischen dem Anfang (1) und dem Ende (%lld) der Liste bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve esta capa a una nueva posición entre la primera (1) y la última (%lld) de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
