    "Move, rotate or scale the selection with the canvas’s handles" : {
      "comment" : "Wallpaper Editor canvas: help of the gizmo mode buttons",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل التحديد أو دوّره أو غيّر حجمه باستخدام مقابض اللوحة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auswahl mit den Griffen der Arbeitsfläche verschieben, drehen oder skalieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve, rota o escala la selección con los tiradores del lienzo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer, faire pivoter ou mettre à l’échelle la sélection avec les poignées du canevas"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैनवास के हैंडल से चयन को खिसकाएँ, घुमाएँ या स्केल करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta, ruota o ridimensiona la selezione con le maniglie dell’area di lavoro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンバスのハンドルで選択項目を移動、回転、拡大／縮小します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캔버스의 핸들로 선택 항목을 이동, 회전 또는 크기 조절합니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwaj, obracaj lub skaluj zaznaczenie uchwytami na płótnie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova, gire ou redimensione a seleção com as alças da tela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещайте, поворачивайте и масштабируйте выбранное маркерами на холсте"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimi tuvaldeki tutamaçlarla taşıyın, döndürün veya ölçekleyin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переміщуйте, повертайте або масштабуйте вибране маркерами на полотні"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用画布上的控制柄移动、旋转或缩放所选内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用畫布上的控制點移動、旋轉或縮放所選項目"
          }
        }
      }
    },
