    "Low FPS Simulation: the canvas runs at 22 frames per second, as on a slow computer" : {
      "comment" : "Wallpaper Editor: help of the Low FPS Simulation canvas button",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاكاة معدل إطارات منخفض: تعمل اللوحة بمعدل 22 إطارًا في الثانية، كما على حاسوب بطيء"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrige Bildrate simulieren: Die Arbeitsfläche läuft mit 22 Bildern pro Sekunde, wie auf einem langsamen Computer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulación de FPS bajos: el lienzo va a 22 fotogramas por segundo, como en un ordenador lento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulation de faible fréquence d’images : le canevas tourne à 22 images par seconde, comme sur un ordinateur lent"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम FPS सिमुलेशन: कैनवास 22 फ़्रेम प्रति सेकंड पर चलता है, जैसे किसी धीमे कंप्यूटर पर"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulazione FPS bassi: l’area di lavoro va a 22 fotogrammi al secondo, come su un computer lento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低FPSシミュレーション：遅いコンピュータのように、キャンバスを毎秒22フレームで動かします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮은 FPS 시뮬레이션: 느린 컴퓨터에서처럼 캔버스가 초당 22프레임으로 실행됩니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symulacja niskiej liczby kl./s: płótno działa z prędkością 22 klatek na sekundę, jak na wolnym komputerze"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulação de FPS baixo: a tela roda a 22 quadros por segundo, como em um computador lento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имитация низкой частоты кадров: холст работает с частотой 22 кадра в секунду, как на медленном компьютере"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük FPS benzetimi: tuval, yavaş bir bilgisayardaki gibi saniyede 22 karede çalışır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імітація низької частоти кадрів: полотно працює з частотою 22 кадри на секунду, як на повільному комп’ютері"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低帧率模拟：画布以每秒 22 帧运行，如同在较慢的电脑上"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低影格率模擬：畫布以每秒 22 格執行，如同在較慢的電腦上"
          }
        }
      }
    },
