        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina cada canal en su primer valor para que el bucle no tenga cortes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine chaque canal sur sa première valeur pour une boucle sans raccord"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चैनल को उसके पहले मान पर खत्म करता है, ताकि लूप बिना रुकावट चले"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina ogni canale sul suo primo valore, così il loop è continuo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各チャンネルを最初の値で終え、ループを継ぎ目なくします"
