  "strings": {
    "A user property sets this value": {
      "comment": "Timeline: help of a disabled keyframe button",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد خاصية المستخدم هذه القيمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Benutzereigenschaft legt diesen Wert fest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una propiedad de usuario define este valor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une propriété utilisateur définit cette valeur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मान यूज़र प्रॉपर्टी से सेट होता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una proprietà utente imposta questo valore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザプロパティがこの値を設定しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 속성이 이 값을 설정합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tę wartość ustawia właściwość użytkownika"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma propriedade do usuário define este valor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это значение задаётся пользовательским свойством"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değeri bir kullanıcı özelliği belirler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це значення задається властивістю користувача"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此值由用户属性设定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此值由使用者屬性設定"
          }
        }
      }
    },
