    "Ends each channel on its first value, so the loop is seamless": {
      "comment": "Timeline: help of Wrap Loop",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي كل قناة بقيمتها الأولى لتكون الحلقة سلسة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
