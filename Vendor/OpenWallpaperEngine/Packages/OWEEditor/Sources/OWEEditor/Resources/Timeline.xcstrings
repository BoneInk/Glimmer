    "Add a keyframe at the playhead": {
      "comment": "Timeline: help of the keyframe button",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إطار رئيسي عند رأس التشغيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyframe an der Abspielposition hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un fotograma clave en el cabezal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une image clé à la tête de lecture"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेहेड पर कीफ़्रेम जोड़ें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un fotogramma chiave alla testina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生ヘッドの位置にキーフレームを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생헤드 위치에 키프레임 추가"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj klatkę kluczową w miejscu głowicy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar um quadro-chave no indicador de reprodução"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить ключевой кадр в позиции указателя"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma başlığına anahtar kare ekle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати ключовий кадр у позиції покажчика"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放头处添加关键帧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放指示器處加入關鍵影格"
          }
        }
      }
    },
    "Add a keyframe with the diamond next to a property in the inspector, or add a track here.": {
      "comment": "Timeline: empty state",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف إطارًا رئيسيًا بالمعيّن بجانب خاصية في المراقب، أو أضِف مسارًا هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie mit der Raute neben einer Eigenschaft im Inspektor einen Keyframe hinzu, oder fügen Sie hier eine Spur hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un fotograma clave con el rombo junto a una propiedad en el inspector o añade una pista aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une image clé avec le losange à côté d’une propriété dans l’inspecteur, ou ajoutez une piste ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्पेक्टर में किसी प्रॉपर्टी के पास वाले डायमंड से कीफ़्रेम जोड़ें, या यहाँ ट्रैक जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un fotogramma chiave con il rombo accanto a una proprietà nell’Inspector, oppure aggiungi una traccia qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスペクタでプロパティの横のひし形をクリックしてキーフレームを追加するか、ここでトラックを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인스펙터에서 속성 옆의 마름모를 눌러 키프레임을 추가하거나 여기에서 트랙을 추가하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj klatkę kluczową rombem obok właściwości w inspektorze lub dodaj tutaj ścieżkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um quadro-chave com o losango ao lado de uma propriedade no inspetor ou adicione uma faixa aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ключевой кадр ромбом рядом со свойством в инспекторе или добавьте дорожку здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetçide bir özelliğin yanındaki elmasla anahtar kare ekleyin veya buradan bir iz ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте ключовий кадр ромбом поруч із властивістю в інспекторі або додайте доріжку тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用检查器中属性旁边的菱形添加关键帧，或在此处添加轨道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用檢閱器中屬性旁的菱形加入關鍵影格，或在此處加入軌道。"
          }
        }
      }
    },
