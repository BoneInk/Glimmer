    "Evens out the depth map’s flat areas while keeping the picture’s edges. Applies to the next generation." : {
      "comment" : "Depth map section of Scene Edit / Export and the Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسوّي المناطق المستوية في خريطة العمق مع الحفاظ على حواف الصورة. يُطبَّق على الإنشاء التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht flache Bereiche der Tiefenkarte aus und erhält dabei die Kanten des Bildes. Gilt für die nächste Erzeugung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniformiza las zonas planas del mapa de profundidad conservando los bordes de la imagen. Se aplica a la próxima generación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniformise les zones plates de la carte de profondeur en conservant les contours de l’image. S’applique à la prochaine génération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तस्वीर के किनारों को बनाए रखते हुए डेप्थ मैप के सपाट हिस्सों को एकसार करता है। अगली बार बनाने पर लागू होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniforma le aree piatte della mappa di profondità mantenendo i bordi dell’immagine. Si applica alla prossima generazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の輪郭を保ったまま深度マップの平坦な部分をならします。次回の生成から適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림의 가장자리는 유지하면서 깊이 맵의 평평한 영역을 고르게 합니다. 다음 생성부터 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrównuje płaskie obszary mapy głębi, zachowując krawędzie obrazu. Dotyczy następnego generowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniformiza as áreas planas do mapa de profundidade mantendo as bordas da imagem. Aplica-se à próxima geração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивает плоские области карты глубины, сохраняя края изображения. Применяется при следующем создании."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resmin kenarlarını koruyarak derinlik haritasının düz alanlarını düzgünleştirir. Bir sonraki oluşturmada uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вирівнює пласкі ділянки карти глибини, зберігаючи краї зображення. Застосовується під час наступного створення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在保留图像边缘的同时平滑深度图的平坦区域。用于下一次生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在保留影像邊緣的同時平滑深度圖的平坦區域。套用於下一次產生。"
          }
        }
      }
    },
