    "Shows the depth map: white is near, black is far." : {
      "comment" : "Depth map section of Scene Edit / Export and the Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض خريطة العمق: الأبيض قريب والأسود بعيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Tiefenkarte: Weiß ist nah, Schwarz ist fern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el mapa de profundidad: el blanco está cerca y el negro, lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la carte de profondeur : le blanc est proche, le noir est loin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेप्थ मैप दिखाता है: सफ़ेद पास है, काला दूर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la mappa di profondità: il bianco è vicino, il nero è lontano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度マップを表示します。白が近く、黒が遠くです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깊이 맵을 표시합니다. 흰색은 가깝고 검은색은 멉니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje mapę głębi: biel jest blisko, czerń daleko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o mapa de profundidade: branco é perto, preto é longe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает карту глубины: белое — близко, чёрное — далеко."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derinlik haritasını gösterir: beyaz yakın, siyah uzaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
