    "Swaps near and far, so the effect shows on the background instead of what is near." : {
      "comment" : "Help for the Invert checkbox of a layer's depth mask",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدّل القريب والبعيد، فيظهر التأثير على الخلفية بدلًا من الأشياء القريبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertauscht nah und fern, sodass der Effekt auf dem Hintergrund statt auf Nahem erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia lo cercano y lo lejano, para que el efecto se vea en el fondo en lugar de en lo cercano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permute le proche et le lointain : l’effet s’affiche sur l’arrière-plan plutôt que sur ce qui est proche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पास और दूर को आपस में बदल देता है, ताकि इफ़ेक्ट पास की चीज़ों के बजाय बैकग्राउंड पर दिखे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia vicino e lontano, così l’effetto compare sullo sfondo invece che su ciò che è vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くと遠くを入れ替え、エフェクトを近くのものではなく背景に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까운 곳과 먼 곳을 바꿔, 효과가 가까운 부분 대신 배경에 나타나게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamienia bliskie z dalekim, aby efekt był widoczny na tle zamiast na tym, co blisko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troca perto e longe, para que o efeito apareça no fundo em vez do que está perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет местами близкое и далёкое, чтобы эффект был виден на фоне, а не на близких объектах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakın ile uzağı değiştirir; efekt yakındakiler yerine arka planda görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Міняє місцями близьке й далеке, щоб ефект було видно на тлі, а не на близьких об’єктах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换近处和远处，让效果显示在背景上，而不是近处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交換近處與遠處，讓效果顯示在背景上，而非近處。"
          }
        }
      }
    },
    "Pushes the mask toward black and white; below 100% it is softer." : {
      "comment" : "Help for the Contrast slider of a layer's depth mask",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدفع القناع نحو الأبيض والأسود؛ وتحت 100٪ يصبح أنعم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treibt die Maske Richtung Schwarz und Weiß; unter 100 % wird sie weicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva la máscara hacia el blanco y negro; por debajo del 100 % es más suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse le masque vers le noir et blanc ; en dessous de 100 %, il est plus doux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मास्क को काले और सफ़ेद की ओर ले जाता है; 100% से कम पर यह नरम होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spinge la maschera verso il bianco e nero; sotto il 100% è più morbida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスクを白黒に近づけます。100% 未満ではより柔らかくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마스크를 흑백에 가깝게 만듭니다. 100% 미만에서는 더 부드러워집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa maskę w stronę czerni i bieli; poniżej 100% jest łagodniejsza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leva a máscara em direção ao preto e branco; abaixo de 100% ela fica mais suave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает маску ближе к чёрно-белой; ниже 100 % она мягче."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskeyi siyah ve beyaza doğru iter; %100’ün altında daha yumuşaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робить маску ближчою до чорно-білої; нижче 100 % вона м’якша."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让蒙版更接近黑白；低于 100% 时更柔和。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓遮罩更接近黑白；低於 100% 時更柔和。"
          }
        }
      }
    },
    "Add an effect with a mask, such as Shake, Water Ripple or Tint, to this layer first." : {
      "comment" : "Shown under Use as Mask for… when the layer has no effect with a mask; the effect names are Wallpaper Engine's",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أولًا إلى هذه الطبقة تأثيرًا له قناع، مثل اهتزاز أو تموج الماء أو لون خفيف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dieser Ebene zuerst einen Effekt mit Maske hinzu, etwa Schütteln, Wasserplätschern oder Farbton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade primero a esta capa un efecto con máscara, como Agitación, Onda de agua o Tinte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d’abord à ce calque un effet avec masque, comme Secousse, Ondulation de l’eau ou Teinte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले इस लेयर में मास्क वाला कोई इफ़ेक्ट जोड़ें, जैसे Shake, Water Ripple या Tint।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi prima a questo livello un effetto con maschera, come Scuotimento, Ondulazione dell’acqua o Tinta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にこのレイヤーにマスクのあるエフェクト（シェイク、水の波紋、薄塗りなど）を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 이 레이어에 세이크, 잔물결, 색조처럼 마스크가 있는 효과를 추가하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw dodaj do tej warstwy efekt z maską, np. Potrząsanie, Zmarszczki na wodzie lub Odcień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro adicione a esta camada um efeito com máscara, como Balanço, Ondulação de água ou Tingir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала добавьте к этому слою эффект с маской, например «Встряска», «Водная рябь» или «Оттенок»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce bu katmana Sallama, Su Dalgalanması veya Renk Tonu gibi maskesi olan bir efekt ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спочатку додайте до цього шару ефект із маскою, наприклад «Тряска», «Водна брижа» або «Відтінок»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先为此图层添加带蒙版的效果，例如摇动、水波纹或着色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先為此圖層加入帶遮罩的效果，例如晃動、漣漪或淡塗。"
          }
        }
      }
    },
