    "The effect’s mask was replaced. Undo brings the old one back; its file is kept." : {
      "comment" : "Shown after a depth map replaced an effect's existing mask",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم استبدال قناع التأثير. يعيد التراجع القناع القديم؛ ويُحتفظ بملفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Maske des Effekts wurde ersetzt. Widerrufen holt die alte zurück; ihre Datei bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha sustituido la máscara del efecto. Deshacer recupera la anterior; su archivo se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le masque de l’effet a été remplacé. Annuler rétablit l’ancien ; son fichier est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इफ़ेक्ट का मास्क बदल दिया गया। पहले जैसा करें से पुराना मास्क वापस आ जाता है; उसकी फ़ाइल रखी जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maschera dell’effetto è stata sostituita. Annulla ripristina quella precedente; il suo file viene conservato."
          }
        },
