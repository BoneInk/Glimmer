    "Estimates the depth of the picture on this Mac. Nothing is uploaded." : {
      "comment" : "Depth map section of Scene Edit / Export and the Wallpaper Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقدّر عمق الصورة على جهاز Mac هذا. لا يُرفع أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzt die Tiefe des Bildes auf diesem Mac. Es wird nichts hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estima la profundidad de la imagen en este Mac. No se sube nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estime la profondeur de l’image sur ce Mac. Rien n’est envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसी Mac पर तस्वीर की डेप्थ का अनुमान लगाता है। कुछ भी अपलोड नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima la profondità dell’immagine su questo Mac. Non viene caricato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上で画像の深度を推定します。何もアップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 그림의 깊이를 추정합니다. 아무것도 업로드되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szacuje głębię obrazu na tym Macu. Nic nie jest wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estima a profundidade da imagem neste Mac. Nada é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценивает глубину изображения на этом Mac. Ничего не загружается в сеть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resmin derinliğini bu Mac’te tahmin eder. Hiçbir şey yüklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
