    "Pixels between the mesh's points: smaller makes a denser mesh that bends more smoothly." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البكسلات بين نقاط الشبكة: القيمة الأصغر تعطي شبكة أكثف تنثني بسلاسة أكبر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel zwischen den Punkten des Netzes: kleiner ergibt ein dichteres Netz, das sich weicher biegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Píxeles entre los puntos de la malla: menos crea una malla más densa que se dobla con más suavidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixels entre les points du maillage : plus petit donne un maillage plus dense qui se plie plus doucement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेश के बिंदुओं के बीच पिक्सेल: कम मान से घनी मेश बनती है जो ज़्यादा सहजता से मुड़ती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixel tra i punti della mesh: meno crea una mesh più fitta che si piega in modo più morbido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッシュの点の間隔（ピクセル）。小さいほど密なメッシュになり、滑らかに曲がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시 점 사이의 픽셀 수입니다. 작을수록 메시가 촘촘해져 더 부드럽게 휩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piksele między punktami siatki: mniej to gęstsza siatka, która gnie się gładziej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixels entre os pontos da malha: menor gera uma malha mais densa que dobra com mais suavidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пикселей между точками сетки: меньше — плотнее сетка и плавнее изгиб."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ noktaları arasındaki piksel: küçük değer daha sık ve daha yumuşak bükülen bir ağ verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пікселів між точками сітки: менше — щільніша сітка й плавніший згин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网格点之间的像素数：越小网格越密，弯曲越平滑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網格點之間的像素數：越小網格越密，彎曲越平滑。"
          }
        }
      }
    },
