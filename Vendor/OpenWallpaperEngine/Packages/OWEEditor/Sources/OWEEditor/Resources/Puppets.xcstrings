    "Click a joint to pick its bone, then paint. Option paints the other way." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مفصلًا لاختيار عظمته ثم ارسم. مفتاح Option يرسم بالعكس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gelenk anklicken, um seinen Knochen zu wählen, dann malen. Mit Wahltaste wird umgekehrt gemalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una articulación para elegir su hueso y pinta. Opción pinta al revés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une articulation pour choisir son os, puis peignez. Option peint dans l’autre sens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हड्डी चुनने के लिए किसी जोड़ पर क्लिक करें, फिर पेंट करें। Option उल्टा पेंट करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un’articolazione per sceglierne l’osso, poi dipingi. Opzione dipinge al contrario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関節をクリックしてボーンを選び、ペイントします。Option キーで逆向きにペイントします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관절을 클릭해 본을 고른 다음 칠하세요. Option 키를 누르면 반대로 칠합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij staw, aby wybrać kość, potem maluj. Option maluje odwrotnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique numa articulação para escolher o osso e pinte. Option pinta ao contrário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните сустав, чтобы выбрать кость, затем рисуйте. С Option — в обратную сторону."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemiğini seçmek için bir ekleme tıklayın, sonra boyayın. Option tersine boyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть суглоб, щоб вибрати кістку, потім малюйте. З Option — у зворотний бік."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击关节选择其骨骼，然后绘制。按住 Option 反向绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下關節選擇其骨骼，然後繪製。按住 Option 反向繪製。"
          }
        }
      }
    },
    "Click a limb to select it. A limb with a clipping mask shows only over the limbs its mask is painted on." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر طرفًا لتحديده. لا يظهر الطرف الذي له قناع قص إلا فوق الأطراف المرسوم عليها قناعه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf ein Glied, um es auszuwählen. Ein Glied mit Schnittmaske ist nur über den Gliedern zu sehen, auf die seine Maske gezeichnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una extremidad para seleccionarla. Una extremidad con trazado de recorte solo se ve sobre las extremidades en las que se ha pintado su trazado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un membre pour le sélectionner. Un membre doté d’un masque de détourage n’apparaît qu’au-dessus des membres sur lesquels son masque est peint."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी अंग को चुनने के लिए उस पर क्लिक करें। क्लिपिंग मास्क वाला अंग केवल उन अंगों के ऊपर दिखता है जिन पर उसका मास्क पेंट किया गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un arto per selezionarlo. Un arto con una maschera di ritaglio è visibile solo sopra gli arti su cui è colorata la sua maschera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リムをクリックして選択します。クリッピングマスクのあるリムは、そのマスクが塗られたリムの上にだけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔다리를 클릭해 선택합니다. 클리핑 마스크가 있는 팔다리는 그 마스크가 칠해진 팔다리 위에서만 보입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij kończynę, aby ją zaznaczyć. Kończyna z maską przycinającą jest widoczna tylko nad kończynami, na których namalowano jej maskę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em um membro para selecioná-lo. Um membro com máscara de recorte só aparece sobre os membros em que a máscara foi pintada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните конечность, чтобы выбрать её. Конечность с маской обрезки видна только поверх конечностей, на которых нарисована её маска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçmek için bir uzva tıklayın. Kırpma maskesi olan bir uzuv yalnızca maskesinin boyandığı uzuvların üzerinde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть кінцівку, щоб вибрати її. Кінцівку з відсічною маскою видно лише над кінцівками, на яких намальовано її маску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按肢体以选择它。带剪贴蒙版的肢体只在其蒙版所绘制的肢体上方显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下肢體以選取。具有裁剪遮罩的肢體只會在其遮罩所繪製的肢體上方顯示。"
          }
        }
      }
    },
    "Click a vertex to select it, drag to move. Shift adds to the selection; Delete removes it." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر رأسًا لتحديده واسحبه لتحريكه. Shift يضيف إلى التحديد، وDelete يحذفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Eckpunkt anklicken, um ihn auszuwählen, ziehen zum Bewegen. Umschalt erweitert die Auswahl; Löschen entfernt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un vértice para seleccionarlo y arrastra para moverlo. Mayúsculas añade a la selección; Suprimir la elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un sommet pour le sélectionner, faites glisser pour le déplacer. Maj ajoute à la sélection ; Supprimer l’efface."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनने के लिए वर्टेक्स पर क्लिक करें, खिसकाने के लिए ड्रैग करें। Shift चयन में जोड़ता है; Delete हटाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un vertice per selezionarlo, trascina per spostarlo. Maiusc aggiunge alla selezione; Elimina la rimuove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頂点をクリックして選択し、ドラッグで移動します。Shift で選択に追加、Delete で削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정점을 클릭해 선택하고 드래그해 옮깁니다. Shift는 선택에 추가하고 Delete는 삭제합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij wierzchołek, aby go zaznaczyć, przeciągnij, aby przesunąć. Shift dodaje do zaznaczenia; Delete usuwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique num vértice para selecioná-lo e arraste para movê-lo. Shift adiciona à seleção; Delete a remove."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните вершину, чтобы выбрать, тяните, чтобы переместить. Shift добавляет к выбору, Delete удаляет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçmek için bir köşeye tıklayın, taşımak için sürükleyin. Shift seçime ekler; Delete siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть вершину, щоб вибрати, тягніть, щоб перемістити. Shift додає до вибору, Delete видаляє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击顶点以选择，拖移以移动。按住 Shift 添加到所选内容；Delete 将其删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下頂點以選取，拖移以移動。按住 Shift 加入選取範圍；Delete 將其刪除。"
          }
        }
      }
    },
