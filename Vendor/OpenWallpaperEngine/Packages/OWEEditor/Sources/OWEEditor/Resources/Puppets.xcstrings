    "Adding: drag from the new bone's joint toward its end; it goes under the selected bone." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإضافة: اسحب من مفصل العظمة الجديدة نحو طرفها؛ وتُضاف تحت العظمة المحددة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinzufügen: vom Gelenk des neuen Knochens zu seinem Ende ziehen; er wird unter den ausgewählten Knochen gehängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir: arrastra desde la articulación del nuevo hueso hacia su extremo; queda bajo el hueso seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajout : faites glisser de l’articulation du nouvel os vers son extrémité ; il se place sous l’os sélectionné."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोड़ना: नई हड्डी के जोड़ से उसके सिरे की ओर ड्रैग करें; वह चुनी गई हड्डी के नीचे जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunta: trascina dall’articolazione del nuovo osso verso la sua estremità; va sotto l’osso selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加：新しいボーンの関節から先端へドラッグします。選択中のボーンの下に入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가: 새 본의 관절에서 끝 방향으로 드래그합니다. 선택한 본 아래에 들어갑니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawanie: przeciągnij od stawu nowej kości w stronę jej końca; trafi pod zaznaczoną kość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar: arraste da articulação do novo osso até a ponta; ele fica sob o osso selecionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавление: тяните от сустава новой кости к её концу; она станет дочерней для выбранной кости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekleme: yeni kemiğin ekleminden ucuna doğru sürükleyin; seçili kemiğin altına eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додавання: тягніть від суглоба нової кістки до її кінця; вона стане дочірньою для вибраної кістки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加：从新骨骼的关节拖向其末端；它会成为所选骨骼的子骨骼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入：從新骨骼的關節拖向其末端；它會成為所選骨骼的子骨骼。"
          }
        }
      }
    },
