          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una chiave per l’osso selezionato (tutte le ossa senza selezione) in questo fotogramma"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
