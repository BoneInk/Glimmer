    "Paint the mask over the limbs this one may show over." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارسم القناع فوق الأطراف التي يمكن أن يظهر هذا الطرف فوقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne die Maske über die Glieder, über denen dieses Glied zu sehen sein darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta el trazado sobre las extremidades sobre las que puede verse esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peignez le masque sur les membres au-dessus desquels celui-ci peut apparaître."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मास्क को उन अंगों पर पेंट करें जिनके ऊपर यह अंग दिख सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora la maschera sugli arti sopra i quali questo può essere visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリムを表示してよいリムの上にマスクを塗ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 팔다리가 보여도 되는 팔다리 위에 마스크를 칠하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namaluj maskę na kończynach, nad którymi ta kończyna może być widoczna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinte a máscara sobre os membros sobre os quais este pode aparecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарисуйте маску на конечностях, поверх которых может быть видна эта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskeyi bu uzvun üzerinde görünebileceği uzuvların üzerine boyayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намалюйте маску на кінцівках, над якими може бути видно цю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此肢体可以显示于其上方的肢体上绘制蒙版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此肢體可顯示於其上方的肢體上繪製遮罩。"
          }
        }
      }
    },
