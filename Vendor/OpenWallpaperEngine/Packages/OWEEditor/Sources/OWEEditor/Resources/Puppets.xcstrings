    "%lld vertices have no weights." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld من الرؤوس بلا أوزان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Eckpunkte haben keine Gewichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld vértices no tienen pesos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sommets n’ont pas de poids."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld वर्टेक्स का कोई वज़न नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld vertici non hanno pesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個の頂点にウェイトがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정점 %lld개에 가중치가 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wierzchołki bez wag: %lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld vértices não têm pesos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вершин без весов: %lld."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld köşenin ağırlığı yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вершин без ваг: %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个顶点没有权重。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個頂點沒有權重。"
          }
        }
      }
    },
    "0 reaches the bone's first child." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 يصل إلى أول عظمة تابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 reicht bis zum ersten Kind des Knochens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 llega al primer hijo del hueso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 atteint le premier enfant de l’os."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 हड्डी के पहले चाइल्ड तक पहुँचता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 arriva al primo figlio dell’osso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 はボーンの最初の子まで届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0이면 본의 첫 번째 자식까지 닿습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 sięga pierwszego dziecka kości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 alcança o primeiro filho do osso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 — до первой дочерней кости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0, kemiğin ilk alt kemiğine ulaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 — до першої дочірньої кістки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 表示延伸到骨骼的第一个子骨骼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 表示延伸到骨骼的第一個子骨骼。"
          }
        }
      }
    },
    "A blend rule pulls this bone toward another by the weight each animation keys." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسحب قاعدة الدمج هذه العظمة نحو عظمة أخرى بالوزن الذي تحدده كل رسوم متحركة بمفاتيحها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Mischungsregel zieht diesen Knochen um das Gewicht, das jede Animation mit Schlüsseln setzt, zu einem anderen Knochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regla de mezcla acerca este hueso a otro según el peso que cada animación fija con claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une règle de fusion attire cet os vers un autre selon le poids que chaque animation définit par des clés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लेंड नियम इस हड्डी को किसी दूसरी हड्डी की ओर उतने भार से खींचता है जितना हर एनिमेशन की में तय करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regola di miscelazione avvicina quest’osso a un altro secondo il peso che ogni animazione imposta con le chiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブレンドルールは、各アニメーションがキーで設定したウェイトでこのボーンを別のボーンへ引き寄せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼합 규칙은 각 애니메이션이 키로 지정한 가중치만큼 이 본을 다른 본 쪽으로 당깁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasada łączenia przyciąga tę kość do innej z wagą ustawioną kluczami w każdej animacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma regra de combinação puxa este osso em direção a outro pelo peso que cada animação define com chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило смешивания притягивает эту кость к другой с весом, заданным ключами в каждой анимации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karıştırma kuralı, bu kemiği her animasyonun anahtarlarla belirlediği ağırlıkla başka bir kemiğe doğru çeker."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило змішування притягує цю кістку до іншої з вагою, заданою ключами в кожній анімації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合规则按每个动画用关键帧设定的权重，将此骨骼拉向另一根骨骼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合規則依每個動畫以關鍵影格設定的權重，將此骨骼拉向另一根骨骼。"
          }
        }
      }
    },
    "A clipping mask is nested within a mask it clips: Wallpaper Engine ignores the nesting." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قناع قص متداخل داخل قناع يقصه: يتجاهل Wallpaper Engine هذا التداخل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Schnittmaske ist in eine Maske verschachtelt, die sie selbst beschneidet: Wallpaper Engine ignoriert die Verschachtelung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un trazado de recorte está anidado en un trazado que él mismo recorta: Wallpaper Engine ignora el anidamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un masque de détourage est imbriqué dans un masque qu’il détoure : Wallpaper Engine ignore l’imbrication."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक क्लिपिंग मास्क ऐसे मास्क के भीतर नेस्ट है जिसे वह क्लिप करता है: Wallpaper Engine इस नेस्टिंग को अनदेखा करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una maschera di ritaglio è annidata in una maschera che essa stessa ritaglia: Wallpaper Engine ignora l’annidamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリッピングマスクが、それ自体がクリップするマスクの中にネストされています。Wallpaper Engine はこのネストを無視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클리핑 마스크가 자신이 클리핑하는 마스크 안에 중첩되어 있습니다. Wallpaper Engine은 이 중첩을 무시합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maska przycinająca jest zagnieżdżona w masce, którą sama przycina: Wallpaper Engine pomija to zagnieżdżenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma máscara de recorte está aninhada em uma máscara que ela recorta: o Wallpaper Engine ignora o aninhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маска обрезки вложена в маску, которую сама обрезает: Wallpaper Engine игнорирует это вложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kırpma maskesi, kırptığı bir maskenin içine yerleştirilmiş: Wallpaper Engine bu iç içe yerleşimi yok sayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсічну маску вкладено в маску, яку вона сама відсікає: Wallpaper Engine ігнорує це вкладення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个剪贴蒙版嵌套在它所剪贴的蒙版中：Wallpaper Engine 会忽略这种嵌套。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個裁剪遮罩巢狀於它所裁剪的遮罩中：Wallpaper Engine 會忽略此巢狀結構。"
          }
        }
      }
    },
    "A puppet bends the image with a mesh and bones. The mesh is fitted to the image’s opaque pixels." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تثني الدمية الصورة بشبكة وعظام. تُطابَق الشبكة مع البكسلات المعتمة في الصورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Puppe verformt das Bild mit einem Netz und Knochen. Das Netz wird an die deckenden Pixel des Bildes angepasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una marioneta deforma la imagen con una malla y huesos. La malla se ajusta a los píxeles opacos de la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une marionnette déforme l’image avec un maillage et des os. Le maillage suit les pixels opaques de l’image."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पपेट मेश और हड्डियों से छवि को मोड़ता है। मेश छवि के अपारदर्शी पिक्सेल पर फ़िट की जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pupazzo deforma l’immagine con una mesh e delle ossa. La mesh si adatta ai pixel opachi dell’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パペットはメッシュとボーンで画像を変形します。メッシュは画像の不透明なピクセルに合わせて作られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "퍼펫은 메시와 본으로 이미지를 변형합니다. 메시는 이미지의 불투명한 픽셀에 맞춰집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacynka wygina obraz za pomocą siatki i kości. Siatka dopasowuje się do nieprzezroczystych pikseli obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um fantoche deforma a imagem com uma malha e ossos. A malha se ajusta aos pixels opacos da imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Марионетка изгибает изображение сеткой и костями. Сетка повторяет непрозрачные пиксели изображения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukla, görüntüyü bir ağ ve kemiklerle büker. Ağ, görüntünün opak piksellerine uydurulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маріонетка згинає зображення сіткою та кістками. Сітка повторює непрозорі пікселі зображення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "木偶通过网格和骨骼让图像弯曲。网格会贴合图像的不透明像素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "木偶透過網格和骨骼讓圖像彎曲。網格會貼合圖像的不透明像素。"
          }
        }
      }
    },
