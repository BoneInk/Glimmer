    "Save as New Wallpaper writes the puppet once these are fixed." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب «حفظ كخلفية جديدة» الدمية بعد إصلاح ما سبق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als neues Hintergrundbild sichern“ schreibt die Puppe, sobald dies behoben ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar como nuevo fondo de pantalla escribe la marioneta cuando esto se corrija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer comme nouveau fond d’écran écrit la marionnette une fois ces points corrigés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें ठीक करने पर “नए वॉलपेपर के रूप में सहेजें” पपेट लिखेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva come nuovo sfondo scrive il pupazzo una volta risolti questi punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらを直すと「新規壁紙として保存」でパペットが書き出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 문제를 고치면 ‘새 배경화면으로 저장’이 퍼펫을 기록합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zachowaj jako nową tapetę” zapisze pacynkę po poprawieniu tych błędów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar como Nova Imagem de Fundo grava o fantoche quando isso for corrigido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сохранить как новые обои» запишет марионетку, когда это будет исправлено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar düzeltilince Yeni Duvar Kâğıdı Olarak Kaydet kuklayı yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Зберегти як нову шпалеру» запише маріонетку, щойно це буде виправлено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正这些问题后，“保存为新墙纸”会写出木偶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正這些問題後，「儲存為新背景圖片」會寫出木偶。"
          }
        }
      }
    },
    "Save as New Wallpaper writes the puppet's files." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب «حفظ كخلفية جديدة» ملفات الدمية."
          }
        },
        "de" : {
