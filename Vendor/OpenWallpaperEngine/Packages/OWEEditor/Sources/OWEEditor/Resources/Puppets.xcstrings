    "Heat diffusion follows the image's shape; distance only looks at how near each bone is." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع انتشار الحرارة شكل الصورة؛ أما المسافة فتنظر فقط إلى قرب كل عظمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wärmediffusion folgt der Form des Bildes; Abstand berücksichtigt nur, wie nah jeder Knochen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La difusión de calor sigue la forma de la imagen; la distancia solo mira lo cerca que está cada hueso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diffusion de chaleur suit la forme de l’image ; la distance ne tient compte que de la proximité des os."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ताप प्रसार छवि के आकार का अनुसरण करता है; दूरी केवल यह देखती है कि हर हड्डी कितनी पास है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diffusione del calore segue la forma dell’immagine; la distanza guarda solo quanto è vicino ogni osso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱拡散は画像の形に沿います。距離は各ボーンへの近さだけを見ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 확산은 이미지 모양을 따르고, 거리는 각 본과의 거리만 봅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyfuzja ciepła podąża za kształtem obrazu; odległość bierze pod uwagę tylko bliskość kości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A difusão de calor segue a forma da imagem; a distância só considera a proximidade de cada osso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепловая диффузия повторяет форму изображения; расстояние учитывает только близость костей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isı yayılımı görüntünün biçimini izler; mesafe yalnızca kemiklerin yakınlığına bakar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теплова дифузія повторює форму зображення; відстань враховує лише близькість кісток."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热扩散会顺着图像的形状；距离只看每根骨骼有多近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱擴散會順著圖像的形狀；距離只看每根骨骼有多近。"
          }
        }
      }
    },
