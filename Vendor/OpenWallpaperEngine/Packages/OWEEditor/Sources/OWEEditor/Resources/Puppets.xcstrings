    "Play the image’s animation layers, as the wallpaper will" : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل طبقات الرسوم المتحركة للصورة كما ستفعل الخلفية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Animationsebenen des Bildes abspielen, wie es das Hintergrundbild tun wird"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducir las capas de animación de la imagen, como hará el fondo"
          }
