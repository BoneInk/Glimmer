    "Pose bones at the current frame: each change sets a key." : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط وضعية العظام في الإطار الحالي: كل تغيير يعيّن مفتاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knochen im aktuellen Bild posieren: Jede Änderung setzt einen Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca los huesos en el fotograma actual: cada cambio crea una clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez les os à l’image actuelle : chaque modification crée une clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा फ़्रेम पर हड्डियों का पोज़ बनाएँ: हर बदलाव एक की सेट करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in posa le ossa al fotogramma attuale: ogni modifica crea una chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のフレームでボーンのポーズを付けます。変更ごとにキーが打たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 프레임에서 본의 자세를 잡습니다. 바꿀 때마다 키가 설정됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawiaj kości w bieżącej klatce: każda zmiana ustawia klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicione os ossos no quadro atual: cada mudança cria uma chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте позу костей в текущем кадре: каждое изменение ставит ключ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemiklere geçerli karede poz verin: her değişiklik bir anahtar koyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставте позу кісток у поточному кадрі: кожна зміна ставить ключ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在当前帧摆放骨骼姿势：每次更改都会设置关键帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在目前影格擺放骨骼姿勢：每次更改都會設定關鍵影格。"
          }
        }
      }
    },
