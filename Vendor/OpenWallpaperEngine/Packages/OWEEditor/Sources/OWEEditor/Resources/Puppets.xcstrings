    "Add Animation Layer" : {
      "comment" : "Wallpaper Editor, Puppet Warp",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة طبقة رسوم متحركة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animationsebene hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir capa de animación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un calque d’animation"
          }
        },
        "hi" : {
