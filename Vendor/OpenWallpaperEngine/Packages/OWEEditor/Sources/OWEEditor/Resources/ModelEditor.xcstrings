    "Add an attachment to hang other layers from a bone." : {
      "comment" : "Wallpaper Editor, Model Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف نقطة ربط لتعليق طبقات أخرى من عظمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie einen Anhängepunkt hinzu, um andere Ebenen an einen Knochen zu hängen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un punto de anclaje para colgar otras capas de un hueso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un point d’attache pour suspendre d’autres calques à un os."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी बोन से दूसरी लेयर लटकाने के लिए अटैचमेंट जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un punto di aggancio per appendere altri livelli a un osso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボーンにほかのレイヤーを付けるにはアタッチメントを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 레이어를 본에 매달려면 부착점을 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj punkt zaczepienia, aby zawiesić inne warstwy na kości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um anexo para pendurar outras camadas em um osso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте точку крепления, чтобы прикрепить к кости другие слои."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer katmanları bir kemiğe asmak için bir bağlantı noktası ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте точку кріплення, щоб прикріпити до кістки інші шари."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加附着点，把其他图层挂到骨骼上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增附著點，把其他圖層掛到骨骼上。"
          }
        }
      }
    },
