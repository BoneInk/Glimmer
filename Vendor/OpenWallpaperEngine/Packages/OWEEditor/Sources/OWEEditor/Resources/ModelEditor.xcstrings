    "The shader’s settings can’t be read without Wallpaper Engine’s assets." : {
      "comment" : "Wallpaper Editor, Model Editor",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن قراءة إعدادات المظلّل بدون أصول Wallpaper Engine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne die Assets von Wallpaper Engine lassen sich die Einstellungen des Shaders nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes del sombreador no se pueden leer sin los recursos de Wallpaper Engine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages du shader ne peuvent pas être lus sans les ressources de Wallpaper Engine."
