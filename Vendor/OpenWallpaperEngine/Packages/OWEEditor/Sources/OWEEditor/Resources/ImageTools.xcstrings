    "Higher values increase quality slightly but significantly increase time to recalculate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte verbessern die Qualität leicht aber erhöhen die Zeit, die eine Neuberechnung in Anspruch nimmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs plus élevées augmentent légèrement la qualité, mais augmentent considérablement le temps de recalcul."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto mayor sea el valor, más aumentará la calidad, pero también tardará más en recalcularse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores maiores melhoram a qualidade, mas aumentam significativamente o tempo para recalcular."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori più elevati migliorano leggermente la qualità, ma aumentano notevolmente il tempo di ricalcolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定値を高めることで上がるクオリティーはわずかでも、再計算の時間は大幅に長くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높은 값으로 설정하면 품질이 약간 좋아지나 재연산에 드는 시간이 눈에 띠게 증가합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高值可以略微提高质量，但会显着增加重新计算的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加數值可稍微提升品質，但會顯著增加重新計算的時間。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокие значения немного повышают качество, но значительно увеличивают время пересчета."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyższe wartości nieznacznie zwiększają jakość, a także znacznie zwiększają czas potrzebny na rekalkulację."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek değerler kaliteyi biraz artırır ama tekrar hesaplama süresini önemli ölçüde artırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вищі значення несильно покращують якість, проте значно збільшують час на перерахунок."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي القيم الأعلى إلى زيادة الجودة بشكل طفيف ولكنها تزيد من وقت إعادة الحسابات بشكل ملحوظ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊँचे मान गुणवत्ता थोड़ी बढ़ाते हैं, पर दोबारा गणना का समय काफ़ी बढ़ा देते हैं।"
          }
        }
      }
    },
