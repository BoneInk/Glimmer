    "Add a limb to separate it from the body." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie ein Glied hinzu, um es vom Körper zu trennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un membre pour le séparer du corps."
          }
        },
