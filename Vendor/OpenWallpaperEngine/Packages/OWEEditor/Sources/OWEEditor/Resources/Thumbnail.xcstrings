    "File › Save writes it into the wallpaper, and the library shows it." : {
      "comment" : "Wallpaper Editor, new thumbnail: where it goes for a local wallpaper (File menu › Save)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتبها ملف › حفظ في الخلفية، وتعرضها المكتبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ablage“ › „Sichern“ schreibt sie in das Hintergrundbild, und die Mediathek zeigt sie an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivo › Guardar la escribe en el fondo de pantalla y la biblioteca la muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichier › Enregistrer l’écrit dans le fond d’écran, et la bibliothèque l’affiche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल › सहेजें इसे वॉलपेपर में लिखता है, और लाइब्रेरी इसे दिखाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File › Salva la scrive nello sfondo e la libreria la mostra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイル」›「保存」で壁紙に書き込まれ、ライブラリに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 › 저장을 하면 배경화면에 기록되고 보관함에 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik › Zachowaj zapisuje ją w tapecie, a biblioteka ją pokazuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivo › Salvar a grava na imagem de fundo, e a biblioteca a mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Файл» › «Сохранить» записывает её в обои, и медиатека её показывает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya › Kaydet onu duvar kâğıdına yazar ve arşiv onu gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Файл» › «Зберегти» записує її в шпалеру, і медіатека її показує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“文件”›“保存”会将其写入墙纸，资料库会显示它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「檔案」›「儲存」會將其寫入背景圖片，資料庫會顯示它。"
          }
        }
      }
    },
