    "This is a portrait picture of %@ × %@ pixels. Unless you have a portrait display, much of it is cut off." : {
      "comment" : "New Wallpaper: WE's portrait warning; %@ × %@ is the picture's size",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه صورة عمودية بحجم %@ × %@ بكسل. ما لم تكن لديك شاشة عمودية، فسيُقص جزء كبير منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein Bild im Hochformat mit %@ × %@ Pixeln. Ohne Hochformat-Monitor wird ein großer Teil abgeschnitten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una imagen vertical de %@ × %@ píxeles. Salvo que tengas una pantalla vertical, gran parte quedará recortada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit d’une image portrait de %@ × %@ pixels. Sauf sur un écran portrait, une grande partie sera coupée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ × %@ पिक्सेल की पोर्ट्रेट तस्वीर है। जब तक आपके पास पोर्ट्रेट डिस्प्ले न हो, इसका बड़ा हिस्सा कट जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un’immagine verticale di %@ × %@ pixel. Senza un monitor verticale, gran parte verrà tagliata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは %@ × %@ ピクセルの縦長の画像です。縦置きディスプレイでない限り、大部分が切り取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ × %@ 픽셀의 세로 그림입니다. 세로 디스플레이가 아니면 상당 부분이 잘립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To obraz pionowy o wymiarach %@ × %@ pikseli. Bez pionowego monitora duża część zostanie przycięta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é uma imagem retrato de %@ × %@ pixels. A menos que você tenha um monitor retrato, boa parte dela será cortada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это вертикальное изображение %@ × %@ пикселей. Без вертикального монитора большая его часть будет обрезана."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu %@ × %@ piksellik dikey bir resim. Dikey bir ekranınız yoksa büyük kısmı kesilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це вертикальне зображення %@ × %@ пікселів. Без вертикального монітора більшу його частину буде обрізано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一张 %@ × %@ 像素的竖向图片。除非你有竖屏显示器，否则大部分会被裁掉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是一張 %@ × %@ 像素的直向圖片。除非你有直向螢幕，否則大部分會被裁掉。"
          }
        }
      }
    },
