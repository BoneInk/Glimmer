    "Letters, digits and _ only, not starting with a digit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحرف وأرقام و_ فقط، ولا يبدأ برقم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Buchstaben, Ziffern und _, nicht mit einer Ziffer beginnend."
          }
