    "Neither this wallpaper nor Wallpaper Engine’s assets have a 3D model (.mdl)." : {
      "comment" : "Wallpaper Editor: the model picker when there is no model to add",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتوي خلفية الشاشة هذه ولا أصول Wallpaper Engine على نموذج ثلاثي الأبعاد (.mdl)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
