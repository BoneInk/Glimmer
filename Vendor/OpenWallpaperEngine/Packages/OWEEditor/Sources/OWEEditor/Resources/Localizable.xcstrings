        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia zasobów Wallpaper Engine nie zawiera ustawień wstępnych. Zainstaluj zasoby ponownie, aby je dodać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia dos recursos do Wallpaper Engine não tem predefinições. Instale os recursos novamente para adicioná-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой копии ресурсов Wallpaper Engine нет пресетов. Установите ресурсы заново, чтобы добавить их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
