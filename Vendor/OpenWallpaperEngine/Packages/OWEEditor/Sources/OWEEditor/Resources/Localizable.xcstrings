    "Empty the console when a script is applied or the preview runs" : {
      "comment" : "Wallpaper Editor, script console: help for Clear Log on Run",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إفراغ وحدة التحكم عند تطبيق برنامج نصي أو تشغيل المعاينة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsole leeren, wenn ein Skript angewendet oder die Vorschau ausgeführt wird"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaciar la consola al aplicar un script o al ejecutar la vista previa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vider la console quand un script est appliqué ou l’aperçu exécuté"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रिप्ट लागू होने या प्रीव्यू चलने पर कंसोल खाली करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svuota la console quando si applica uno script o si esegue l’anteprima"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトを適用したとき、またはプレビューを実行したときにコンソールを空にします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트를 적용하거나 미리보기를 실행하면 콘솔을 비웁니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opróżniaj konsolę po zastosowaniu skryptu lub uruchomieniu podglądu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esvaziar o console ao aplicar um script ou executar a pré-visualização"
