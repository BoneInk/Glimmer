          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG, JPEG, GIF (su primer fotograma) o cualquier imagen que lea macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG, JPEG, GIF (sa première image) ou toute image que macOS sait lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG, JPEG, GIF (उसका पहला फ़्रेम) या कोई भी तस्वीर जो macOS पढ़ सके।"
          }
        },
        "it" : {
