    "PNG, JPEG, GIF (its first frame) or any picture macOS reads." : {
      "comment" : "New Wallpaper: the picture formats it takes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG أو JPEG أو GIF (إطاره الأول) أو أي صورة يقرأها macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
