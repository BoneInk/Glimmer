    "The files will be moved to the Trash and can be put back from there if necessary." : {
      "comment" : "Wallpaper Editor: Clean Project's note under the list",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل الملفات إلى سلة المهملات ويمكن إعادتها منها عند الحاجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien werden in den Papierkorb gelegt und können bei Bedarf von dort zurückgelegt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos se trasladarán a la papelera y podrán recuperarse desde ahí si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers seront placés dans la corbeille et pourront en être remis si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें ट्रैश में ले जाई जाएँगी और ज़रूरत हो तो वहाँ से वापस रखी जा सकती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file verranno spostati nel Cestino e, se necessario, potranno essere ripristinati da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはゴミ箱に入れられ、必要に応じてそこから戻せます。"
