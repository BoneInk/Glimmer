    "Copy the selected effect into a new effect whose shaders you can edit." : {
      "comment" : "Wallpaper Editor › Add Effect › Duplicate: help tag",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ التأثير المحدد إلى تأثير جديد يمكنك تعديل مظللاته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ausgewählten Effekt in einen neuen Effekt kopieren, dessen Shader du bearbeiten kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el efecto seleccionado en un efecto nuevo cuyos sombreadores puedes editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier l’effet sélectionné dans un nouvel effet dont vous pouvez modifier les nuanceurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने गए इफ़ेक्ट को एक नए इफ़ेक्ट में कॉपी करें जिसके शेडर आप संपादित कर सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia l’effetto selezionato in un nuovo effetto di cui puoi modificare gli shader."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したエフェクトを、シェーダーを編集できる新しいエフェクトにコピーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 효과를 셰이더를 편집할 수 있는 새 효과로 복사합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj wybrany efekt do nowego efektu, którego shadery możesz edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o efeito selecionado para um novo efeito cujos shaders você pode editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопировать выбранный эффект в новый эффект, шейдеры которого можно редактировать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili efekti, gölgelendiricilerini düzenleyebileceğiniz yeni bir efekte kopyalayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіювати вибраний ефект у новий ефект, шейдери якого можна редагувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所选效果复制为一个可以编辑其着色器的新效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所選效果複製為一個可以編輯其著色器的新效果。"
          }
        }
      }
    },
