          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettres, chiffres et _ uniquement, sans commencer par un chiffre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
