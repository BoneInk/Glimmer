    "Very high performance cost, only use this option for layers with frequently changing content, like clocks." : {
      "comment" : "Particle editor: WE's own wording from its particle editor schema",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكلفة أداء عالية جدًا؛ استخدم هذا الخيار فقط للطبقات التي يتغير محتواها كثيرًا، مثل الساعات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr hoher Leistungsbedarf. Nur für Ebenen verwenden, deren Inhalt sich oft ändert, etwa Uhren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy costoso en rendimiento: usa esta opción solo en capas cuyo contenido cambia a menudo, como relojes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très coûteux en performances : n’utilisez cette option que pour les calques dont le contenu change souvent, comme les horloges."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदर्शन पर बहुत भारी; यह विकल्प केवल घड़ी जैसी बार-बार बदलने वाली सामग्री वाली लेयर के लिए चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costo di prestazioni molto alto: usa questa opzione solo per livelli il cui contenuto cambia spesso, come gli orologi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理負荷が非常に高いため、時計など内容が頻繁に変わるレイヤーにのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성능 부담이 매우 큽니다. 시계처럼 내용이 자주 바뀌는 레이어에만 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo duży koszt wydajności: używaj tylko dla warstw o często zmieniającej się treści, np. zegarów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custo de desempenho muito alto: use esta opção só em camadas cujo conteúdo muda com frequência, como relógios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очень высокая нагрузка: используйте только для слоёв с часто меняющимся содержимым, например часов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok yüksek performans maliyeti; yalnızca saat gibi içeriği sık değişen katmanlarda kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дуже високе навантаження: використовуйте лише для шарів із вмістом, що часто змінюється, як-от годинники."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性能开销非常大，仅用于内容经常变化的图层，例如时钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效能負擔非常大，僅用於內容經常變化的圖層，例如時鐘。"
          }
        }
      }
    },
