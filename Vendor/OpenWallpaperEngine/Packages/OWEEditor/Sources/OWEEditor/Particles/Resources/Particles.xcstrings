          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine की कण प्रणालियाँ और प्रीसेट उसके ऐसेट के साथ आते हैं, जो इंस्टॉल नहीं हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sistemi di particelle e i preset di Wallpaper Engine fanno parte delle sue risorse, che non sono installate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine のパーティクルシステムとプリセットはアセットに含まれていますが、アセットがインストールされていません。"
