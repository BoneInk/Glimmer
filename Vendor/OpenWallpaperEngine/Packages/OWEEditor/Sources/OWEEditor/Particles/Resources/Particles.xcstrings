    "Wallpaper Engine’s particle systems and presets come with its assets, which aren’t installed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي أنظمة الجسيمات والإعدادات المسبقة في Wallpaper Engine مع موارده، وهي غير مثبتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Partikelsysteme und Vorlagen von Wallpaper Engine gehören zu seinen Assets, die nicht installiert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sistemas de partículas y preajustes de Wallpaper Engine vienen con sus recursos, que no están instalados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
