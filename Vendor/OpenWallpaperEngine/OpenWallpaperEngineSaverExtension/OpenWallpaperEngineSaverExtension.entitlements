<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)app.openwallpaperengine</string>
	</array>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>C33D7BSFGS.app.openwallpaperengine.saver-broker</string>
		<string>com.apple.CARenderServer</string>
		<string>com.apple.CoreDisplay.master</string>
		<string>com.apple.ViewBridgeAuxiliary</string>
	</array>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/Open Wallpaper Engine/ScreenSaver/</string>
	</array>
</dict>
</plist>
