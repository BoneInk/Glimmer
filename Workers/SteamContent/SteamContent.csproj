<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><AssemblyName>GlimmerSteamContent</AssemblyName>
  </PropertyGroup>
  <ItemGroup><None Update="SteamKit2-*.txt;Notices/**/*;README.md;sdk-pin.json;packages.lock.json" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><PackageReference Include="SteamKit2" Version="[3.4.0]" /></ItemGroup>
</Project>
